<odoo>

    <record id="view_blanket_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.blanket.order.form.inherit</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_state_id" optional="show" />
            </xpath>
            <!-- Filter out company dependent products in the product_id field -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), '|', ('company_ids_display', '=', False), ('company_ids_display', 'in', company_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="customer_lead" optional="show" />
                <field name="purchase_price" optional="show" />
                <field name="margin" optional="show" />
                <field name="margin_percent" widget="percentage" optional="show" />
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="discount" optional="show" />
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="auto_release" />
            </xpath>
            <field name="taxes_id" position="attributes">
                <attribute name="required"></attribute>
            </field>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_invoice_id" groups="account.group_delivery_invoice_address" context="{'default_type':'invoice', 'show_address': False, 'show_vat': False}" readonly="state == 'expired'"/>
                <field name="partner_shipping_id" groups="account.group_delivery_invoice_address" context="{'default_type':'delivery', 'show_address': False, 'show_vat': False}" readonly="state == 'expired'"/>
                <field name="contact_ids" domain="[('parent_id','=',partner_id)]" widget="many2many_tags" required="1"/>
                <field name="account_manager_id" readonly="state == 'expired'"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="sale_payment_method_id" required="1"/>
                <field name="carrier_id" />
            </xpath>
            
            <xpath expr="//field[@name='pricelist_id']" position="replace"/>
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="show_update_pricelist" invisible="1"/>
                <field name="has_active_pricelist" invisible="1"/>
                <label for="pricelist_id" groups="product.group_product_pricelist" invisible="not has_active_pricelist" />
                <div groups="product.group_product_pricelist" class="o_row" invisible="not has_active_pricelist" >
                    <field name="pricelist_id" options="{'no_open': True, 'no_create': True}" readonly="state in ['expired']"/>
                    <button name="action_update_prices" type="object" string=" Update Prices" help="Recompute all prices based on this pricelist" class="btn-link mb-1 px-0" icon="fa-refresh" confirm="This will update the unit price of all products based on the new pricelist." invisible="not show_update_pricelist or state in ['done', 'expired']"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='company_id']" position="after">
                <button
                    name="action_duplicate_line"
                    type="object"
                    class="oe_link"
                    icon="fa-copy"
                    title="Copy"
                    invisible="not product_id or state in ('done', 'expired')"
                />
            </xpath>
        </field>
    </record>

</odoo>
