<odoo>

    <record id="ol_sale_blanket_order_lead_time_view_order_form" model="ir.ui.view">
        <field name="name">lead.time.sale.blanket.order.form</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button
                    name="action_compute_esd"
                    type="object"
                    string="Calculate ESD"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>

    <record id="ol_sale_blanket_order_lead_time_view_blanket_order_form_configurator_mrp_inherit" model="ir.ui.view">
        <field name="name">sale.blanket.order.form.configurator.mrp.inherit</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="product_configurator_sale_blanket_order_mrp.view_blanket_order_form_configurator_mrp_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree//field[@name='product_id']" position="after" >
                <button
                    name="action_open_bom_overview"
                    title="BoM Overview: Shows the bom, part availability at this time with expected dates/lead times."
                    type="object"
                    icon="fa-list"
                    invisible="not bom_id"
                />
            </xpath>
        </field>
    </record>

</odoo>
