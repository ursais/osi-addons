<odoo>

    <!-- ECO Type Form View -->
    <record id="mrp_eco_type_view_form_inherit_ol_mrp_plm_component_replace" model="ir.ui.view">
        <field name="name">mrp.eco.type.view.form</field>
        <field name="model">mrp.eco.type</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_alias']" position="after">
                <group name="component">
                    <field name="component_replacement" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- ECO Type Tree View -->
    <record id="mrp_eco_type_view_tree_inherit_ol_mrp_plm_component_replace" model="ir.ui.view">
        <field name="name">mrp.eco.type.view.tree</field>
        <field name="model">mrp.eco.type</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_type_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="component_replacement" />
            </xpath>
        </field>
    </record>

</odoo>
