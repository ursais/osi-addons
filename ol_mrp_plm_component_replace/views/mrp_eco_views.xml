<odoo>

    <!-- ECO Form View -->
    <record id="view_mrp_eco_form_inherit_component_replace" model="ir.ui.view">
        <field name="name">mrp.eco.form.component.replace</field>
        <field name="model">mrp.eco</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']" position="attributes">
                <attribute name="invisible">type == 'routing' or type_id.component_replacement</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="before">
                <field name="product_tmpl_id" string="Component to be Replaced" domain="[('type', 'in', ['consu', 'product'])]" readonly="state != 'confirmed'" invisible="type == 'routing' or not type_id.component_replacement" />
                <field name="product_to_add_id" required="not type == 'product' or not type_id.component_replacement" invisible="not type == 'product' or not type_id.component_replacement" />
            </xpath>
            <xpath expr="//page[@name='note']" position="before">
                <page string="BoM's to Update" >
                    <field name="bom_ids" widget="many2many_tree" options="{'no_create': True}" context={'active_test':False}>
                        <tree editable="bottom">
                            <field name="active" readonly="1" optional="show" />
                            <field name="company_id" optional="hide" />
                            <field name="product_tmpl_id" optional="show" />
                            <field name="code" optional="show" />
                            <field name="scaffolding_bom" optional="show" />
                            <field name="type" optional="show" />
                            <field name="version" optional="show" />
                            <field name="product_id" optional="hide" />
                            <field name="company_id" optional="hide" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
