<odoo>
  <!-- Report Action -->
  <record id="action_report_mo_bin_label" model="ir.actions.report">
    <field name="name">MO Bin Label</field>
    <field name="model">mrp.production</field>
    <field name="report_type">qweb-pdf</field>
    <field name="print_report_name">'%s Bin Label' % (object.name or 'MO')</field>
    <field name="report_name">ol_pdf_reports.report_mo_bin_label</field>
    <field name="report_file">ol_pdf_reports.report_mo_bin_label</field>
    <field name="binding_model_id" ref="mrp.model_mrp_production"/>
    <field name="paperformat_id" ref="ol_pdf_reports.bin_label_paperformat"/>
  </record>

  <!-- Template -->
  <template id="report_mo_bin_label">
    <t t-foreach="docs" t-as="mo_record">
      <t t-set="mo_data" t-value="mo_record.get_bin_label_data()" />

      <t t-call="web.html_container">
        <t t-call="web.internal_layout">
          <div class="page">
            <div class="content bin_label" >
              <div class="address">
                <div class="main-info">
                  <div class="flag">
                    <t t-if="mo_data['rush_order']">
                      RUSH
                    </t>
                  </div>
                  <t t-esc="mo_data['customer']" />
                  <br />
                  <span class="sale-info">
                    <t t-esc="mo_data['sale_order']" />
                  </span>
                  <br/>
                  <t t-esc="mo_data['carrier']" />
                </div>
              </div>

              <h1 class="name">
                <t t-esc="mo_data['name']"/>
              </h1>
              <div class="product">
                <t t-esc="mo_data['product']"/>
              </div>

              <div class="footer-left bold">Salesperson:</div>

              <div class="footer-right bold">Ship By:</div>

              <div class="footer-left">
                <t t-esc="mo_data['salesperson']" />
              </div>
              <div class="footer-right">
                <t t-esc="mo_data['ship_by']" />
              </div>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
