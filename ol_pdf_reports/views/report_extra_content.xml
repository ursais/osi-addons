<odoo>

    <!-- Tree View -->
    <record id="view_report_extra_content_tree" model="ir.ui.view">
        <field name="name">report.extra.content.view.tree</field>
        <field name="model">report.extra.content</field>
        <field name="arch" type="xml">
            <tree string="Report Extra Content">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="pdf_filename"/>
                <field name="report_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_report_extra_content_form" model="ir.ui.view">
        <field name="name">report.extra.content.view.form</field>
        <field name="model">report.extra.content</field>
        <field name="arch" type="xml">
            <form string="Report Extra Content" class="o_sale_order">
                <sheet>

                    <div class="oe_button_box" name="button_box"></div>

                    <div class="ol-information-block-cont"/>
                    <group name="main_grp" colspan="4" col="3">
                        <field name="name"/>
                        <field name="pdf" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="priority" readonly="1"/>
                        <field name="company_id"/>
                        <field name="report_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu action -->
    <record id="action_view_report_extra_content_tree" model="ir.actions.act_window">
        <field name="name">Report Extra Content</field>
        <field name="res_model">report.extra.content</field>
        <field name="view_id" ref="view_report_extra_content_tree"/>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Report Extra Content" action="action_view_report_extra_content_tree" id="menu_report_extra_content" sequence="999" parent="sale.menu_sale_report" groups="ol_pdf_reports.report_extra_content"/>

</odoo>
