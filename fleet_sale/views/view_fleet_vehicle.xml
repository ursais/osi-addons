    This view extends the fleet vehicle form to add a button that shows
    the count of sale orders associated with the vehicle and allows
    users to quickly access those sale orders.
-->
<odoo>
    <record id="view_fleet_vehicle_inherit_form_so" model="ir.ui.view">
        <field name="name">fleet.vehicle.inherit.form.sale.orders</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <!-- Add sale orders button to the button box -->
            <div name="button_box" position="inside">
                <button
                    name="open_fleet_so"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    string="Sale Orders"
                    help="View sale orders associated with this vehicle"
                    groups="sales_team.group_sale_salesman">
                    <field
                        name="vehicle_sale_count"
                        widget="statinfo"
                        string="Sale Orders"
                        groups="sales_team.group_sale_salesman"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
