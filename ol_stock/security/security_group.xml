<odoo>
    <record id="group_allow_incoming_move_addition" model="res.groups">
        <field name="name">Receipts: Allow Adding Lines to Incoming Transfers</field>
        <field name="category_id" ref="ol_base.onlogic_groups"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
