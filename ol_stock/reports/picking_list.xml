<odoo>

    <!-- Report Action -->
    <record id="action_picking_list_report" model="ir.actions.report">
        <field name="name">Picking List</field>
        <field name="print_report_name">'%s Picking List' % (object.name or '')</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ol_stock.report_picking_list</field>
        <field name="report_file">ol_stock.report_picking_list</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="paperformat_xmlid_base">ol_templates.ol_report_picking_list_paper_format</field>
    </record>

    <!-- Main template -->
    <template id="report_picking_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Set some useful variables -->
                <t t-set="sale_order" t-value="doc.sale_id" />
                <!-- Find the correct language-->
                <t t-set="language" t-value="sale_order.partner_id.lang or doc.create_uid.lang" />
                <!-- Re-browse of the record with the correct language -->
                <t t-set="picking" t-value="doc.with_context(lang=language)" />
                <!-- Call the template document with the language set -->
                <t t-call="ol_stock.report_picking_list_document" t-lang="language" />
            </t>
        </t>
    </template>

    <template id="report_picking_list_document">
        <t t-call="ol_templates.external_layout">
            <!-- Set the name and title of the Report -->
            <t t-set="report_title">Picking List</t>
            <!--Set template variables-->
            <t t-set="title" t-value="report_title" />
            <t t-set="custom_footer" t-value="True" />
            <t t-set="picking_product_lines" t-value="picking.get_picking_product_lines()" />
            <t t-set="picking_move_lines" t-value="picking.get_picking_move_lines()" />
            <t t-if="picking.blind_drop_ship or picking.blind_ship_from">
                <t t-set="blind_drop_ship" t-value="True" />
            </t>
            <t t-if="picking.rush_order">
                <t t-set="rush_order" t-value="True" />
            </t>
            <t t-set="hide_header_company" t-value="True" />
        <t t-set="customer_company_name" t-value="sale_order.partner_id.company_name or picking.partner_id.company_name or picking.partner_id.commercial_company_name" />
            <t t-set="currency" t-value="sale_order.currency_id" />
            <t t-set="company" t-value="sale_order.company_id or picking.company_id" />
            <!-- Report specific styling -->
            <t t-set="report_custom_page_style">
              .ol-sale-line{
              margin-bottom: 30px;
              }
              .subtotal-text.taxes{
              text-align: right;
              font-size: 10px;
              }
              .ol-spacer {
              width: 50%;
              height: 100px;
              display: inline-block;
              }
              .ol-spacer-half {
              width: 50%;
              height: 50px;
              display: inline-block;
              }
              .ol-address {
              width: 30%;
              float: left;
              }
              .ol-sale-line-name {
              font-size: 18px;
              }
              .picking_barcode {
              padding-top: 15px !important;
              }
              .picking_barcode_image {
              width:300px !important;
              height:50px !important;
              }
            </t>
            <!--The first main information block-->
            <div class="ol_report_info_row ol_flex">
                <!--Basic Invoice information-->
                <div class="ol_report_info_row_col info picking">
                    <div class="ol_report_info_row_col_title picking ol_flex">
                        <div class="key">
                            <tag>Order</tag>
                        </div>
                        <div class="value">
                            <t t-esc="picking.origin" />
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line picking ol_flex">
                        <div class="key">
                            <tag>Internal Reference</tag>
                        </div>
                        <div class="value">
                            <t t-esc="picking.name" />
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line picking ol_flex">
                        <div class="key">
                            <tag>Company</tag>
                        </div>
                        <div class="value">
                            <t t-esc="customer_company_name" />
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line picking ol_flex">
                        <div class="key">
                            <tag>Customer Name</tag>
                        </div>
                        <div class="value">
                            <t t-esc="sale_order.partner_id.name or picking.partner_id.name" />
                        </div>
                    </div>
                </div>
                <!--Billing related information-->
                <div class="ol_report_info_row_col picking_extra">
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Method/Carrier</tag>
                        </div>
                        <div class="value">
                            <t t-esc="picking.carrier_id.name" />
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Order value</tag>
                        </div>
                        <div class="value">
                            <t t-esc="sale_order.amount_total" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id or sale_order.env.company.currency_id}'/>
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Shipping Value</tag>
                        </div>
                        <div class="value">
                            <t t-esc="picking.get_shipping_value()" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id or sale_order.env.company.currency_id}'/>
                        </div>
                    </div>
                </div>
            </div>
            <!--Barcode image-->
             <div class="picking_barcode" style="padding-top: 15px !important;" >
                <img class="picking_barcode_image" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', picking.name, 600, 100)" alt="Barcode" style="width: 300px !important; height:50px !important;" />
            </div>
            <!--Product list-->
            <t t-call="ol_stock.picking_products">
                <t t-set="products_title">
                    Products
                </t>
            </t>
            <t t-call="ol_stock.picking_comments" />
        </t>
        <!--Replace the normal footer-->
        <div class="footer">
            <!-- This gets stripped out and reformatted by Odoo in `report/models/report.py get_pdf()`-->
            <t t-call="ol_templates.report_footer_style" />
            <t t-call="ol_stock.picking_footer" />
        </div>
    </template>

    <!--The main products section in the report-->
    <template id="picking_products">
        <div class="ol_report_products_row ol_picking">
            <div class="ol_products_header ol_flex ol_flex_just_cont_space_between">
                <div class="ol_products_list_header ol_picking ol_flex">
                    <!--The info table header-->
                    <div class="ol_products_list_header_item location1">
                        <tag>Location</tag>
                    </div>
                    <div class="ol_products_list_header_item model1">
                        <tag>Model</tag>
                    </div>
                    <div class="ol_products_list_header_item qty1">
                        <tag>QTY</tag>
                    </div>
                    <div class="ol_products_list_header_item products1">
                        <tag>Products</tag>
                    </div>
                    <div class="ol_products_list_header_item serials1">
                        <tag>Serials</tag>
                    </div>
                    <div class="ol_products_list_header_item destination1">
                        <tag>Destination</tag>
                    </div>
                </div>
            </div>
            <!--The list of products-->
            <t t-call="ol_stock.picking_move_lines" />
        </div>
    </template>

    <!--move lines-->
    <template id="picking_move_lines">
        <div class="ol_picking">
            <t t-foreach="picking_move_lines" t-as="product_line">
                <div class="ol_products_line">
                    <!--Product: image, name, sku, data-->
                    <div class="ol_products_info_cont ol_flex ol_picking">
                        <div class="ol_product_location packing location1">
                            <p t-esc="product_line['location_id']"/>
                        </div>
                        <div class="ol_product_default_code ol_picking packing model1">
                            <p t-esc="product_line['product_default_code']" />
                        </div>
                        <div class="ol_picking product_qty qty1">
                            <p t-esc="product_line['qty']" t-options="{'widget': 'integer'}" />
                        </div>
                        <div class="ol_product_name ol_picking products1">
                            <p t-esc="product_line['product_name']" />
                        </div>
                        <div class="ol_picking system_serial_numbers serials1">
                            <p t-esc="product_line['system_serial_numbers']" />
                        </div>
                        <div class="ol_picking location_destination destination1">
                            <p t-esc="product_line['location_dest_id']" />
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <!--Products list template-->
    <template id="picking_product_lines">
        <div class="ol_product_lines ol_picking">
            <t t-foreach="picking_product_lines" t-as="product_line">
                <t t-set="sale_line" t-value="product_line['sale_line']" />
                <div class="ol_products_line">
                    <!--Product: image, name, sku, data-->
                    <div class="ol_products_info_cont ol_flex ol_picking">
                        <div class="ol_product_location packing">
                            <div t-esc="product_line['stock_move'].location_id.name"/>
                        </div>
                        <div class="ol_product_default_code ol_picking packing">
                            <div t-esc="product_line['product_default_code']" />
                        </div>
                        <div class="ol_products_line_data_item product_qty packing">
                            <t t-if="sale_line">
                                <t t-if="sale_line['product_qty'] &lt; product_line['qty']">
                                    <span style="border:2px solid;padding-left:2px; padding-right:2px;">
                                        <t t-esc="product_line['qty']" t-options="{'widget': 'integer'}" />
                                    </span>
                                </t>
                                <t t-else="">
                                    <t t-esc="product_line['qty']" t-options="{'widget': 'integer'}" />
                                </t>
                            </t>
                            <t t-else="">
                                <t t-esc="product_line['qty']" t-options="{'widget': 'integer'}" />
                            </t>
                        </div>
                        <div class="ol_product_name ol_picking">
                            <t t-esc="product_line['product_name']" />
                        </div>
                        <div class="product-notes">
                            <div t-esc="product_line['system_serial_numbers']" />
                        </div>
                        <div class="ol_product_destination">
                            <div t-esc="product_line['stock_move'].location_dest_id.name" />
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <!--Comment Sections-->
    <template id="picking_comments">
        <div class="ol_picking_comments_cont">
            <div class="ol_picking_comments_header">Comments</div>
            <div class="ol_picking_comments_content">
                <t t-if="picking.picking_type_code == 'outgoing'">
                    <div t-esc="sale_order.delivery_note" />
                    <div t-esc="picking.note" />
                </t>
                <t t-if="picking.picking_type_code == 'internal'">
                    <div t-esc="sale_order.mrp_note" />
                    <div t-esc="picking.note" />
                </t>
            </div>
        </div>
    </template>

    <!--Footer-->
    <template id="picking_footer">
        <div class="ol_report_footer last-page">
            <div class="ol_report_footer_page ol_flex ol_flex_just_cont_space_between">
                <div class="ol_report_footer_title">
                    <strong>Internal Reference</strong>
                </div>
            </div>
            <div class="ol_report_footer_company_row ol_flex ol_flex_just_cont_space_between">
                <div class="ol_picking_footer_block_cont">
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>CC Charged</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Box Weight</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                </div>
                <div class="ol_picking_footer_block_cont">
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Picked By</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Box Size</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                </div>
                <div class="ol_picking_footer_block_cont">
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Packed By</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Shipped</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                </div>
                <div class="ol_picking_footer_block_cont">
                    <div class="ol_picking_footer_block ol_flex ol_flex_just_cont_space_between">
                        <div class="footer_block_title">
                            <tag>Box Count</tag>
                        </div>
                        <div class="footer_block_line" />
                    </div>
                </div>
            </div>
        </div>
    </template>

</odoo>
