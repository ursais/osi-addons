<odoo>

  <!-- ========================= -->
  <!-- Custom label paper format -->
  <!-- ========================= -->
  <record id="product_inventory_paperformat" model="report.paperformat">
    <field name="format">custom</field>
    <field name="margin_top" eval="0"/>
    <field name="margin_bottom" eval="0"/>
    <field name="name">Product Inventory Label Paperformat</field>
    <field name="orientation">Portrait</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="False" />
    <field name="header_spacing">10</field>
    <field name="dpi">90</field>
    <field name="page_height">110</field>
    <field name="page_width">100</field>
  </record>

  <!-- ============= -->
  <!-- Report action -->
  <!-- ============= -->

  <record id="action_report_stock_inventory_label" model="ir.actions.report">
    <field name="name">Product Inventory Label</field>
    <field name="model">product.product</field>
    <field name="report_type">qweb-pdf</field>
    <field name="print_report_name">'%s Inventory Label' % (object.name or '')</field>
    <field name="report_name">ol_stock.report_stock_inventory_label</field>
    <field name="report_file">ol_stock.report_stock_inventory_label</field>
    <field name="binding_model_id" ref="product.model_product_product"/>
    <field name="paperformat_id" ref="product_inventory_paperformat" />
  </record>

  <!-- ========= -->
  <!-- Templates -->
  <!-- ========= -->
  <template id="report_stock_inventory_label">
    <t t-foreach="docs" t-as="product_id">
      <t t-call="web.html_container">
        <div class="article">
          <div class="page">
            <div class="content stock-inventory-label">
              <div class="label-header">
                <t t-esc="product_id.default_code"/>
                <div class="location">
                  <t t-esc="product_id.loc_row or '_'"/>
                  <t t-esc="product_id.loc_rack or '_'"/>
                  <t t-esc="product_id.loc_case or '_'"/>
                </div>
              </div>
              <table class="inventory-count">
                <tr>
                  <td>
                    <div class="row-label">Overstock:</div>
                  </td>
                  <td>
                    <div class="input_line"></div>
                  </td>
                  <td>
                    <div class="counted-label">COUNTED BY:</div>
                    <div class="input-line"></div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="row-label">Physical Count:</div>
                  </td>
                  <td>
                    <div class="input-line"></div>
                  </td>
                  <td>
                    <div class="counted-label">COUNTED BY:</div>
                    <div class="input-line"></div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="row-label">Total:</div>
                  </td>
                  <td>
                    <div class="input-line"></div>
                  </td>
                  <td>
                    <div class="counted-label">COUNTED BY:</div>
                    <div class="input-line"></div>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </t>
    </t>
  </template>

</odoo>
