<odoo noupdate="1">

    <record id="ir_sequence_us_warehouse" model="ir.sequence">
        <field name="name">OnLogic US Warehouse Sequence IN-P</field>
        <field name="code"></field>
        <field name="prefix">IN-P</field>
        <field name="padding">5</field>
        <field name="company_id" ref="base.main_company" />
    </record>

    <!-- Prototype Location -->
    <record id="stock_location_prototype" model="stock.location">
        <field name="name">Prototype</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company" />
        <field name="active" eval="True"/>
    </record>

    <!-- Prototype Operation -->
    <record id="picking_type_prototype_receipts" model="stock.picking.type" >
        <field name="name">Prototype Receipts</field>
        <field name="code">incoming</field>
        <field name="company_id" ref="base.main_company" />
         <field name="sequence_id" ref="ol_stock.ir_sequence_us_warehouse"/>
        <field name="sequence_code">IN-P</field>
        <field name="create_backorder">ask</field>
        <field name="return_picking_type_id" model="stock.picking.type" search="[('code', '=', 'outgoing'), ('company_id', '=', obj().env.ref('base.main_company').id)]"/>
        <field name="default_location_dest_id" ref="ol_stock.stock_location_prototype"/>
    </record>

    <!-- Prototype Route -->
    <record id="route_prototype_buy" model='stock.route'>
        <field name="name">Prototype Buy</field>
        <field name="sequence">20</field>
        <field name="company_id" ref="base.main_company" />
        <field name="product_selectable" eval="True"/>
    </record>

    <!-- Prototype Rule -->
    <record id="rule_prototype_buy" model='stock.rule'>
        <field name="name">Prototype Buy</field>
        <field name="action">buy</field>
        <field name="company_id" ref="base.main_company" />
        <field name="picking_type_id" ref="ol_stock.picking_type_prototype_receipts"/>
        <field name="location_dest_id" ref="ol_stock.stock_location_prototype"/>
        <field name="sequence">20</field>
        <field name="group_propagation_option">propagate</field>
        <field name="route_id" ref="ol_stock.route_prototype_buy" />
    </record>

</odoo>
