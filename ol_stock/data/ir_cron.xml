<odoo>

	<record id="ir_cron_overflow_replenishment_us_1" model="ir.cron">
		<field name="name">Overflow Replenishment (US)</field>
		<field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
		<field name="state">code</field>
		<field name="code">model._cron_run_overflow_replenishments(company_id=1)</field>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="nextcall" eval="(DateTime.now() + relativedelta(hour=14, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
		<field name="active">True</field>
	</record>

