<odoo noupdate="1">
	
	<record id="ir_cron_overflow_replenishment" model="ir.cron">
		<field name="name">Overflow Replenishment Scheduler</field>
		<field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
		<field name="state">code</field>
		<field name="code">model._cron_run_overflow_replenishments()</field>
		<field name="interval_number">1</field>
        <field name="interval_type">days</field>
		<field name="active">True</field>
		<field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
	</record>

</odoo>
