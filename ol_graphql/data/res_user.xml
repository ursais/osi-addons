<odoo>
    <data noupdate="1">
        <!-- Graphql System User -->
        <record id="graphql_user" model="res.users">
            <field name="name">GraphQL</field>
            <field name="login">graphql_user</field>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(6, 0, [ref('base.main_company'), ref('ol_base.onlogic_eu')])]"/>
        </record>
    </data>
</odoo>