<odoo>

    <record id="ol_purchase_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.inherited</field>
        <field name="model">purchase.order</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Add alert message if the vendor has not been approved. -->
            <field name="partner_id" position="attributes">
                <attribute name="domain">[("approved_vendor", "=", True)]</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="approved_vendor" invisible="1" />
            </field>
            <xpath expr="//header" position="after">
                <div class="alert alert-danger" role="alert" style="text-align: center" invisible="not partner_id or approved_vendor">
                    The vendor on this purchase order has not been approved!
                </div>
            </xpath>

            <!-- Show Order Deadline but renamed after confirmed.-->
            <field name="date_order" position="after">
                <field name="date_order" string="Original Order Date" invisible="state not in ('purchase', 'done')" readonly="1" />
            </field>

            <!-- Add partner shipping preference fields to PO, move incoterm from page-->
            <field name="incoterm_id" position="replace" />
            <field name="partner_id" position="after">
                <field name="contact_ids" domain="[('parent_id','=',partner_id)]" widget="many2many_tags" />
                <field name="delivery_method_id" />
                <field name="shipping_notes" />
                <field name="incoterm_id" />
            </field>

            <!-- Add order line note field -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="note" optional="show" />
            </xpath>

            <!-- Unhide Expected Arrival -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='date_planned']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

</odoo>
