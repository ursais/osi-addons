<odoo>

    <record id="ol_purchase_product_supplierinfo_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.template.product.tree.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[("approved_vendor", "=", True)]</attribute>
            </field>
        </field>
    </record>

    <record id="ol_purchase_product_supplierinfo_form_view_inherit" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[("approved_vendor", "=", True)]</attribute>
            </field>
        </field>
    </record>

</odoo>
