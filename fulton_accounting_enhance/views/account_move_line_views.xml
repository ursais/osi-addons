<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_account_move_line_search_view_inherit" model="ir.ui.view">
            <field name="name">view.account.move.line.search.view.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_payment_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='journal']" position="after">
                    <filter name="preferred_payment_method" context="{'group_by': 'preferred_payment_method_id'}" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
