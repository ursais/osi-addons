<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_payment_document" inherit_id="account.report_payment_receipt_document">
        <!-- Remove Invoice Number Row -->
        <xpath expr="//div[hasclass('page')]/div/div[5]/div[2]" position="replace"/>
        <xpath expr="//table/thead/tr/th[2]" position="replace"/>
        <xpath expr="//table/thead/tr/th[4]" position="replace">
            <th class="text-end"><span>Amount Paid</span></th>
        </xpath>
        <xpath expr="//table/thead/tr/th[3]" position="after">
            <th><span>Original</span></th>
            <th><span>Discount</span></th>
        </xpath>

        <xpath expr="//table/tbody/t/t/tr[1]/td[2]" position="replace"/>
        <xpath expr="//table/tbody/t/t/tr[1]/td[2]" position="replace">
            <td><span t-field="inv.ref"></span></td>
        </xpath>
        <xpath expr="//table/tbody/t/t/tr[1]/td[4]" position="replace"/>
        <xpath expr="//table/tbody/t/t/tr[1]/td[3]" position="after">
            <t t-set="amount_discount" t-value="0"/>
            <t t-if="inv.invoice_payment_term_id.discount_percentage">
                <t t-if="(inv.invoice_date + datetime.timedelta(days=int(inv.invoice_payment_term_id.discount_days))) &gt; o.create_date.date()">
                    <t t-set="amount_discount" t-value="inv.amount_total * (inv.invoice_payment_term_id.discount_percentage / 100)"/>
                </t>
            </t>
            <t t-set="payment_total" t-value="inv.amount_total - amount_discount"/>
            <td class="text-end"><span t-out="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
            <td class="text-end"><span t-out="amount_discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
            <td class="text-end"><span t-out="payment_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
        </xpath>
        <xpath expr="//table/tbody/t/t/tr[2]" position="replace"/>
        <xpath expr="//table/tbody/t/t/tr[2]" position="replace"/>

        <xpath expr="//table" position="after">
            <div class="text-end">Total Amount: 
                <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            </div>
        </xpath>
    </template>

</odoo>
