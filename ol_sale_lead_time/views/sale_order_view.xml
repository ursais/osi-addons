<odoo>

    <record id="ol_sale_lead_time_view_order_form" model="ir.ui.view">
        <field name="name">lead.time.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button
                    name="action_compute_esd"
                    type="object"
                    string="Calculate ESD"
                    class="btn-primary"
                />
            </xpath>
            <xpath expr="//field[@name='product_template_id']" position="before">
                <field name="bom_id" column_invisible="1" />
                <button
                    name="action_open_bom_overview"
                    title="BoM Overview: Shows the bom, part availability at this time with expected dates/lead times."
                    type="object"
                    icon="fa-list"
                    invisible="not bom_id"
                />
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="first_estimated_ship_date" readonly="1"/>
                
            </xpath>
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']//tree//field[@name='product_uom']" position="after">
                <field name="available_date"/>
            </xpath>
            <sheet position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="not esd_warning_message"
                >
                    <field name="last_esd_date" invisible="1"/>
                    <field name="esd_warning_message" readonly="1"/>
                </div>
            </sheet>
        </field>
    </record>

</odoo>
