<odoo>

	<!-- Sales Team: Engineer to Portfolio -->
     <record id="sales_team_portfolio" model="crm.team">
        <field name="name">Portfolio</field>
        <field name="use_leads">True</field>
        <field name="use_opportunities">True</field>
        <field name="active">True</field>
    </record>

    <!-- Sales Team: Customer SKU -->
    <record id="sales_team_customer_sku" model="crm.team">
        <field name="name">Customer SKU</field>
        <field name="use_leads">True</field>
        <field name="use_opportunities">True</field>
        <field name="active">True</field>
    </record>

    <!-- Sales Team: Engineer to Order -->
    <record id="sales_team_engineer_to_order" model="crm.team">
        <field name="name">Engineer to Order</field>
        <field name="use_leads">True</field>
        <field name="use_opportunities">True</field>
        <field name="active">True</field>
    </record>

    <!-- Sales Team: US -->
    <record id="sales_team_us" model="crm.team">
        <field name="name">Sales Team US</field>
        <field name="use_leads">True</field>
        <field name="use_opportunities">True</field>
        <field name="active">True</field>
        <field name="company_id" ref="base.main_company" />
    </record>

    <!-- Sales Team: EU -->
    <record id="sales_team_eu" model="crm.team">
        <field name="name">Sales Team: EU</field>
        <field name="use_leads">True</field>
        <field name="use_opportunities">True</field>
        <field name="active">True</field>
        <field name="company_id" ref="ol_base.onlogic_eu" />
    </record>

</odoo>
