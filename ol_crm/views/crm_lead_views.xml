<odoo>

    <record id="ol_crm_crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='expected_revenue']" position="after">
                <label for="quantity" class="oe_edit_only"/>
            </xpath>
            <field name="expected_revenue" position="after">
                <field name="quantity" class="o_input_13ch"/>
            </field>
        </field>
    </record>

</odoo>
