<odoo>

    <record id="ol_crm_crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <button name="action_schedule_meeting" position="after">
                <button
                    type="object"
                    name="action_view_estimate"
                    class="oe_stat_button"
                    invisible="estimate_count == 0"
                    icon="fa-list"
                >
                    <field name="estimate_count" widget="statinfo" string="Estimates" />
                </button>
            </button>
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button string="New Estimate" name="action_create_estimate" type="object" class="oe_highlight" data-hotkey="q" title="Create new quotation" invisible="type == 'lead' or not partner_id or probability == 0 and not active"/>
            </xpath>
        </field>
    </record>

</odoo>
