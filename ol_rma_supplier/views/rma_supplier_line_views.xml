<odoo>

    <record id="view_rma_supplier_line_form" model="ir.ui.view">
        <field name="name">rma.supplier.order.line.form</field>
        <field name="model">rma.supplier.order.line</field>
        <field name="arch" type="xml">
            <form string="RMA Supplier Line">
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="product_uom" />
                        <field name="qty_delivered" />
                        <field name="qty_received" />
                        <field name="rma_supplier_order_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rma_supplier_line_tree" model="ir.ui.view">
        <field name="name">rma.supplier.order.line.tree</field>
        <field name="model">rma.supplier.order.line</field>
        <field name="arch" type="xml">
            <tree string="RMA Supplier Line">
                <field name="product_id" />
                <field name="quantity" />
                <field name="product_uom" />
                <field name="qty_delivered" />
                <field name="qty_received" />
                <field name="rma_supplier_order_ids" />
            </tree>
        </field>
    </record>

</odoo>
