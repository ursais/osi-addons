<odoo>

    <record id="view_rma_supplier_tag_form" model="ir.ui.view">
        <field name="name">rma.supplier.tag.view.form</field>
        <field name="model">rma.supplier.tag</field>
        <field name="arch" type="xml">
            <form string="Tags">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Services"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" required="True" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rma_supplier_tag_tree" model="ir.ui.view">
        <field name="name">rma.supplier.tag.view.tree</field>
        <field name="model">rma.supplier.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom" sample="1">
                <field name="name"/>
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <record id="rma_supplier_tag_action" model="ir.actions.act_window">
        <field name="name">RMA Tags</field>
        <field name="res_model">rma.supplier.tag</field>
        <field name="view_id" ref="view_rma_supplier_tag_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create RMA Tags
            </p><p>
            Use Tags to manage and track your RMA's (product type, RMA type, ...)
            </p>
        </field>
    </record>

</odoo>
