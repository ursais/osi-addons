<odoo>

    <record id="view_rma_supplier_picking_form" model="ir.ui.view">
        <field name="name">view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="rma_out_id" invisible="1" />
                <field name="rma_in_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='lot_ids']" position="before">
                <field name="rma_supplier_line_id" optional="hide" />
                <field name="rma_note" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
