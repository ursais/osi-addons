<odoo>

    <record id="rma_supplier_order_res_partner_view_buttons" model="ir.ui.view">
        <field name="name">res.partner.view.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="3"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_rma_supplier_orders"
                    groups="ol_rma_supplier.group_rma_user"
                    icon="fa-list"
                    invisible="rma_supplier_order_count == 0">
                    <field string="Supplier RMAs" name="rma_supplier_order_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

</odoo>