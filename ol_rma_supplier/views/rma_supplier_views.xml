<odoo>

    <record id="view_rma_supplier_tree" model="ir.ui.view">
        <field name="name">rma.supplier.order.tree</field>
        <field name="model">rma.supplier.order</field>
        <field name="arch" type="xml">
            <tree string="RMA to Supplier">
                <field name="name" optional="show" />
                <field name="partner_id" optional="show" />
                <field name="rma_number" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show" />
                <field name="out_warehouse_id" optional="hide" />
                <field name="out_operation_id" optional="hide" />
                <field name="out_location_id" optional="hide" />
                <field name="in_warehouse_id" optional="hide" />
                <field name="in_operation_id" optional="hide" />
                <field name="in_location_id" optional="hide" />
                <field name="carrier_id" optional="hide" />
                <field name="note" optional="hide" />
                <field name="deliver_status" widget="badge" decoration-success="deliver_status == 'full'" decoration-muted="deliver_status == 'pending'" decoration-info="deliver_status == 'partial'" optional="show" />
                <field name="receipt_status" widget="badge" decoration-success="receipt_status == 'full'" decoration-muted="receipt_status == 'pending'" decoration-info="receipt_status == 'partial'" optional="show" />
                <field name="state" widget="badge" decoration-success="state == 'complete'" decoration-info="state == 'confirm'" decoration-muted="state == 'draft'" decoration-danger="state == 'cancel'" optional="show" />
            </tree>
        </field>
    </record>

    <record id="view_rma_supplier_form" model="ir.ui.view">
        <field name="name">rma.supplier.order.form</field>
        <field name="model">rma.supplier.order</field>
        <field name="arch" type="xml">
            <form string="RMA to Supplier">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state not in ('draft')" class="btn-primary" />
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="(deliver_status != 'full' or receipt_status != 'full') or state in ('draft', 'complete', 'cancel') or not id" />
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('cancel') or not id" />
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state not in ('cancel')" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,complete" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_out_transfers" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="out_transfer_count" widget="statinfo" string="Out Transfers" />
                        </button>
                        <button name="action_view_in_transfers" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="in_transfer_count" widget="statinfo" string="In Transfers" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group name="rma_header">
                        <group name="partner_info">
                            <field name="partner_id" domain="['|',('company_id', '=', False), ('company_id', 'parent_of', [company_id])]"/>
                            <field name="partner_shipping_id" context="{'default_type':'delivery', 'show_address': 1, 'show_vat': False}" readonly="state in ('cancel', 'complete')" domain="['|',('company_id', '=', False), ('company_id', 'parent_of', [company_id])]"/>
                            <field name="rma_number" />
                        </group>
                        <group name="misc">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" />
                            <field name="company_id" />
                        </group>
                    </group>
                    <group name="location_info">
                        <group name="out_info" string="Outbound">
                            <field name="out_warehouse_id" />
                            <field name="out_operation_id" />
                            <field name="out_location_id" />
                            <field name="carrier_id" />
                        </group>
                        <group name="in_info" string="Inbound">
                            <field name="in_warehouse_id" />
                            <field name="in_operation_id" />
                            <field name="in_location_id" />
                        </group>
                    </group>
                    <group name="additional_info" string="Additional Information">
                        <field name="note" placeholder="Enter any useful RMA information here." />
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" optional="show" />
                                    <field name="quantity" optional="show" />
                                    <field name="product_uom" optional="show" />
                                    <field name="note" optional="show" />
                                    <field name="lot_ids" widget="many2many_tags" groups="stock.group_production_lot" invisible="not product_id.has_tracking != 'serial'" options="{'create': [('parent.use_create_lots', '=', True)]}" context="{'default_company_id': parent.company_id, 'default_product_id': product_id}" domain="[('product_id','=',product_id)]" optional="hide" />
                                    <field name="qty_delivered" optional="show" />
                                    <field name="qty_received" optional="show" />
                                </tree>
                            </field>
                        </page>
                        <page string="Transfers">
                            <group>
                                <field name="deliver_status" widget="badge" decoration-success="deliver_status == 'full'" decoration-muted="deliver_status == 'pending'" decoration-info="deliver_status == 'partial'" />
                                <field name="out_transfer_ids" readonly="1">
                                    <tree>
                                        <field name="name" />
                                        <field name="location_id" />
                                        <field name="location_dest_id" />
                                        <field name="scheduled_date" />
                                        <field name="state" optional="show" widget="badge" decoration-danger="state=='cancel'" decoration-info="state== 'assigned'" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state not in ('draft','cancel','done','assigned')" />
                                    </tree>
                                </field>
                                <field name="receipt_status" widget="badge" decoration-success="receipt_status == 'full'" decoration-muted="receipt_status == 'pending'" decoration-info="receipt_status == 'partial'" />
                                <field name="in_transfer_ids" readonly="1" >
                                    <tree>
                                        <field name="name" />
                                        <field name="location_id" />
                                        <field name="location_dest_id" />
                                        <field name="scheduled_date" />
                                        <field name="state" optional="show" widget="badge" decoration-danger="state=='cancel'" decoration-info="state== 'assigned'" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state not in ('draft','cancel','done','assigned')" />
                                    </tree>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_rma_supplier_search" model="ir.ui.view">
        <field name="name">rma.supplier.order.search</field>
        <field name="model">rma.supplier.order</field>
        <field name="arch" type="xml">
            <search string="Search Supplier RMA">
                <field name="name" string="RMA Order" filter_domain="['|', '|', ('name', 'ilike', self), ('rma_number', 'ilike', self), ('partner_id', 'ilike', self)]" />
                <field name="partner_id" operator="child_of" />
                <field name="rma_number" />
                <field name="product_id" />
                <field name="tag_ids" />
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'confirm'])]" />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="confirm" string="Confirmed" domain="[('state', '=', 'confirm')]" />
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]" />
                <filter name="complete" string="Completed" domain="[('state', '=', 'complete')]" />
                <separator/>
                <filter name="pending" string="Not Delivered" domain="[('deliver_status', '=', 'partial')]" />
                <filter name="partial" string="Partially Delivered" domain="[('deliver_status', '=', 'partial')]" />
                <filter name="full" string="Fully Delivered" domain="[('deliver_status', '=', 'full')]" />
                <separator/>
                <filter name="pending" string="Not Received" domain="[('receipt_status', '=', 'partial')]" />
                <filter name="partial" string="Partially Received" domain="[('receipt_status', '=', 'partial')]" />
                <filter name="full" string="Fully Received" domain="[('receipt_status', '=', 'full')]" />
                <separator/>
                <filter name="create_date" string="Created Date" date="create_date" />
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="vendor" domain="[]" context="{'group_by': 'partner_id'}" />
                    <filter string="Tags" name="tag_ids" domain="[]" context="{'group_by': 'tag_ids'}" />
                    <filter string="State" name="state" domain="[]" context="{'group_by': 'state'}" />
                    <filter string="Delivery Status" name="deliver_status" domain="[]" context="{'group_by': 'deliver_status'}" />
                    <filter string="Received Status" name="receipt_status" domain="[]" context="{'group_by': 'receipt_status'}" />
                    <filter string="Create Date" name="create_date" domain="[]" context="{'group_by': 'create_date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_rma_supplier" model="ir.actions.act_window">
        <field name="name">RMA to Supplier</field>
        <field name="res_model">rma.supplier.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_open":1}</field>
    </record>

    <!-- Main Menu -->
    <menuitem
        id="menu_rma_root"
        name="RMA Supplier"
        groups="group_rma_user"
        web_icon="ol_rma_supplier,static/description/icon.png"
        sequence="100"
    />

    <!-- Submenu for RMA to Supplier -->
    <menuitem
        id="menu_rma_supplier"
        name="RMA to Supplier"
        parent="menu_rma_root"
        action="action_rma_supplier"
        sequence="10"
    />

    <!-- Submenu for RMA Configuration -->
    <menuitem
        id="menu_rma_configuration"
        name="Configuration"
        parent="menu_rma_root"
        sequence="20"
    />

    <!-- Warehouse Menu -->
    <menuitem
        id="menu_action_warehouse_form"
        action="stock.action_warehouse_form"
        parent="menu_rma_configuration"
        sequence="10"
    />

    <!-- Tags Menu -->
    <menuitem
        id="menu_action_tags"
        action="rma_supplier_tag_action"
        parent="menu_rma_configuration"
        sequence="10"
    />

</odoo>
