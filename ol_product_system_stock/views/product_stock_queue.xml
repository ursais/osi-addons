<odoo>
	<data>
		<!-- Tree View -->
		<record id="view_stock_state_queue_tree" model="ir.ui.view">
			<field name="name">product.stock.queue.view.tree</field>
			<field name="model">product.stock.queue</field>
			<field name="arch" type="xml">
				<tree string="System Stock State Queues" create="false" delete="false" default_order="create_date desc">
					<field name="create_date"/>
					<field name="product_id"/>
					<field name="company_id"/>
				</tree>
			</field>
		</record>
		<!-- Form View -->
		<record id="view_stock_state_queue_form" model="ir.ui.view">
			<field name="name">product.stock.queue.view.form</field>
			<field name="model">product.stock.queue</field>
			<field name="arch" type="xml">
				<form string="System Stock State Queue" create="false" edit="false" delete="false">
					<sheet style="max-width: 95%;">
						<group>
							<field name="create_date" readonly="1"/>
							<field name="product_id" readonly="1"/>
							<field name="company_id" readonly="1"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>
		<!-- SEARCH VIEW -->
		<record id="view_stock_state_queue_search" model="ir.ui.view">
			<field name="name">product.stock.queue.view.search</field>
			<field name="model">product.stock.queue</field>
			<field name="arch" type="xml">
				<search string="Search GraphQL Queue">
					<field name="product_id"/>
					<field name="company_id"/>
					<group expand="0" string="Group By">
						<filter string="Product" name="group_by_product_id" domain="[]" context="{'group_by':'product_id'}"/>
						<filter string="Company" name="group_by_company_id" domain="[]" context="{'group_by':'company_id'}"/>
					</group>
				</search>
			</field>
		</record>
		<!-- Menu action -->
		<record id="action_stock_state_queue_tree" model="ir.actions.act_window">
			<field name="name">Stock Status Queue</field>
			<field name="res_model">product.stock.queue</field>
			<field name="view_id" ref="view_stock_state_queue_tree"/>
			<field name="view_mode">tree,form</field>
			<field name="context">{'search_default_group_by_product_id': True}</field>
		</record>
		<menuitem name="Stock Status Queue" action="action_stock_state_queue_tree" id="menu_stock_state_queue" sequence="666" parent="stock.menu_warehouse_report"/>
	</data>
</odoo>