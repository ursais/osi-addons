<odoo>

    <template id="bank_transfer_email_template">
      <t t-call="ol_templates.ol_email">
          <!-- Variables -->
          <t t-set="title" t-value="'Bank transfer info for ' + sale_order.name"/>
          <t t-set="preheader_text" t-value="'Bank transfer information for  Order ' + sale_order.name"/>
          <t t-set="include_newsletter_disclaimer" t-value="False"/>

          <!-- Body -->
          <t t-call="ol_templates.ol_email_text_content">
              <div style="font-weight: 500; font-size: 20px;">
                  <tag>You’re Almost There!</tag>
              </div>
              <div style="font-size:16px; line-height:28px; margin-top:30px"><t t-esc="sale_order.partner_id.name"/>,
              </div>
              <p style="font-size: 16px; line-height: 28px; margin-top: 30px;">
                  <tag>Your order has been confirmed and is awaiting payment. Use the information below
                    to complete your bank transfer. We will begin processing your order as soon as payment
                    is received.
                  </tag>
                  <br/>
                  <br/>
                  <tag style="display: inline-block; font-weight: 500;">
                    Your Order Number
                  </tag>
                  <span style="font-weight: 500;" t-esc="sale_order.name"/>
                  <br/>
                  <tag style="display: inline-block; font-weight: 500;">Total Due</tag>
                  <span class="oe_currency_value" style="font-weight: 500;">
                      <t t-esc="object.amount_total" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                  </span>
              </p>
          </t>

          <t t-if="sale_order.company_id.short_name == 'us'">
              <t t-call="ol_templates.ol_domestic_ach_info_us"/>
              <t t-call="ol_templates.ol_email_spacer"/>
              <t t-call="ol_templates.ol_international_ach_info_us"/>
          </t>

          <t t-if="sale_order.company_id.short_name == 'eu'">
              <t t-call="ol_templates.ol_domestic_ach_info_eu"/>
          </t>

          <t t-call="ol_templates.ol_email_spacer"/>
          <t t-call="ol_templates.ol_email_text_content">
              <p style="font-size: 16px; line-height: 28px;">
                  <span style="font-weight: 500;">
                      <tag>Please keep in mind that you may be charged additional bank or wire transfer fees for which you will be
                        responsible.
                      </tag>
                  </span>
                  <br/>
                  <br/>
                  <t t-call="ol_templates.ol_contact_info">
                      <t t-set="company" t-value="sale_order.company_id"/>
                  </t>
              </p>
          </t>
      </t>
    </template>

    <record id="customer_bank_transfer_email_template" model="mail.template">
        <field name="name">OnLogic Customer Bank Transfer Email</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="auto_delete" eval="False"/>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id and object.partner_id.id }} </field>
        <field name="subject">Your Order {{object.name}} - Bank Transfer Information</field>
        <field name="lang">{{ object.contact_ids and object.contact_ids[0].lang or object.partner_id.lang }}</field>
        <field name="report_template_ids" eval="[(4, ref('ol_account.action_proforma_invoice_report'))]"/>
        <field name="body_html" type="html">
            <t t-set="sale_order" t-value="object.with_context({'lang':object.partner_id.lang or object.env.lang})"/>
            <t t-call="ol_bank_transfer_email.bank_transfer_email_template" t-lang="sale_order.partner_id.lang or object.env.lang"/>
        </field>
    </record>

</odoo>
