<odoo>

    <record id="exception_so_bank_tranfer_payment" model="exception.rule">
        <field name="name">Awaiting Bank Transfer Payment</field>
        <field name="description">The sale order has payment method as Bank Tranfer and Payment Status is not Full Paid.</field>
        <field name="sequence">55</field>
        <field name="model">sale.order</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("sale_payment_method_id.name", "=", 'Bank Transfer'), ('invoice_status', '!=', 'full paid'), ("state", "in", ["sent", "sale"])]</field>
    </record>

</odoo>
