<odoo>
	<template id="report_payment_receipt_document_ol_account_reports" inherit_id="account.report_payment_receipt_document">
		<xpath expr="//div[@name='date']/div/span" positios='replace'>
			<span t-esc="o.get_format_date(o.date)">2023-01-01</span>
		</xpath>
		<xpath expr="//span[@t-field='inv.invoice_date']" position="replace">
			<span t-esc="o.get_format_date(inv.invoice_date)">2023-01-01</span>
		</xpath>
		<xpath expr="//span[@t-field='payment.date']" position="replace">
			<span t-esc="o.get_format_date(payment.date)">2023-01-01</span>
		</xpath>
	</template>
</odoo>
