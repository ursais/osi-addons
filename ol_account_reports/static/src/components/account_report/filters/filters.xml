<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="ol_account_reports.AccountRecivableReportFilters" t-inherit="account_reports.AccountReportFiltersCustomizable">
        <xpath expr="//t[@t-if='hasAnalyticGroupbyFilter']" position="before">
            <div id="filter_recivable_comparison" class="filter_partner">
                <Dropdown togglerClass="'btn btn-secondary'">
                    <t t-set-slot="toggler">
                        <i class="fa fa-folder-open me-1"/>Receivable Account
                    </t>

                    <!-- <div class="dropdown-item">
                        <label>Account</label>
                        <MultiRecordSelector t-props="getMultiRecordSelectorProps('account.account', 'selected_receivable_accounts')"/>
                    </div> -->
                    <t t-foreach="controller.options.selected_receivable_accounts" t-as="selected_receivable_accounts" t-key="selected_receivable_accounts_index">
                        <DropdownItem
                            class="{ 'selected': selected_receivable_accounts.selected }"
                            onSelected="() => this.toggleFilter('selected_receivable_accounts.' + selected_receivable_accounts_index + '.selected')"
                        >
                            <t t-out="selected_receivable_accounts.name"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>

    <t t-name="ol_account_reports.AccountPayableReportFilters" t-inherit="account_reports.AccountReportFiltersCustomizable">
        <xpath expr="//t[@t-if='hasAnalyticGroupbyFilter']" position="before">
            <div id="filter_rpayable_comparison" class="filter_partner">
                <Dropdown togglerClass="'btn btn-secondary'">
                    <t t-set-slot="toggler">
                        <i class="fa fa-folder-open me-1"/>Payable Account
                    </t>

                    <!-- <div class="dropdown-item">
                        <label>Account</label>
                        <MultiRecordSelector t-props="getMultiRecordSelectorProps('account.account', 'selected_payable_accounts')"/>
                    </div> -->
                    <t t-foreach="controller.options.selected_payable_accounts" t-as="selected_payable_accounts" t-key="selected_payable_accounts_index">
                        <DropdownItem
                            class="{ 'selected': selected_payable_accounts.selected }"
                            onSelected="() => this.toggleFilter('selected_payable_accounts.' + selected_payable_accounts_index + '.selected')"
                        >
                            <t t-out="selected_payable_accounts.name"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</templates>
