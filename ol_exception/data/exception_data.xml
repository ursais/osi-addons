<odoo>

    <record id="exception_mo_so_unlocked" model="exception.rule">
        <field name="name">Sale Order Change In Progress Exception</field>
        <field name="description">The Sale Order has been unlocked.</field>
        <field name="sequence">71</field>
        <field name="model">mrp.production</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("sale_locked", "=", False), ("state", "not in", ["draft", "done", "cancel"])]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_mo_bom_update" model="exception.rule">
        <field name="name">BoM Update Available</field>
        <field name="description">The BoM for the product has changed.</field>
        <field name="sequence">72</field>
        <field name="model">mrp.production</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("is_outdated_bom", "=", True)]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_do_so_unlocked" model="exception.rule">
        <field name="name">Sale Order Change In Progress Exception</field>
        <field name="description">The Sale Order has been unlocked.</field>
        <field name="sequence">73</field>
        <field name="model">stock.picking</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("sale_locked", "=", False), ("picking_type_code", "=", "outgoing")]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_so_product_update" model="exception.rule">
        <field name="name">Sale Order with Obsolete Product</field>
        <field name="description">Sale Order with Obsolete Product.</field>
        <field name="sequence">74</field>
        <field name="model">sale.order</field>
        <field name="code">failed=any(line.product_id.product_tmpl_id.state == 'obsolete' for line in self.order_line)</field>
        <field name="active" eval="True" />
    </record>

</odoo>
