<odoo noupdate="1">

    <!-- Default Trigger Fields for Sale Orders -->
    <record id="sale_exception_config_ignore_exception" model="exception.config">
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="trigger_field_ids" eval="[(6, 0, [ref('sale_exception.field_sale_order__ignore_exception'), ref('sale.field_sale_order__order_line'), ref('sale.field_sale_order__state'), ref('sale.field_sale_order__locked')])]"/>
    </record>

    <!-- Default Trigger Fields for Stock Pickings -->
    <record id="stock_picking_exception_config_ignore_exception" model="exception.config">
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="trigger_field_ids" eval="[(6, 0, [ref('stock_exception.field_stock_picking__ignore_exception'), ref('stock.field_stock_picking__move_ids'), ref('stock.field_stock_picking__state'), ref('ol_exception.field_stock_picking__sale_locked'),])]"/>
    </record>

    <!-- Default Trigger Fields for Manufacturing Orders -->
    <record id="mo_exception_config_ignore_exception" model="exception.config">
        <field name="model_id" ref="mrp.model_mrp_production" />
        <field name="trigger_field_ids" eval="[(6, 0, [ref('mrp_exception.field_mrp_production__ignore_exception'), ref('mrp.field_mrp_production__move_raw_ids'), ref('mrp.field_mrp_production__product_id'), ref('mrp.field_mrp_production__workorder_ids'), ref('ol_exception.field_mrp_production__sale_locked'), ref('mrp.field_mrp_production__is_outdated_bom'),])]"/>
    </record>

</odoo>
