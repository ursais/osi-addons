<odoo>

   	<record id="ol_exception_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_exception.view_order_form" />
        <field name="arch" type="xml">
            <field name="ignore_exception" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="ignore_exception" position="after">
                <field name="ignored_exception_ids" widget="many2many_tags" groups="base_exception.group_exception_rule_manager" />
            </field>
        </field>
    </record>

</odoo>
