<odoo noupdate="1">

    <!-- Multi-company record rule for helpdesk_rma -->
    <record id="report_extra_content_multico_rule" model="ir.rule">
        <field name="name">Report Extra Content Multi-company Rule</field>
        <field name="model_id" ref="ls_pdf_reports.model_report_extra_content"/>
        <field name="domain_force">['|', ('company_id','=',False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
