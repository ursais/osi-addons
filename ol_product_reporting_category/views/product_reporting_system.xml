<odoo>

	<record id="view_product_reporting_system_tree" model="ir.ui.view">
        <field name="name">product.reporting.system.tree</field>
        <field name="model">product.reporting.system</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="series_id"/>
            </tree>
        </field>
    </record>

    <record id="view_product_reporting_system_form" model="ir.ui.view">
        <field name="name">product.reporting.system.form</field>
        <field name="model">product.reporting.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="series_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

	<record id="action_product_reporting_system" model="ir.actions.act_window">
	    <field name="name">Reporting Systems</field>
	    <field name="res_model">product.reporting.system</field>
	    <field name="view_mode">tree,form</field>
	</record>

	<menuitem
		id="menu_product_reporting_system"
		name="Reporting Systems"
		parent="ol_product_reporting_category.menu_product_reporting"
		action="ol_product_reporting_category.action_product_reporting_system"
    />

</odoo>
