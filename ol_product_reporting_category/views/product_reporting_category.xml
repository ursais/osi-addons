<odoo>

    <record id="view_product_reporting_category_tree" model="ir.ui.view">
        <field name="name">product.reporting.category.tree</field>
        <field name="model">product.reporting.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="view_product_reporting_category_form" model="ir.ui.view">
        <field name="name">product.reporting.category.form</field>
        <field name="model">product.reporting.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="line_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_reporting_category" model="ir.actions.act_window">
        <field name="name">Reporting Categories</field>
        <field name="res_model">product.reporting.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_product_reporting"
        name="Product Reporting"
        parent="stock.menu_stock_config_settings"
        sequence="20"
    />

    <menuitem
        id="menu_product_reporting_category"
        name="Reporting Categories"
        parent="ol_product_reporting_category.menu_product_reporting"
        action="ol_product_reporting_category.action_product_reporting_category"
    />

</odoo>
