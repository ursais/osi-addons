<odoo>

	<record id="view_product_reporting_series_tree" model="ir.ui.view">
        <field name="name">product.reporting.series.tree</field>
        <field name="model">product.reporting.series</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="view_product_reporting_series_form" model="ir.ui.view">
        <field name="name">product.reporting.series.form</field>
        <field name="model">product.reporting.series</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="line_id"/>
                        <field name="system_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

	<record id="action_product_reporting_series" model="ir.actions.act_window">
	    <field name="name">Reporting Series</field>
	    <field name="res_model">product.reporting.series</field>
	    <field name="view_mode">tree,form</field>
	</record>

	<menuitem
        id="menu_product_reporting_series"
        name="Reporting Series"
        parent="ol_product_reporting_category.menu_product_reporting"
        action="ol_product_reporting_category.action_product_reporting_series"
    />

</odoo>
