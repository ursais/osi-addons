<odoo>

	<record id="view_product_reporting_line_tree" model="ir.ui.view">
	    <field name="name">product.reporting.line.tree</field>
	    <field name="model">product.reporting.line</field>
	    <field name="arch" type="xml">
	        <tree>
	            <field name="name" />
	        </tree>
	    </field>
	</record>

	<record id="view_product_reporting_line_form" model="ir.ui.view">
	    <field name="name">product.reporting.line.form</field>
	    <field name="model">product.reporting.line</field>
	    <field name="arch" type="xml">
	        <form>
	            <sheet>
	                <group>
	                    <field name="name"/>
	                    <field name="category_id"/>
	                </group>
	                <group>
	                	<field name="series_ids"/>
	                </group>
	            </sheet>
	        </form>
	    </field>
	</record>

	<record id="action_product_reporting_line" model="ir.actions.act_window">
	    <field name="name">Reporting Lines</field>
	    <field name="res_model">product.reporting.line</field>
	    <field name="view_mode">tree,form</field>
	</record>

	<menuitem
		id="menu_product_reporting_line"
		name="Reporting Lines"
		parent="ol_product_reporting_category.menu_product_reporting"
		action="ol_product_reporting_category.action_product_reporting_line"
	/>

</odoo>
