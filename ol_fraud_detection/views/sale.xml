<odoo>

    <!-- Sale Order Form -->
    <record id="ol_fraud_detection_view_order_form" model="ir.ui.view">
        <field name="name">ol_fraud_detection.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="fraud" string="Fraud" invisible="not check_risk">
                    <field name="check_risk" invisible="1" />
                    <group name="fraud" string="Maxmind Results">
                        <field name="customer_ip" />
                        <field name="maxmind_risk_score" />
                        <field name="maxmind_insights" />
                    </group>
                </page>
            </notebook>
            <field name="payment_term_id" position="after">
                <field name="sale_payment_method_id" />
            </field>
        </field>
    </record>

    <record id="view_order_tree_inherit_ol_fraud_detection" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="before">
                <field name="sale_payment_method_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
