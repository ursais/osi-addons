<odoo noupdate="1">

    <!-- Fraud check exception definition -->
    <record id="exception_high_fraud" model="exception.rule">
        <field name="name">High Fraud Score Exception</field>
        <field name="description">Fraud Score Over Acceptable Threshold</field>
        <field name="sequence">72</field>
        <field name="model">sale.order</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[('check_risk','=',True), ('maxmind_risk_score', '&gt;=', 1)]</field>
        <field name="active" eval="True" />
    </record>

</odoo>
