<odoo>

    <!-- Paper format for Bin Labels -->
    <record id="bin_label_paperformat" model="report.paperformat">
        <field name="name">Bin Label Custom Format</field>
        <field name="format">custom</field>
        <field name="page_height">102</field>
        <field name="page_width">152</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top" eval="10"/>
        <field name="margin_bottom" eval="0"/>
        <field name="margin_left" eval="5"/>
        <field name="margin_right" eval="5"/>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_mo_bin_label" model="ir.actions.report">
        <field name="name">MO Bin Label</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'%s Bin Label' % (object.name or 'MO')</field>
        <field name="report_name">ol_mrp.report_mo_bin_label</field>
        <field name="report_file">ol_mrp.report_mo_bin_label</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="paperformat_id" ref="ol_mrp.bin_label_paperformat"/>
    </record>

    <!-- Template -->
    <template id="report_mo_bin_label">
        <t t-foreach="docs" t-as="mo_record">
            <t t-set="mo_data" t-value="mo_record.get_bin_label_data()" />
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <div class="content bin_label" >
                            <div class="address">
                              <div class="main-info">
                                  <div class="flag">
                                      <t t-if="mo_data['rush_order']">
                                        RUSH
                                      </t>
                                  </div>
                                  <t t-esc="mo_data['customer']" />
                                  <br />
                                  <span class="sale-info">
                                      <t t-esc="mo_data['sale_order']" />
                                  </span>
                                  <br/>
                                  <t t-esc="mo_data['carrier']" />
                                </div>
                            </div>
                            <h1 class="name">
                                <t t-esc="mo_data['name']"/>
                            </h1>
                            <div class="product">
                                <t t-esc="mo_data['product']"/>
                            </div>
                            <div class="footer-left bold">Salesperson:</div>
                            <div class="footer-right bold">Ship By:</div>
                            <div class="footer-left">
                                <t t-esc="mo_data['salesperson']" />
                            </div>
                            <div class="footer-right">
                                <t t-esc="mo_data['ship_by']" />
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
