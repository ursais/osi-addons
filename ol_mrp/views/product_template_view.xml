<odoo>

    <record model="ir.ui.view" id="phantom_kit_product_template_form_view">
        <field name="name">product_template_form_view_phantom_kits</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field name="is_phantom_kit"/>
                <field name="phantom_bom_id" domain="[('product_tmpl_id', '=', id)]" />
            </field>
        </field>
    </record>

</odoo>
