<odoo>

    <record id="mrp_production_form_view_inherit_ol_sale_mrp_tags" model="ir.ui.view">
        <field name="name">mrp.production.inherit.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sale_order_id" invisible="1"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='forecast_availability']" position="before">
                <field name="date" optional="hide" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="mrp_production_search_view_inherit_lot_serach" model="ir.ui.view">
        <field name="name">mrp.production.search.view.inherit.lot.serach</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <field name="workcenter_id" position="after">
                <field name="lot_producing_id"/>
                <separator/>
                <filter name="lot_producing_id" context="{'group_by': 'lot_producing_id'}"/>
            </field>
        </field>
    </record>

</odoo>
