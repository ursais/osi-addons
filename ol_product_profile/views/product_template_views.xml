<odoo>

    <record id="ol_product_profile_product_template_form_view" model="ir.ui.view">
        <field name="name">ol_product_tariff.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="detailed_type" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
            <field name="invoice_policy" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
            <field name="uom_po_id" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
            <field name="tracking" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
            <field name="route_ids" position="attributes">
                <attribute name="readonly">profile_id</attribute>
            </field>
        </field>
    </record>

</odoo>
