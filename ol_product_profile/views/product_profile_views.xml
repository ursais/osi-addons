<odoo>

    <record id="product_profile_form_view" model="ir.ui.view">
        <field name="name">product.profile.form.view</field>
        <field name="model">product.profile</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Product Profile">
                <group>
                    <field name="sequence" />
                    <field name="name" />
                    <field name="explanation" />
                </group>
                <group name="product_settings" string="Product Settings">
                    <group name="product_settings_general" string="General">
                        <field name="has_products" invisible="1" />
                        <field name="detailed_type" required="1" />
                        <field name="invoice_policy" required="1" />
                        <field name="uom_id" required="1" />
                        <field name="categ_id" required="1" readonly="has_products" />
                    </group>
                    <group name="product_settings_purchase" string="Purchase">
                        <field name="uom_po_id" />
                    </group>
                    <group name="product_settings_inventory" string="Inventory">
                        <field name="route_ids" class="mb-0" widget="many2many_checkboxes" />
                    </group>
                </group>
            </form>
        </field>
    </record>

</odoo>
