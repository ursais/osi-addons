<odoo>

    <!-- Product Classification Search View -->
    <record id="product_attribute_classification_search" model="ir.ui.view">
        <field name="name">product.attribute.classification.search</field>
        <field name="model">product.attribute.classification</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Options">
                <group string="Group by ..." name="groupby">
                </group>
                <field name="name" string="Option Title"/>
            </search>
        </field>
    </record>

    <!-- Product Classification Tree View -->
    <record id="product_attribute_classification_tree_view" model="ir.ui.view">
        <field name="name">product.attribute.classification.tree</field>
        <field name="model">product.attribute.classification</field>
        <field name="arch" type="xml">
            <tree string="BoM Line Options">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Product Classification Form View -->
    <record id="product_attribute_classification_form_view" model="ir.ui.view">
        <field name="name">product.attribute.classification.form</field>
        <field name="model">product.attribute.classification</field>
        <field name="arch" type="xml">
            <form string="Product Attribute Classification">
                <sheet style="max-width: 90%;">
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook name="main_tabs">
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Classification Action -->
    <record id="action_product_attribute_classification_tree" model="ir.actions.act_window">
        <field name="name">Product Attribute Classification</field>
        <field name="res_model">product.attribute.classification</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="ol_product_classification.product_attribute_classification_tree_view"/>
    </record>

    <!-- Classification Menu Item -->
    <menuitem
        id="menu_product_attribute_classification"
        parent="stock.menu_product_in_config_stock"
        action="ol_product_classification.action_product_attribute_classification_tree"
        sequence="5"
    />

</odoo>
