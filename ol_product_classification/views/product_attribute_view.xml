<odoo>

    <record id="ol_product_classification_attribute_tree_view" model="ir.ui.view">
        <field name="name">ol_product_classification.attribute_tree_view</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.attribute_tree_view"/>
        <field name="arch" type="xml">
            <field name="create_variant" position="after">
            	<field name="classification_id"/>
            </field>
        </field>
    </record>

    <record id="ol_product_classification_product_attribute_view_form" model="ir.ui.view">
        <field name="name">ol_product_classification.product_attribute_view_form</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <field name="create_variant" position="after">
            	<field name="classification_id"/>
            </field>
        </field>
    </record>

</odoo>
