<odoo>
  <data>
    <!-- Component: MC600G -->
    <record id="mc600g" model="product.product">
      <!-- General Info -->
      <field name="name">MC600 Compact Mini-ITX Case (Orange and Silver)</field>
      <field name="default_code">MC600G</field>
      <field name="company_id" eval="" />
      <field name="description_sale">As eye-catching as it is functional, the MC600 in orange and silver stands out from the ranks of indistinguishable IPC cases, not just based on its looks, but due to its versatility, durability, and ease of customization.</field>
    </record>
    <!-- product.template record is automatically created from the product.product-->
    <record id="mc600g_product_template" model="product.template">
      <field name="type">product</field>
      <field name="categ_id" ref="ol_base.product_category_components" />
      <field name="list_price">65</field>
    </record>
    <!--
    Phantom Kit: DHXA-223-K
    This is a copy of the DHXA-222-K demo phantom kit, but with an mrp.bom record in each Odoo company. 
    Phantom kit behavior changed with replatform, and changing the existing demo phanom kit broke many 
    unit tests, hence this similar copy.
    -->
    <record id="dhxa-223-k" model="product.product">
      <field name="default_code">DHXA-223-K</field>
      <field name="name">Atheros Dual Band Wi-Fi and Bluetooth 4.0/HS PCIe Mini Card (DHXA-222)</field>
    </record>
    <record id="dhxa-223-k_product_template" model="product.template">
      <field name="type">product</field>
      <field name="categ_id" ref="ol_base.product_category_components"/>
      <field name="list_price">39</field>
    </record>
    <!-- US Phantom Kit BOM-->
    <record id="DHXA-223-K-mrp_bom_kit" model="mrp.bom">
      <field name="code">DHXA-223-K Phantom BOM</field>
      <field name="product_id" ref="dhxa-223-k"/>
      <field name="product_tmpl_id" ref="dhxa-223-k_product_template"/>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="company_id" ref="base.main_company"/>
      <field name="sequence">0</field>
      <field name="type">phantom</field>
      <field name="product_qty">1.00</field>
      <field name="ready_to_produce">asap</field>
      <field name="historical_bom" eval="False"/>
    </record>
    <!-- US Phantom Kit BOM Lines-->
    <record id="DHXA-223-K-mrp_bom-KWPTCv0-18-mrp_bom_kit_line" model="mrp.bom.line">
      <field name="product_id" ref="ol_base.KWPTCv0-18"/>
      <field name="product_qty">2</field>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="bom_id" ref="DHXA-223-K-mrp_bom_kit"/>
    </record>
    <record id="DHXA-223-K-mrp_bom-DHXA-222-mrp_bom_kit_line" model="mrp.bom.line">
      <field name="product_id" ref="ol_base.DHXA-222"/>
      <field name="product_qty">1</field>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="bom_id" ref="DHXA-223-K-mrp_bom_kit"/>
    </record>
    <!-- Linking the product.template and the US mrp.bom record-->
    <record id="DHXA-223-K_phantom_bom_id" model="ir.property" forcecreate="True">
      <field name="name">phantom_bom_id</field>
      <field name="type">many2one</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="fields_id" search="[('model', '=', 'product.template'),('name','=', 'phantom_bom_id')]" />
      <field name="res_id" eval="'product.template,{}'.format(ref('dhxa-223-k_product_template'))" />
      <field name="value_reference" eval="'mrp.bom,{}'.format(ref('DHXA-223-K-mrp_bom_kit'))"/>
    </record>
    <!-- EU Phantom Kit BOM-->
    <record id="DHXA-223-EU-K-mrp_bom_kit" model="mrp.bom">
      <field name="code">DHXA-223-K Phantom BOM</field>
      <field name="product_id" ref="dhxa-223-k"/>
      <field name="product_tmpl_id" ref="dhxa-223-k_product_template"/>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="company_id" ref="ol_base.onlogic_eu"/>
      <field name="sequence">1000</field>
      <field name="type">phantom</field>
      <field name="product_qty">1.00</field>
      <field name="ready_to_produce">asap</field>
      <field name="historical_bom" eval="False"/>
    </record>
    <!-- EU Phantom Kit BOM Lines-->
    <record id="DHXA-223-EU-K-mrp_bom-KWPTCv0-18-mrp_bom_kit_line" model="mrp.bom.line">
      <field name="product_id" ref="ol_base.KWPTCv0-18"/>
      <field name="product_qty">2</field>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="bom_id" ref="DHXA-223-EU-K-mrp_bom_kit"/>
    </record>
    <record id="DHXA-223-EU-K-mrp_bom-DHXA-222-mrp_bom_kit_line" model="mrp.bom.line">
      <field name="product_id" ref="ol_base.DHXA-222"/>
      <field name="product_qty">1</field>
      <field name="product_uom_id" ref="uom.product_uom_unit"/>
      <field name="bom_id" ref="DHXA-223-EU-K-mrp_bom_kit"/>
    </record>
    <!-- Linking the product.template and the EU mrp.bom record-->
    <record id="DHXA-223-K_phantom_bom_id_eu" model="ir.property" forcecreate="True">
      <field name="name">phantom_bom_id</field>
      <field name="type">many2one</field>
      <field name="company_id" ref="ol_base.onlogic_eu" />
      <field name="fields_id" search="[('model', '=', 'product.template'),('name','=', 'phantom_bom_id')]" />
      <field name="res_id" eval="'product.template,{}'.format(ref('dhxa-223-k_product_template'))" />
      <field name="value_reference" eval="'mrp.bom,{}'.format(ref('DHXA-223-EU-K-mrp_bom_kit'))"/>
    </record>
  </data>
</odoo>