<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Grant the portal mobile worker group on every default feature line.
        Uses (4,) so upgrades add the group without wiping manager/other groups.
    -->
    <record id="fsm_feature_location" model="fsm.mobile.feature.line">
        <field name="group_ids" eval="[(4, ref('group_fsm_mobile_portal'))]" />
    </record>
