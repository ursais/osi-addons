<odoo>

    <record id="ls_templates_settings" model="ir.ui.view">
        <field name="name">ls.templates.settings</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Company Specific Images">
                    <group name="company_specific_images">
                        <group string="Company Specific Images">
                            <field name="template_logo" widget="image" class="oe_avatar"/>
                            <field name="linkedin_image" widget="image" class="oe_avatar"/>
                            <field name="twitter_image" widget="image" class="oe_avatar"/>
                            <field name="youtube_image" widget="image" class="oe_avatar"/>
                            <field name="facebook_image" widget="image" class="oe_avatar"/>
                            <field name="placeholder_image_product" widget="image" class="oe_avatar"/>
                            <field name="placeholder_image_phone_icon" widget="image" class="oe_avatar"/>
                            <field name="placeholder_image_email_icon" widget="image" class="oe_avatar"/>
                            <field name="placeholder_image_profile_picture" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
