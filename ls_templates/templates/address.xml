<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="address">
    <div class="ls-address">
      <p>
        <span t-if="text" class="ls-address-text" t-esc="text"/>
        <br/>
        <t t-if="not sender">
          <strong>
            <!-- TODO: address.get_company_name() method not found -->
            <!-- <t t-esc="address.get_company_name()"/> -->
            <t t-esc="address.company_name"/>
          </strong>
          <br/>
          <t t-esc="address.name"/>
        </t>
        <t t-if="sender">
          <strong>
            <t t-esc="address._name == 'res.company' and address.external_display_name or address.name"/>
          </strong>
        </t>
        <br/>
        <t t-esc="address.street"/>
        <br/>
        <t t-if="address.street2">
          <t t-esc="address.street2"/>
          <br/>
        </t>
        <t t-esc="address.city"/>,
        <t t-if="address.country_id.code == 'US'">
          <t t-esc="address.state_id.code"/>
        </t>
        <t t-else="">
          <t t-esc="address.state_id.name"/>
        </t>
        <t t-esc="address.zip"/>
        <br/>
        <t t-esc="address.country_id.name"/>
        <br/>
        <t t-if="show_vat_id and address.vat">
          <tag>VAT ID:</tag> <t t-esc="address.vat"/>
          <br/>
        </t>
      </p>
    </div>
  </template>

