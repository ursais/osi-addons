<odoo>

    <record id="account_move_form" model="ir.ui.view">
        <field name="name">ol_account.account_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="action_invoice_sent" position="after">
                <!-- Add Print button -->
                <button
                    name="action_invoice_print"
                    class="oe_highlight"
                    string="Print"
                    type="object"
                    invisible="state == 'draft' or move_type in ('out_invoice', 'out_refund')"
                />
            </button>
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="payment_preference" invisible="move_type not in ('in_invoice', 'in_refund')" />
            </xpath>
            <field name="payment_reference" position="after">
                <field name="sale_payment_method_id" invisible="move_type != 'out_invoice'"/>
            </field>
            <field name="invoice_date_due" position="attributes">
                <attribute name="invisible">invoice_payment_term_id or move_type in ('in_invoice')</attribute>
            </field>
            <label for="invoice_date_due" position="attributes">
                <attribute name="invisible">invoice_payment_term_id or move_type in ('in_invoice')</attribute>
            </label>
            <label for="invoice_payment_term_id" position="attributes">
                <attribute name="invisible">not invoice_payment_term_id and move_type not in ('in_invoice')</attribute>
            </label>
            <xpath expr="//div[@name='due_date']/span" position="attributes">
                <attribute name="invisible">state != 'draft' or invoice_payment_term_id or move_type in ('in_invoice')</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="after">
                <label for="invoice_date_due" string="Bill Date" style="font-weight:bold;" invisible="move_type not in ('in_invoice')"/>
                <div class="d-flex" invisible="move_type not in ('in_invoice')" name="due_date_in_invoice">
                    <field name="invoice_date_due" force_save="1" placeholder="Date"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_search_filter" model="ir.ui.view">
        <field name="name">ol_account.view_account_move_filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('partner_id.name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit_payment_pref" model="ir.ui.view">
        <field name="name">account.move.tree.payment.pref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="payment_preference" />
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_ol_account" model="ir.ui.view">
        <field name="name">account.invoice.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="payment_state" position="before">
                <field name="sale_payment_method_id" column_invisible="context.get('default_move_type') not in ('out_invoice')"/>
            </field>
            <!-- Remove Widget from Due Date -->
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="invoice_date_due_display" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_ol_account_bill" model="ir.ui.view">
        <field name="name">account.bill.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']/field[@name='company_id']" position="after">
                <field name="invoice_origin" invisible="move_type != 'in_invoice'"/>
            </xpath>
        </field>
    </record>

</odoo>
