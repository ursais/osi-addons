<odoo>

    <record id="view_partner_form_inherit_payment_pref" model="ir.ui.view">
        <field name="name">res.partner.form.payment.pref</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Sale&Purchase tab -->
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="payment_preference"/>
            </xpath>
            <xpath expr="//group[@name='sale']//field[@name='user_id']" position="after">
                <field name="net_terms_allowed" invisible="1"/>
                <field name="net_terms_active" invisible="not net_terms_allowed"/>
            </xpath>
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="sale_payment_method_id"/>
            </xpath>
            <!-- Allow vat and address editing for children-->
            <field name="vat" position="attributes">
                <attribute name="readonly">parent_id and not is_company</attribute>
            </field>
            <field name="street" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
            <field name="street2" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
            <field name="state_id" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
            <field name="zip" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
            <field name="country_id" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id and not is_company</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_property_form_inherit_supplier_limit" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.debit_limit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='credit_limits']/div[1]" position="after">
                <field name="debit_limit" />
            </xpath>
        </field>
    </record>

</odoo>
