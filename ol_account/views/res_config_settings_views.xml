<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto.invoice.post</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Automatic Invoice/Bill Create and Post" id="auto_invoice_create_post">
                    <setting id="delivery_validate" string="Auto Create Customer Invoice" help="Create customer invoice on delivery validate">
                        <field name="auto_create_invoice_delivery_validate" widget="upgrade_boolean" />
                    </setting>
                    <setting id="delivery_validate_post" string="Auto Post Customer Invoice" invisible="not auto_create_invoice_delivery_validate" help="Post customer invoice on delivery validate">
                        <field name="auto_post_invoice_delivery_validate" widget="upgrade_boolean" />
                    </setting>
                    <setting id="receipt_validate" string="Auto Create Vendor Bill" help="Create vendor bill on receipt validate">
                        <field name="auto_create_bill_receipt_validate" widget="upgrade_boolean" />
                    </setting>
                    <setting id="receipt_validate_post" string="Auto Post Vendor Bill" invisible="not auto_create_bill_receipt_validate" help="Post vendor bill on receipt validate">
                        <field name="auto_post_bill_receipt_validate" widget="upgrade_boolean" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
