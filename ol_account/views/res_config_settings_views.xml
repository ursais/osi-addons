<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto.invoice.post</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Automatic Invoice Create/Post" id="auto_invoice_create_post">
                    <setting id="delivery_validate" string="Auto Create invoice" help="Create invoice on delivery validate">
                        <field name="auto_create_invoice_delivery_validate" widget="upgrade_boolean" />
                    </setting>
                    <setting id="delivery_validate_post" string="Auto Post invoice" invisible="not auto_create_invoice_delivery_validate" help="Post invoice on delivery validate">
                        <field name="auto_post_invoice_delivery_validate" widget="upgrade_boolean" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
