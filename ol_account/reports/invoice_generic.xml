<odoo>

    <!-- Remove oob report actions as we will have custom reports -->
    <function model="ir.actions.report"
        name="unlink_action"
        eval="[[ref('account.account_invoices'), ref('account.account_invoices_without_payment')]]"
    />

    <!-- Report Action -->
    <record id="action_generic_invoice_report" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="print_report_name">'Invoice'</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ol_account.report_generic_invoice</field>
        <field name="report_file">ol_account.report_generic_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="paperformat_xmlid_base">ol_templates.ol_report_paper_format</field>
    </record>

    <!-- Main template -->
    <template id="report_generic_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Find the correct language-->
                <t t-set="sale_order" t-value="doc.line_ids.sale_line_ids.order_id"/>
                <t t-set="language" t-value="sale_order.contact_ids and sale_order.contact_ids[0].lang or doc.partner_id.lang"/>
                <t t-set="invoice" t-value="doc.with_context(lang=language)"/>
                <!-- Call the template document with the language set -->
                <t t-call="ol_account.report_generic_invoice_document" t-lang="language"/>
            </t>
        </t>
    </template>

    <template id="report_generic_invoice_document">
        <t t-call="ol_templates.external_layout">
            <!-- Set the name and title of the Report -->
            <t t-if="invoice.move_type in ['out_refund', 'in_refund']">
                <t t-set="report_title">Credit</t>
            </t>
            <t t-else="">
                <t t-set="report_title">INVOICE</t>
            </t>
            <!--Set template variables-->
            <t t-set="title" t-value="'Invoice PDF Report'"/>
            <t t-set="customer_company_name" t-value="invoice.partner_id.company_name or invoice.partner_id.commercial_company_name"/>
            <t t-set="sale_order" t-value="invoice.line_ids.sale_line_ids.order_id"/>
            <t t-set="partner_invoice_id" t-value="invoice.partner_id or sale_order.partner_invoice_id"/>
            <t t-set="budgetary_quote" t-value="sale_order.type_id.name == 'Budgetary'"/>
            <t t-set="currency" t-value="invoice.currency_id"/>
            <t t-set="company" t-value="invoice.company_id"/>
            <t t-set="hide_tracking" t-value="True"/>
            <t t-if="onlogic_data[invoice.id]['sale_order']">
                <t t-set="product_lines" t-value="onlogic_data[invoice.id]['sale_order']['product_lines']"/>
                <t t-set="shipping_lines" t-value="onlogic_data[invoice.id]['sale_order']['shipping_lines']"/>
                <t t-set="product_subtotal_amount" t-value="onlogic_data[invoice.id]['sale_order']['product_subtotal_amount']"/>
                <t t-set="shipping_subtotal_amount" t-value="onlogic_data[invoice.id]['sale_order']['shipping_subtotal_amount']"/>
            </t>
            <t t-else="">
                <t t-set="invoice_lines" t-value="invoice.invoice_line_ids"/>
            </t>

            <!--The first main information block-->
            <div class="ol_report_info_row ol_flex">

                <!--Basic Invoice information-->
                <div class="ol_report_info_row_col info">
                    <div class="ol_report_info_row_col_title ol_flex">
                        <div class="key">
                            <t t-esc="report_title" t-options='{"widget": "cap_formatter", "case":"title"}'/>
                        </div>
                        <!-- EU invoice numbers might wrap to next line, so make their text smaller if we go over length limit -->
                        <t t-if="len(invoice.name) &gt; 14">
                            <div class="value" style="font-size: 12px; white-space: nowrap;">
                                <t t-esc="invoice.name"/>
                            </div>
                        </t>
                        <t t-if="len(invoice.name) &lt; 15">
                            <div class="value" style="white-space: nowrap;">
                                <t t-esc="invoice.name"/>
                            </div>
                        </t>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Invoice Date</tag>
                        </div>
                        <div class="value">
                            <t t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/>
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Payment Due Date</tag>
                        </div>
                        <div class="value">
                            <t t-esc="invoice.invoice_date_due" t-options='{"widget": "date"}'/>
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Order</tag>
                        </div>
                        <div class="value">
                            <t t-esc="sale_order.name"/>
                        </div>
                    </div>
                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <tag>Order Date</tag>
                        </div>
                        <div class="value">
                            <t t-esc="sale_order.date_order" t-options='{"widget": "date"}'/>
                        </div>
                    </div>
                    <t t-if="sale_order.client_order_ref">
                        <div class="ol_report_info_row_col_line ol_flex">
                            <div class="key">
                                <tag>Customer PO</tag>
                            </div>
                            <div class="value">
                                <t t-esc="sale_order.client_order_ref"/>
                            </div>
                        </div>
                    </t>
                </div>

                <!--Billing related information-->
                <div class="ol_report_info_row_col billing">
                    <t t-call="ol_templates.address">
                        <t t-set="text">Bill To</t>
                        <t t-set="address" t-value="partner_invoice_id"/>
                    </t>
                    <t t-call="ol_templates.payment" t-if="sale_order.sale_payment_method_id">
                        <t t-set="block_title">Payment Method</t>
                        <t t-set="payment_method" t-value="sale_order.sale_payment_method_id"/>
                    </t>
                </div>

                <!--Shipping related information-->
                <div class="ol_report_info_row_col shipping">
                    <t t-call="ol_templates.address">
                        <t t-set="text">Ship To</t>
                        <t t-set="show_vat_id" t-value="True"/>
                        <t t-set="address" t-value="sale_order.partner_shipping_id or invoice.partner_shipping_id"/>
                    </t>
                    <t t-call="ol_templates.shipment" t-if="sale_order.carrier_id">
                        <t t-set="block_title">Shipping Method</t>
                        <t t-if="sale_order">
                            <t t-set="shipment" t-value="sale_order.carrier_id"/>
                        </t>
                        <t t-set="tracking_numbers" t-value="sale_order.mapped('picking_ids.carrier_tracking_ref')"/>
                    </t>
                </div>
            </div>
            <!--Product list-->
            <t t-if="sale_order">
                <t t-call="ol_templates.report_products">
                    <t t-set="products_title">
                      Hardware Solution
                    </t>
                </t>
            </t>
            <t t-else="">
                <t t-call="ol_templates.report_invoiceable_lines">
                    <t t-set="products_title">
                      Invoice Lines
                    </t>
                </t>
            </t>
            <!--Order noted and totals-->
            <t t-if="sale_order">
                <t t-call="ol_templates.report_notes_and_totals"/>
            </t>
            <t t-else="">
                <t t-call="ol_templates.report_invoice_notes_and_totals"/>
            </t>
        </t>
    </template>

</odoo>
