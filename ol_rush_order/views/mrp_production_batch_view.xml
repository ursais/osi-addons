<odoo>

    <record id="ol_rush_order_mrp_production_batch_tree_view" model="ir.ui.view">
		<field name="name">mrp.production.batch.tree.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="inherit_id" ref="mrp_batch.mrp_production_batch_tree_view"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="rush_order" optional="hide" />
            </field>
        </field>
    </record>

	<record id="ol_rush_order_mrp_production_batch_form_view" model="ir.ui.view">
		<field name="name">mrp.production.batch.form.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="inherit_id" ref="mrp_batch.mrp_production_batch_form_view"/>
        <field name="arch" type="xml">
            <field name='sale_tag_ids' position="before">
                <field name="rush_order" invisible="1"/>
            </field>
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="before">
                <widget name="web_ribbon" title="RUSH ORDER" bg_color="text-bg-danger" invisible="not rush_order"/>
            </xpath>
            <xpath expr="//field[@name='production_ids']/tree/field[@name='sale_order_id']" position="after">
                <field name="rush_order" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
