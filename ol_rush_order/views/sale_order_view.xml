<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="RUSH ORDER" bg_color="text-bg-danger" invisible="not rush_order"/>
            </xpath>
            <field name="require_signature" position="after">
                <field name="rush_order" />
            </field>
        </field>
    </record>

</odoo>
