<odoo>

    <record id="view_constrained_sku_result_wizard" model="ir.ui.view">
        <field name="name">view.constrained.sku.result.wizard.form</field>
        <field name="model">constrained.sku.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Constrained SKU Result Wizard" class="o_sale_order">
                <group name="info_grp" colspan="4">
                    <div class="alert alert-info" role="alert">
                        <field name="allocate" invisible="1" />
                        <div invisible="not allocate">The following SKUs were allocated in these Transfers</div>
                        <div invisible="allocate">The following SKUs were unallocated in these Transfers</div>
                        <div>
                        ✅ = Fully allocated
                        ⚠️ = Partial allocation
                        ❌ = No allocation
                        </div>
                    </div>
                </group>

                <group name="line_grp" colspan="4">
                    <field name="processed_line_ids" readonly="1">
                        <tree delete="false" create="false" editable="false">
                            <field name="picking_id" />
                            <field name="sale_order_id" />
                            <field name="change_indicator" widget="emoji_char" />
                            <field name="product_id" />
                        </tree>
                    </field>
                </group>

                <group name="line_grp" colspan="4">
                    <field name="skipped_line_ids" readonly="1">
                        <tree delete="false" create="false" editable="false">
                            <field name="picking_id" />
                            <field name="sale_order_id" />
                            <field name="product_id" />
                            <field name="skip_reason" />
                        </tree>
                    </field>
                </group>

                <footer>
                    <button string="Close" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>