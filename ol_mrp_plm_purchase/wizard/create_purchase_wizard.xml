<odoo>

    <record id="view_purchase_creation_wizard_form" model="ir.ui.view">
        <field name="name">purchase.creation.wizard.form</field>
        <field name="model">purchase.creation.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase RFQ">
                <group>
                    <field name="partner_id" domain="[('approved_vendor', '=', True)]" />
                    <field name="product_id" domain="[('purchase_ok', '=', True)]" />
                </group>
                <footer>
                    <button string="Create" type="object" name="action_create_purchase" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_creation_wizard" model="ir.actions.act_window">
        <field name="name">Create Purchase RFQ</field>
        <field name="res_model">purchase.creation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
