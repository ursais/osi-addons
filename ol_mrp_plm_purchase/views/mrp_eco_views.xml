<odoo>

    <record id="ol_mrp_plm_eco_view_form" model="ir.ui.view">
        <field name="name">mrp.eco.form</field>
        <field name="model">mrp.eco</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position = "inside">
                <button
                    type="object"
                    name="action_view_purchase"
                    class="oe_stat_button"
                    invisible="purchase_count == 0"
                    icon="fa-list"
                >
                    <field name="purchase_count" widget="statinfo" string="Purchases" />
                </button>
            </xpath>
            <xpath expr="//button[@name='reject']" position="before">
                <button string="Create RFQ" name="open_purchase_creation_wizard" type="object" class="oe_highlight" data-hotkey="q" title="Create a New RFQ" invisible="not product_tmpl_id.purchase_ok" />
            </xpath>
        </field>
    </record>

</odoo>
