<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ol_mrp_sale_price_rollup</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="35" />
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mrp_reception_report']" position="after">
                <setting id="allowed_kit_component_cost" help="Include Kit Components in Price Roll.">
                    <field name="allowed_kit_component_cost" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
