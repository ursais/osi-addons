<odoo>

    <record id="view_purchase_order_form_inherit_price_review" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.price.review</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_open_price_reviews"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="price_review_count == 0"
                    groups="stock.group_stock_user"
                >
                    <field name="price_review_count" string="Price Reviews" widget="statinfo" help="Shows open price reviews for products on the Purchase Order." />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
