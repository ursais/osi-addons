<odoo>
    <!-- ========================= -->
    <!-- Custom label paper format -->
    <!-- ========================= -->
    <record id="product_label_paperformat" model="report.paperformat">
        <field name="format">custom</field>
        <field name="margin_top" eval="1"/>
        <field name="margin_bottom" eval="1"/>
        <field name="name">Product Label Format (Landscape)</field>
        <field name="orientation">Portrait</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
        <field name="page_height">110</field>
        <field name="page_width">150</field>
    </record>

    <record id="product_label_paperformat_portrait" model="report.paperformat">
        <field name="format">custom</field>
        <field name="margin_top" eval="1"/>
        <field name="margin_bottom" eval="1"/>
        <field name="name">Product Label Format (Portrait)</field>
        <field name="orientation">Portrait</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
        <field name="page_height">150</field>
        <field name="page_width">110</field>
    </record>

    <!-- ============== -->
    <!-- Report actions -->
    <!-- ============== -->

    <!-- Labels from stock picking -->
    <record id="action_report_stock_picking_in_product_label" model="ir.actions.report">
        <field name="name">Product Labels</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'%s Picking Labels' % (object.name or '')</field>
        <field name="report_name">ol_product.report_picking_product_label</field>
        <field name="report_file">ol_product.report_picking_product_label</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="paperformat_id" ref="product_label_paperformat" />
    </record>

    <!-- Package Labels from product product -->
    <record id="action_report_product_warehouse_label" model="ir.actions.report">
        <field name="name">Product Package Label</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'%s Product Package Label' % (object.default_code or 'NO SKU')</field>
        <field name="report_name">ol_product.report_product_package_label</field>
        <field name="report_file">ol_product.report_product_package_label</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="paperformat_id" ref="product_label_paperformat" />
    </record>

    <!-- Shelf Labels from product product -->
    <record id="action_report_product_shelf_label_landscape" model="ir.actions.report">
        <field name="name">Product Shelf Label (Landscape)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'%s Product Shelf Label' % (object.default_code or 'NO SKU')</field>
        <field name="report_name">ol_product.report_product_shelf_label</field>
        <field name="report_file">ol_product.report_product_shelf_label</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="paperformat_id" ref="product_label_paperformat" />
    </record>
    <record id="action_report_product_shelf_label_portrait" model="ir.actions.report">
        <field name="name">Product Shelf Label (Portrait)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'%s Product Shelf Label' % (object.default_code or 'NO SKU')</field>
        <field name="report_name">ol_product.report_product_shelf_label_portrait</field>
        <field name="report_file">ol_product.report_product_shelf_label_portrait</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="paperformat_id" ref="product_label_paperformat_portrait" />
    </record>

    <!-- ========= -->
    <!-- Templates -->
    <!-- ========= -->

    <!-- Product labels from picking -->
    <template id="report_picking_product_label">
        <t t-foreach="docs" t-as="picking">
            <t t-set="purchase_order" t-value="picking.purchase_id" />
            <t t-foreach="picking.move_ids.product_id" t-as="product">
                <t t-call="ol_product.individual_product_label" />
            </t>
        </t>
    </template>

    <!-- Product package label -->
    <template id="report_product_package_label">
        <t t-foreach="docs" t-as="product">
            <t t-call="ol_product.individual_product_label" />
        </t>
    </template>

    <!-- Contents of product label -->
    <template id="individual_product_label">
        <t t-call="web.html_container">
            <div class="article">
                <div class="page">
                    <div class="content product-label">
                        <div class="product-header"><t t-esc="product.default_code"/></div>
                        <div class="supplier-code">
                            <t t-if="purchase_order">
                                <t t-esc="product.get_supplier_code(supplier=purchase_order.partner_id)"/>
                            </t>
                            <t t-else="">
                                <t t-esc="product.get_supplier_code()" />
                            </t>
                        </div>
                        <div class="divider-line"> </div>
                        <div class="spacemaker">
                            <div class="name"><t t-esc="product.name"/></div>
                            <t t-if="purchase_order">
                                <div class="po-num"><t t-esc="purchase_order.name"/></div>
                            </t>
                        </div>
                        <t t-if="purchase_order">
                            <div class="supplier"><t t-esc="purchase_order.partner_id.name"/></div>
                        </t>
                        <div class="location" />
                        <t t-if="not picking or not picking.blind_drop_ship">
                            <div class="logo">
                                <img src="/ol_product/static/img/onlogic_horizontal_black.png"/>
                            </div>
                        </t>
                        <div class="barcode">
                            <img t-if="product.get_label_barcode()" t-attf-src="data:image/gif;base64,{{product.get_label_barcode()}}" width="320"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Label for product shelf -->
    <template id="report_product_shelf_label_portrait">
        <t t-call="ol_product.report_product_shelf_label" />
    </template>

    <template id="report_product_shelf_label">
        <t t-foreach="docs" t-as="product">
            <t t-call="web.html_container">
                <div class="article">
                    <div class="page product-label">
                        <div class="content ol_flex ol_flex_just_cont_space_between padding-top-10">
                            <div class="barcode-box">
                                <div class="barcode">
                                    <img t-if="product.get_label_barcode()" t-attf-src="data:image/gif;base64,{{product.get_label_barcode()}}" width="300"/>
                                </div>
                            </div>
                        </div>
                        <div class="margin-top-20">
                            <div class="supplier-code">
                                <tag>SKU:</tag>
                                <t t-esc="product.default_code"/>
                            </div>
                            <div class="divider-line"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
