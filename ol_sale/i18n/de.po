#. module: ol_sale
#: model:mail.template,body_html:ol_sale.customer_shipment_email_template
msgid ""
"<!-- Variables -->\n"
"            <t t-set=\"sale_order\" t-value=\"object.with_context({'lang':object.sale_id.contact_ids and object.sale_id.contact_ids[0].partner_id.lang or object.sale_id.partner_id.lang or object.env.lang}).sale_id\"></t>\n"
"            <t t-set=\"shipping_email\" t-value=\"True\"></t>\n"
"            <t t-call=\"ol_templates.ol_email\">\n"
"                <!-- Variables -->\n"
"                <t t-set=\"title\" t-value=\"'Order ' + sale_order.name if sale_order else '' + ' Shipped!'\"></t>\n"
"                <t t-set=\"preheader_text\" t-value=\"'Your Order ' + sale_order.name if sale_order else '' + ' Shipped!'\"></t>\n"
"                <t t-set=\"include_newsletter_disclaimer\" t-value=\"False\"></t>\n"
"\n"
"                <!-- Body -->\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <span style=\"font-weight: 500; font-size: 20px; display: block;\">\n"
"                        <tag>Your shipment is on its way</tag>\n"
"                    </span>\n"
"                    <div style=\"font-size:16px; line-height:28px; margin-top:30px\">\n"
"                        <t t-esc=\"sale_order.partner_id.name\"></t>\n"
"                        ,\n"
"                    </div>\n"
"                    <p style=\"font-size: 16px; line-height: 28px; margin-top: 30px;\">\n"
"                        <tag>Your order has left the building! Although we were very sad to\n"
"                            see it go, we know you're excited for it\n"
"                            to arrive. You can track its progress here.\n"
"                        </tag>\n"
"                        <br>\n"
"                        <br>\n"
"                        <t t-call=\"ol_templates.here_are_your_order_details\">\n"
"                            <t t-set=\"order\" t-value=\"sale_order\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_billing_shipping_info\">\n"
"                    <t t-set=\"billing_address\" t-value=\"sale_order.partner_invoice_id\"></t>\n"
"                    <t t-set=\"shipping_address\" t-value=\"sale_order.partner_shipping_id\"></t>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_email_spacer\"></t>\n"
"                <t t-call=\"ol_templates.ol_delivery_info\">\n"
"                    <t t-set=\"delivery_method\" t-value=\"sale_order.carrier_id\"></t>\n"
"                    <t t-set=\"tracking_numbers\" t-value=\"object.mapped('carrier_tracking_ref')\"></t>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_email_spacer\"></t>\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <p style=\"font-size: 16px; line-height: 28px;\">\n"
"                        <t t-call=\"ol_templates.ol_contact_info\">\n"
"                            <t t-set=\"extra_text\">\n"
"                                Thank you for working with OnLogic!\n"
"                            </t>\n"
"                            <t t-set=\"company\" t-value=\"sale_order.company_id\"></t>\n"
"                        </t>\n"
"                        <br>\n"
"                        <br>\n"
"                    </p>\n"
"                </t>\n"
"            </t>\n"
"        "
msgstr ""
"<!-- Variables -->\n"
"            <t t-set=\"sale_order\" t-value=\"object.with_context({'lang':object.sale_id.contact_ids and object.sale_id.contact_ids[0].partner_id.lang or object.sale_id.partner_id.lang or object.env.lang}).sale_id\"></t>\n"
"            <t t-set=\"shipping_email\" t-value=\"True\"></t>\n"
"            <t t-call=\"ol_templates.ol_email\">\n"
"                <!-- Variables -->\n"
"                <t t-set=\"title\" t-value=\"'Bestellung ' + sale_order.name if sale_order else '' + ' Versendet!'\"></t>\n"
"                <t t-set=\"preheader_text\" t-value=\"'Ihre Bestellung ' + sale_order.name if sale_order else '' + ' Versendet!'\"></t>\n"
"                <t t-set=\"include_newsletter_disclaimer\" t-value=\"False\"></t>\n"
"\n"
"                <!-- Body -->\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <span style=\"font-weight: 500; font-size: 20px; display: block;\">\n"
"                        <tag>Ihre Sendung ist unterwegs</tag>\n"
"                    </span>\n"
"                    <div style=\"font-size:16px; line-height:28px; margin-top:30px\">\n"
"                        <t t-esc=\"sale_order.partner_id.name\"></t>\n"
"                        ,\n"
"                    </div>\n"
"                    <p style=\"font-size: 16px; line-height: 28px; margin-top: 30px;\">\n"
"                        <tag>Ihre Bestellung hat das Gebäude verlassen! Obwohl wir sehr traurig waren, dass\n"
"                            Sieh es dir an, wir wissen, dass du dich darauf freust.\n"
"                            anzukommen. Sie können den Fortschritt hier verfolgen.\n"
"                        </tag>\n"
"                        <br>\n"
"                        <br>\n"
"                        <t t-call=\"ol_templates.here_are_your_order_details\">\n"
"                            <t t-set=\"order\" t-value=\"sale_order\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_billing_shipping_info\">\n"
"                    <t t-set=\"billing_address\" t-value=\"sale_order.partner_invoice_id\"></t>\n"
"                    <t t-set=\"shipping_address\" t-value=\"sale_order.partner_shipping_id\"></t>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_email_spacer\"></t>\n"
"                <t t-call=\"ol_templates.ol_delivery_info\">\n"
"                    <t t-set=\"delivery_method\" t-value=\"sale_order.carrier_id\"></t>\n"
"                    <t t-set=\"tracking_numbers\" t-value=\"object.mapped('carrier_tracking_ref')\"></t>\n"
"                </t>\n"
"\n"
"                <t t-call=\"ol_templates.ol_email_spacer\"></t>\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <p style=\"font-size: 16px; line-height: 28px;\">\n"
"                        <t t-call=\"ol_templates.ol_contact_info\">\n"
"                            <t t-set=\"extra_text\">\n"
"                                Vielen Dank, dass Sie mit OnLogic zusammenarbeiten!\n"
"                            </t>\n"
"                            <t t-set=\"company\" t-value=\"sale_order.company_id\"></t>\n"
"                        </t>\n"
"                        <br>\n"
"                        <br>\n"
"                    </p>\n"
"                </t>\n"
"            </t>\n"
"        "

#. module: ol_sale
#: model:mail.template,body_html:ol_sale.email_template_sale_proforma
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <t t-set=\"doc_name\" t-value=\"'quotation' if object.state in ('draft', 'sent') else 'order'\"></t>\n"
"                    Hello,\n"
"                    <br><br>\n"
"                    Your\n"
"                    <t t-if=\"ctx.get('proforma')\">\n"
"                        Pro forma invoice for <t t-out=\"doc_name or ''\">quotation</t> <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">S00052</span>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (with reference: <t t-out=\"object.origin or ''\"></t> )\n"
"                        </t>\n"
"                        amounting in <span style=\"font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</span> is available.\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <t t-out=\"doc_name or ''\">quotation</t> <span style=\"font-weight: bold;\" t-out=\"object.name or ''\"></span>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (with reference: <t t-out=\"object.origin or ''\">S00052</t> )\n"
"                        </t>\n"
"                        amounting in <span style=\"font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</span> is ready for review.\n"
"                    </t>\n"
"                    <br><br>\n"
"                    Do not hesitate to contact us if you have any questions.\n"
"                    <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                        <br><br>\n"
"                        <t t-out=\"object.user_id.signature or ''\">--<br>Mitchell Admin</t>\n"
"                    </t>\n"
"                    <br><br>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <t t-set=\"doc_name\" t-value=\"'quotation' if object.state in ('draft', 'sent') else 'order'\"></t>\n"
"                    Hallo,\n"
"                    <br><br>\n"
"                    Dein\n"
"                    <t t-if=\"ctx.get('proforma')\">\n"
"                        Proforma-Rechnung für <t t-out=\"doc_name or ''\">quotation</t> <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">S00052</span>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (mit Bezug: <t t-out=\"object.origin or ''\"></t> )\n"
"                        </t>\n"
"                        beträgt in <span style=\"font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</span> ist verfügbar.\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <t t-out=\"doc_name or ''\">quotation</t> <span style=\"font-weight: bold;\" t-out=\"object.name or ''\"></span>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (mit Bezug: <t t-out=\"object.origin or ''\">S00052</t> )\n"
"                        </t>\n"
"                        beträgt in <span style=\"font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</span> ist bereit zur Überprüfung.\n"
"                    </t>\n"
"                    <br><br>\n"
"                    Zögern Sie nicht, uns zu kontaktieren, wenn Sie Fragen haben.\n"
"                    <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                        <br><br>\n"
"                        <t t-out=\"object.user_id.signature or ''\">--<br>Mitchell Admin</t>\n"
"                    </t>\n"
"                    <br><br>\n"
"                </p>\n"
"            </div>\n"
"        "

