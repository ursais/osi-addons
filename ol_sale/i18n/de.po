#. module: ol_sale
#: model:mail.template,body_html:ol_sale.invoice_created_email_template
msgid ""
"<t t-call=\"ol_templates.ol_email\">\n"
"                <!-- Variables -->\n"
"                <t t-set=\"sale_order\" t-value=\"object.with_context({'lang':object.contact_ids and object.contact_ids[0].lang or object.partner_id.lang or object.env.lang})\"></t>\n"
"                <t t-set=\"title\" t-value=\"'Invoice ready for Sale Order ' + sale_order.name\"></t>\n"
"                <t t-set=\"preheader_text\" t-value=\"'Invoice ready for Sale Order ' + sale_order.name\"></t>\n"
"                <t t-set=\"include_newsletter_disclaimer\" t-value=\"False\"></t>\n"
"                <t t-set=\"access_action\" t-value=\"sale_order.with_context(force_website=True)._get_access_action()\"></t>\n"
"                <t t-set=\"invoices\" t-value=\"object._context.get('email_template_data', {}).get('invoices')\"></t>\n"
"                <!-- Body -->\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <div style=\"font-weight: 500; font-size: 20px;\">\n"
"                        <tag>An Invoice was created for</tag>\n"
"                        <t t-esc=\"sale_order.name\"></t>\n"
"                        !\n"
"                    </div>\n"
"                    <p style=\"font-size: 16px; line-height: 28px; margin-top: 30px;\">\n"
"                        <tag>You can view the related documents via the links below</tag>\n"
"                        <center style=\"margin-top: 30px;\">\n"
"                            <ul>\n"
"                                <li style=\"text-align: left;\">\n"
"                                    Sale Order:\n"
"                                    <a t-att-href=\"sale_order._notify_get_action_link('view')\" style=\"font-weight: 500; color: #337ab7;\" class=\"o_default_snippet_text\">\n"
"                                        <t t-esc=\"sale_order.name\"></t>\n"
"                                    </a>\n"
"                                </li>\n"
"                                <li style=\"text-align: left;\">\n"
"                                    Invoice:\n"
"                                    <t t-foreach=\"invoices\" t-as=\"invoice\">\n"
"                                        <a t-att-href=\"invoice._notify_get_action_link('view')\" style=\"font-weight: 500; color: #337ab7;\" class=\"o_default_snippet_text\">\n"
"                                            <t t-esc=\"invoice.name\"></t>\n"
"                                        </a>\n"
"                                    </t>\n"
"                                </li>\n"
"                            </ul>\n"
"                        </center>\n"
"                        <br>\n"
"                        <tag>The OnLogic Team</tag>\n"
"                    </p>\n"
"                </t>\n"
"            </t>\n"
"        "
msgstr ""
"<t t-call=\"ol_templates.ol_email\">\n"
"                <!-- Variables -->\n"
"                <t t-set=\"sale_order\" t-value=\"object.with_context({'lang':object.contact_ids and object.contact_ids[0].lang or object.partner_id.lang or object.env.lang})\"></t>\n"
"                <t t-set=\"title\" t-value=\"'Rechnung bereit für Verkaufsauftrag ' + sale_order.name\"></t>\n"
"                <t t-set=\"preheader_text\" t-value=\"'Rechnung bereit für Verkaufsauftrag ' + sale_order.name\"></t>\n"
"                <t t-set=\"include_newsletter_disclaimer\" t-value=\"False\"></t>\n"
"                <t t-set=\"access_action\" t-value=\"sale_order.with_context(force_website=True)._get_access_action()\"></t>\n"
"                <t t-set=\"invoices\" t-value=\"object._context.get('email_template_data', {}).get('invoices')\"></t>\n"
"                <!-- Body -->\n"
"                <t t-call=\"ol_templates.ol_email_text_content\">\n"
"                    <div style=\"font-weight: 500; font-size: 20px;\">\n"
"                        <tag>Eine Rechnung wurde erstellt für</tag>\n"
"                        <t t-esc=\"sale_order.name\"></t>\n"
"                        !\n"
"                    </div>\n"
"                    <p style=\"font-size: 16px; line-height: 28px; margin-top: 30px;\">\n"
"                        <tag>Sie können die zugehörigen Dokumente über die untenstehenden Links einsehen.</tag>\n"
"                        <center style=\"margin-top: 30px;\">\n"
"                            <ul>\n"
"                                <li style=\"text-align: left;\">\n"
"                                    Auftragsbestätigung:\n"
"                                    <a t-att-href=\"sale_order._notify_get_action_link('view')\" style=\"font-weight: 500; color: #337ab7;\" class=\"o_default_snippet_text\">\n"
"                                        <t t-esc=\"sale_order.name\"></t>\n"
"                                    </a>\n"
"                                </li>\n"
"                                <li style=\"text-align: left;\">\n"
"                                    Rechnung:\n"
"                                    <t t-foreach=\"invoices\" t-as=\"invoice\">\n"
"                                        <a t-att-href=\"invoice._notify_get_action_link('view')\" style=\"font-weight: 500; color: #337ab7;\" class=\"o_default_snippet_text\">\n"
"                                            <t t-esc=\"invoice.name\"></t>\n"
"                                        </a>\n"
"                                    </t>\n"
"                                </li>\n"
"                            </ul>\n"
"                        </center>\n"
"                        <br>\n"
"                        <tag>The OnLogic Team</tag>\n"
"                    </p>\n"
"                </t>\n"
"            </t>\n"
"        "

