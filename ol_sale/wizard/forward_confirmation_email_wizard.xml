<odoo>

    <record model="ir.ui.view" id="view_forward_confirmation_email_wizard">
        <field name="name">forward.confirmation.email.wizard.form</field>
        <field name="model">forward.confirmation.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Forward Confirmation Email">
                <p>
                    You can forward the original Sale Order confirmation email via this
                    form.
                    You can add an additional comments that will be included into the
                    email.
                </p>
                <group name="sales_order_grp">
                    <field name="order_id" readonly="True" />
                </group>
                <group name="sales_manager_text_grp" string="Additional comments">
                    <field name="text_intro" readonly="False" />
                </group>
                <group name="recipients_grp" string="Recipients">
                    <field name="recipients" readonly="False" required="True" widget="email" />
                </group>
                <footer>
                    <button name="forward_confirmation_email" string="Send" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_forward_confirmation_email_wizard" model="ir.actions.act_window">
        <field name="name">Forward Confirmation Email</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">forward.confirmation.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ol_sale.view_forward_confirmation_email_wizard" />
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
