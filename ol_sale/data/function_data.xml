<odoo>

	<!-- Set no update on stock email template to allow change -->
	<function name="write" model="ir.model.data">
	    <function name="search" model="ir.model.data">
	        <value eval="[('module', '=', 'stock'), ('name', '=', 'mail_template_data_delivery_confirmation')]" />
	    </function>
    	<value eval="{'noupdate': False}" />
	</function>

	<!-- Update partner_to on stock template to include contact_ids -->
	<record id="stock.mail_template_data_delivery_confirmation" model="mail.template">
		<field name="partner_to">{{ object.sale_id and object.sale_id.contact_ids.ids or object.partner_id.email and object.partner_id.id or object.partner_id.parent_id.id }}</field>
	</record>

	<!-- Set no update on stock email template back -->
	<function name="write" model="ir.model.data">
	    <function name="search" model="ir.model.data">
	        <value eval="[('module', '=', 'stock'), ('name', '=', 'mail_template_data_delivery_confirmation')]" />
	    </function>
    	<value eval="{'noupdate': True}" />
	</function>

</odoo>
