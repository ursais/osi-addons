<odoo>

    <template id="click_to_buy_email_template">
        <t t-call="ol_templates.ol_email">
            <!-- Variables -->
            <t t-set="title" t-value="'Quotation ' + sale_order.name"/>
            <t t-set="preheader_text" t-value="'Quotation and link for  Order ' + sale_order.name + ' attached'"/>
            <t t-set="include_newsletter_disclaimer" t-value="False"/>
            <!-- Body -->
            <t t-call="ol_templates.ol_email_text_content">
                <span style="font-weight: 500; font-size: 20px; display: block;">
                    <tag>Your quote is ready for review</tag>!
                </span>
                <div style="font-size:16px; line-height:28px; margin-top:30px">
                    <t t-esc="sale_order.partner_id.name" />
                    ,
                </div>
                <p style="font-size: 16px; line-height: 28px; margin-top: 30px;">
                    <tag>Thank you for your quote request. You can view the details of your configuration in the attached PDF or by clicking the button below, where you can also finalize your order online</tag>
                    <center style="margin-top: 30px;">
                        <a t-att-href="sale_order.access_url" style="background-color: #337ab7; padding: 15px 30px; text-decoration: none; color: #fff; border-radius: 3px; font-size: 16px;" class="o_default_snippet_text">
                            <tag>Review and Place Order</tag>
                        </a>
                    </center>
                    <br/>
                    <tag>The OnLogic Team</tag>
                </p>
            </t>
        </t>
    </template>

    <template id="order_click_to_buy_email_template_master">
        <t t-set="sale_order" t-value="object.with_context({'lang':object.partner_id.lang or object.env.lang})" />
        <t t-call="ol_sale.click_to_buy_email_template" t-lang="sale_order.partner_id.lang or object.env.lang"/>
    </template>

    <record id="order_click_to_buy_email_template" model="mail.template">
        <field name="name">OnLogic Click To Buy Email</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="auto_delete" eval="False"/>
        <field name="email_from" >{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.contact_ids and object.contact_ids.ids or object.partner_id.id }}</field>
        <field name="subject">Your Quote {{object.name}} is Ready for Review</field>
        <field name="report_template_ids" eval="[(4, ref('ol_sale.action_sale_order_quote_report'))]"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
            <t t-set="sale_order" t-value="object.with_context({'lang':object.partner_id.lang or object.env.lang})" />
            <t t-call="ol_sale.order_click_to_buy_email_template_master" t-lang="sale_order.partner_id.lang or object.env.lang" />
        </field>
    </record>

</odoo>
