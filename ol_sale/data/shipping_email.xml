<odoo>

    <record id="customer_shipment_email_template" model="mail.template">
        <field name="name">OnLogic Customer Shipment Email</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="email_from" >{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.sale_id.contact_ids and object.sale_id.contact_ids.ids or object.partner_id.id }}</field>
        <field name="subject">Your Order {{ object.sale_id.name or 'n/a' }} Has Shipped</field>
        <field name="body_html" type="html">
            <!-- Variables -->
            <t t-set="sale_order" t-value="object.with_context({'lang':object.sale_id.contact_ids and object.sale_id.contact_ids[0].partner_id.lang or object.sale_id.partner_id.lang or object.env.lang}).sale_id" />
            <t t-set="shipping_email" t-value="True" />
            <t t-call="ol_templates.ol_email">
                <!-- Variables -->
                <t t-set="title" t-value="'Order ' + sale_order.name if sale_order else '' + ' Shipped!'" />
                <t t-set="preheader_text" t-value="'Your Order ' + sale_order.name if sale_order else '' + ' Shipped!'" />
                <t t-set="include_newsletter_disclaimer" t-value="False" />

                <!-- Body -->
                <t t-call="ol_templates.ol_email_text_content">
                    <span
                        style="font-weight: 500; font-size: 20px; display: block;">
                        <tag>Your shipment is on its way</tag>
                    </span>
                    <div style="font-size:16px; line-height:28px; margin-top:30px">
                        <t t-esc="sale_order.partner_id.name" />
                        ,
                    </div>
                    <p style="font-size: 16px; line-height: 28px; margin-top: 30px;">
                        <tag>Your order has left the building! Although we were very sad to
                            see it go, we know you're excited for it
                            to arrive. You can track its progress here.
                        </tag>
                        <br />
                        <br />
                        <t t-call="ol_templates.here_are_your_order_details">
                            <t t-set="order" t-value="sale_order" />
                        </t>
                    </p>
                </t>

                <t t-call="ol_templates.ol_billing_shipping_info">
                    <t t-set="billing_address" t-value="sale_order.partner_invoice_id" />
                    <t t-set="shipping_address" t-value="sale_order.partner_shipping_id" />
                </t>

                <t t-call="ol_templates.ol_email_spacer" />
                <t t-call="ol_templates.ol_delivery_info">
                    <t t-set="delivery_method" t-value="sale_order.carrier_id" />
                    <t t-set="tracking_numbers" t-value="object.mapped('carrier_tracking_ref')"/>
                </t>

                <t t-call="ol_templates.ol_email_spacer" />
                <t t-call="ol_templates.ol_email_text_content">
                    <p style="font-size: 16px; line-height: 28px;">
                        <t t-call="ol_templates.ol_contact_info">
                            <t t-set="extra_text">
                                Thank you for working with OnLogic!
                            </t>
                            <t t-set="company" t-value="sale_order.company_id" />
                        </t>
                        <br />
                        <br />
                    </p>
                </t>
            </t>
        </field>
        <field name="lang">{{ object.sale_id.contact_ids and object.sale_id.contact_ids[0].partner_id.lang or object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

</odoo>
