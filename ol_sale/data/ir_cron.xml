<odoo noupdate="1">

    <!-- Send shipping emails -->
    <record id="ir_cron_send_shipment_inc_action" model="ir.cron">
        <field name="name">[US] Send Shipment Emails</field>
        <field name="user_id" search="[('login','=','inc')]"/>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="code">model.send_customer_emails()</field>
        <field name="state">code</field>
        <field name="interval_number">24</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="nextcall" eval="'2018-01-02 00:00:00'"/> <!-- 7pm EST -->
    </record>
