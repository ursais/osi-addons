<odoo>

    <template id="budgetary_quote_email_template">
        <t t-call="ol_templates.ol_email">
            <!-- Variables -->
            <t t-set="title" t-value="'Quotation ' + sale_order.name if sale_order else '' + ' Ready for Review'"/>
            <t t-set="preheader_text"  t-value="'Quotation for Order ' + sale_order.name if sale_order else '' + ' Ready for Review'"/>
            <t t-set="include_newsletter_disclaimer" t-value="False"/>

            <!-- Body -->
            <t t-call="ol_templates.ol_email_text_content">
                <span style="font-weight: 500; font-size: 20px;">
                    <tag>Your quote is ready for review!</tag>
                </span>
                <div style="font-size:16px; line-height:28px; margin-top:30px"><t t-esc="sale_order.partner_id.name"/>,
                </div>
                <p style="font-size: 16px; line-height: 28px; margin-top: 30px;">
                    <tag>Thank you for your quote request. In the attached PDF we've provided a few hardware
                      options for you to review. We're excited to hear which option you choose!
                    </tag>
                    <br/>
                    <br/>
                    <tag>If you’d like further adjustments made to any of our proposed solutions just let us know.</tag>
                </p>
            </t>

            <t t-call="ol_templates.ol_email_text_content">
                <p style="font-size: 16px; line-height: 28px;">
                    <t t-call="ol_templates.ol_contact_info">
                        <t t-set="contact_intro_text">You can contact us at</t>
                        <t t-set="company" t-value="sale_order.company_id"/>
                    </t>
                </p>
            </t>
        </t>
    </template>

    <template id="budgetary_quote_email_template_master">
        <t t-set="sale_order" t-value="object.with_context({'lang':object.partner_id.lang})"/>
        <t t-call="ol_sale.budgetary_quote_email_template" t-lang="object.partner_id.lang"/>
    </template>

    <record id="budgetary_quote_template" model="mail.template">
        <field name="name">OnLogic Budgetary Quote Email</field>
        <field name="model_id" search="[('model', '=', 'sale.order')]"/>
        <field name="auto_delete" eval="False"/>
        <field name="email_from">${object.company_id.order_sender_email}</field>
        <field name="email_to">${object.partner_id.email|safe}</field>
        <field name="subject">Your Quote {{ object.name }} is Ready for Review </field>
        <field name="report_template_ids" eval="[(4, ref('ol_sale.action_sale_order_quote_report'))]"/>
        <field name="lang">${object.partner_id.lang}</field>
        <field name="body_html" type="html">
            <t t-set="sale_order" t-value="object.with_context({'lang':object.partner_id.lang or object.env.lang})" />
            <t t-call="ol_sale.budgetary_quote_email_template_master" t-lang="sale_order.partner_id.lang or object.env.lang" />
        </field>
    </record>

</odoo>
