<odoo>

    <record id="excep_component_outof_stock" model="exception.rule">
        <field name="name">Component Out of Stock</field>
        <field name="description">Component Out of Stock and backorders are not allowed.</field>
        <field name="sequence">50</field>
        <field name="model">sale.order</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">failed = self._check_component_out_of_stock()</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_so_bank_tranfer_payment" model="exception.rule">
        <field name="name">Awaiting Bank Transfer Payment</field>
        <field name="description">The sale order has payment method as Bank Tranfer and Payment Status is not Full Paid.</field>
        <field name="sequence">55</field>
        <field name="model">sale.order</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("sale_payment_method_id.name", "=", 'Bank Transfer'), ('invoice_status', '!=', 'full paid')]</field>
    </record>

</odoo>
