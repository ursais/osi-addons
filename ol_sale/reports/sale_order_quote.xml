<odoo>

    <!-- Remove oob report actions as we will have custom reports -->
    <function model="ir.actions.report"
        name="unlink_action"
        eval="[[ref('sale.action_report_saleorder'), ref('sale.action_report_pro_forma_invoice'), ref('sale_pdf_quote_builder.action_report_saleorder_raw')]]"
    />

    <!-- Report Action -->
    <record id="action_sale_order_quote_report" model="ir.actions.report">
        <field name="name">Quote</field>
        <field name="print_report_name">'Quote %s' % (object.name)</field>
        <field name="model">sale.order</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ol_sale.report_sale_order_quote</field>
        <field name="report_file">ol_sale.report_sale_order_quote</field>
        <field name="attachment">'Quote_%s.pdf' % (object.name)</field>
        <field name="paperformat_xmlid_base">ol_templates.ol_report_paper_format</field>
    </record>

    <!-- Main template -->
    <template id="report_sale_order_quote">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Find the correct language-->
                <t t-set="language" t-value="doc.partner_id.lang"/>
                <t t-set="sale_order" t-value="doc.with_context(lang=language)"/>
                <!-- Call the template document with the language set -->
                <t t-call="ol_sale.report_sale_order_quote_document" t-lang="language"/>
            </t>
        </t>
    </template>

    <template id="report_sale_order_quote_document">
        <t t-call="ol_templates.external_layout">
            <!-- Set the name and title of the Report -->
            <t t-if="sale_order.type_id.name == 'Budgetary'">
                <t t-set="report_title">Budgetary Quote</t>
            </t>
            <t t-else="">
                <t t-set="report_title">Quote</t>
            </t>
            <!--Set template variables-->
            <t t-set="title" t-value="'Quote'"/>
            <t t-set="budgetary_quote" t-value="sale_order.type_id.name == 'Budgetary'"/>
            <t t-set="account_manager" t-value="sale_order.account_manager_id and sale_order.account_manager_id or sale_order.user_id"/>
            <t t-set="partner_invoice_id" t-value="sale_order.partner_invoice_id"/>
            <t t-set="customer_company_name" t-value="sale_order.partner_id.company_name or sale_order.partner_id.commercial_company_name"/>
            <t t-set="currency" t-value="sale_order.currency_id"/>
            <t t-set="company" t-value="sale_order.company_id"/>
            <t t-set="state" t-value="sale_order.state"/>
            <t t-set="product_lines" t-value="onlogic_data[sale_order.id]['product_lines']"/>
            <t t-set="shipping_lines" t-value="onlogic_data[sale_order.id]['shipping_lines']"/>
            <t t-set="product_subtotal_amount" t-value="onlogic_data[sale_order.id]['product_subtotal_amount']"/>
            <t t-set="shipping_subtotal_amount" t-value="onlogic_data[sale_order.id]['shipping_subtotal_amount']"/>
            <t t-set="has_active_holds" t-value="sale_order.has_active_holds"/>

            <!--The first main information block-->
            <div class="ol_report_info_row ol_flex">

                <!--Basic Invoice information-->
                <div class="ol_report_info_row_col info">

                    <div class="ol_report_info_row_col_title ol_flex">
                        <div class="key">
                            <t t-esc="report_title" t-options='{"widget": "cap_formatter", "case":"title"}'/>
                        </div>
                        <div class="value">
                            <t t-esc="sale_order.name"/>
                        </div>
                    </div>

                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <strong>
                                <tag>Quote Date</tag>
                            </strong>
                        </div>
                        <div class="value">
                            <strong>
                                <t t-esc="sale_order.date_order" t-options='{"widget": "date_formatter"}'/>
                            </strong>
                        </div>
                    </div>

                    <div class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <strong>
                                <tag>Quote Expiration</tag>
                            </strong>
                        </div>
                        <div class="value">
                            <strong>
                                <t t-esc="sale_order.validity_date" t-options='{"widget": "date_formatter"}'/>
                            </strong>
                        </div>
                    </div>

                    <div t-if="sale_order.client_order_ref" class="ol_report_info_row_col_line ol_flex">
                        <div class="key">
                            <strong>
                                <tag>Your Reference</tag>
                            </strong>
                        </div>
                        <div class="value">
                            <strong>
                                <t t-esc="sale_order.client_order_ref"/>
                            </strong>
                        </div>
                    </div>

                    <div t-if="account_manager" class="ol_account_manager_cont ol_margin_top_20">
                        <div class="account_manager_title ol_margin_bottom_5">
                            <tag>Account Manager</tag>
                        </div>
                        <div class="account_manager_data_cont ol_flex">
                            <div class="ol_account_manager_pic">
                                <t t-if="account_manager.image_128">
                                    <img t-if="account_manager.image_128" t-attf-src="data:image;base64,{{account_manager.image_128}}"/>
                                </t>
                                <t t-else="">
                                    <img t-if="company.placeholder_image_profile_picture" t-attf-src="data:image;base64,{{company.placeholder_image_profile_picture}}"/>
                                </t>
                            </div>
                            <div class="ol_account_manager_info">
                                <div class="ol_account_manager_name">
                                    <span t-esc="account_manager.name"/>
                                </div>
                                <div t-if="account_manager.phone" class="ol_account_manager_phone">
                                    <span class="ol-email-icon">
                                        <img t-if="company.placeholder_image_phone_icon" t-attf-src="data:image;base64,{{company.placeholder_image_phone_icon}}"/>
                                    </span>
                                    <span t-esc="account_manager.phone"/>
                                </div>
                                <div t-if="account_manager.email" class="ol_account_manager_email">
                                    <span class="ol-email-icon email">
                                        <img t-if="company.placeholder_image_email_icon" t-attf-src="data:image;base64,{{company.placeholder_image_email_icon}}"/>
                                    </span>
                                    <span t-esc="account_manager.email"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!--Billing related information-->
                <div class="ol_report_info_row_col billing">
                    <t t-call="ol_templates.address">
                        <t t-set="text">Bill To</t>
                        <t t-set="address" t-value="partner_invoice_id"/>
                    </t>
                </div>

                <!--Shipping related information-->
                <div class="ol_report_info_row_col shipping">
                    <t t-call="ol_templates.address">
                        <t t-set="show_vat_id" t-value="True"/>
                        <t t-set="text">Ship To</t> 
                        <t t-set="address" t-value="sale_order.partner_shipping_id"/>
                    </t>
                </div>

            </div>

            <!--Product list-->
            <t t-call="ol_templates.report_products">
                <t t-set="products_title">
                    Hardware Solution
                </t>
            </t>

            <t t-if="has_active_holds">
                <div class="ol_watermark">
                  <tag>FOR INTERNAL USE ONLY</tag>
                </div>
            </t>

            <!--Shipping list-->
            <t t-if="shipping_lines">
                <t t-call="ol_templates.report_shipping_method">
                    <t t-set="products_title">
                        Shipping Method
                    </t>
                </t>
            </t>

            <!--Order noted and totals-->
            <t t-call="ol_templates.report_notes_and_totals"/>
            <t t-call="ol_templates.quote_closing_text"/>
        </t>
    </template>

</odoo>
