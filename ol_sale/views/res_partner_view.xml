<odoo>

	<record id="view_partner_form_inherit_ol_sale" model="ir.ui.view">
        <field name="name">view.partner.form.inherit.ol.sale</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="account_manager_id" />
            </xpath>
            <field name="property_payment_term_id" position='before'>
                <field name="sale_order_tag_ids" widget="many2many_tags" />
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_delivery_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                >
                    <field name="delivery_order_count" widget="statinfo" string="Delivery Orders" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
