<odoo>

    <record id="mrp_production_batch_form_view_inherit_ol_sale" model="ir.ui.view">
        <field name="name">mrp.production.batch.form.view.inherit.ol.sale</field>
        <field name="model">mrp.production.batch</field>
        <field name="inherit_id" ref="mrp_batch.mrp_production_batch_form_view"/>
        <field name="arch" type="xml">
            <field name="date_start" position="before">
                <field name="ops_build_date"/>
            </field>
            <field name="earliest_start" position="after">
                <field name="estimated_ship_date"/>
                <field name="allocation_date"/>
            </field>
            <field name="earliest_start" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="date_start" position="attributes">
                <attribute name="string">Customer Request Date</attribute>
                <attribute name="groups">ol_base.role_operations_res_groups</attribute>
            </field>

            <field name="sale_tag_ids" position="after">
                <field name="ops_sequence"/>
            </field>

            <field name="total_revenue" position="after">
                <field name="sales_person_id"/>
                <field name="account_manager_id"/>
                <field name="date_confirm"/>
            </field>

        </field>
    </record>

    <record id="mrp_production_batch_tree_view_inherit_ol_sale" model="ir.ui.view">
        <field name="name">mrp.production.batch.tree.view.inherit.ol.sale</field>
        <field name="model">mrp.production.batch</field>
        <field name="inherit_id" ref="mrp_batch.mrp_production_batch_tree_view"/>
        <field name="arch" type="xml">
            <field name="date_start" position="attributes">
                <attribute name="string">Customer Request Date</attribute>
            </field>
            <field name="sale_tag_ids" position="after">
                <field name="ops_build_date"/>
                <field name="ops_sequence"/>
                <field name="estimated_ship_date"/>
                <field name="allocation_date"/>
                <field name="sales_person_id"/>
                <field name="account_manager_id"/>
            </field>

        </field>
    </record>

</odoo>
