<odoo>

    <record id="sale_subscription_order_view_form_inherit_ol_sale" model="ir.ui.view">
        <field name="name">sale.subscription.order.form.inherit.ol.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='notes']/field[@name='internal_note_display']" position="after">
                <field name="mrp_note" nolabel="1" placeholder="MRP Note"/>
            </xpath>
        </field>
    </record>

</odoo>
