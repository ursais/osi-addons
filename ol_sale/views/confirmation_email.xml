<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ol_sale_confirmation" model="ir.ui.view">
        <field name="name">ol_sale.confirmation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="ol_base.view_order_form" />
        <field name="arch" type="xml">
            <field name="locked" position="after">
                <field name="to_send_confirmation_email" invisible="1" />
            </field>
            <xpath expr="//button[@name='action_view_invoice']" position="before">
                <button
                    type="object"
                    name="toggle_confirmation_email"
                    class="oe_stat_button"
                    icon="fa-envelope">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text" invisible="not to_send_confirmation_email">Send</span>
                        <span class="o_stat_text" invisible="to_send_confirmation_email">Don't Send</span>
                        <span class="o_stat text">Conf. Email</span>
                    </div>
                </button>
            </xpath>
            <button id="send_by_email" position="after">
                <button
                    name="action_open_forward_confirmation_email_wizard"
                    string="Forward Confirmation Email"
                    type="object"
                    invisible="state == 'draft'" />
            </button>
        </field>
    </record>

</odoo>
