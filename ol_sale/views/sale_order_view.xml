<odoo>

    <!-- Sale Order form view -->
    <record id="view_order_form_inherit_ol_sale" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <!-- Add guest checkout field and text -->
            <sheet position="before">
                <field name="is_guest_checkout" invisible="1"/>
                <div
                    class="alert alert-info"
                    role="alert"
                    style="margin-bottom:0px; text-align: center"
                    invisible="not is_guest_checkout"
                >
                    <p><strong >Guest Checkout</strong></p>
                </div>
            </sheet>

            <!-- Added  Original Shipment Commitment Date -->
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <div class="o_td_label">
                    <label for="create_date" string="Creation Date"/>
                </div>
                <field name="create_date" nolabel="1" readonly="1"/>

                <div class="o_td_label">
                    <label for="date_confirm" string="Confirm Date"/>
                </div>
                <field name="date_confirm" nolabel="1" readonly="1"/>
            </xpath>

            <!-- Added  Original Customer Request Date and Delivery Date -->
            <xpath expr="//group[@name='order_details']//field[@name='has_active_pricelist']" position="before">
                <div class="o_td_label" invisible = "state in ['draft','sent','cancel']">
                    <label for="original_commitment_date" string="Original Customer Request Date" />
                </div>
                <field name="original_commitment_date" nolabel="1"  readonly="1" invisible = "state in ['draft','sent','cancel']"/>

                <div class="o_td_label">
                   <label for="commitment_date" string="Customer Request Date"/>
                </div>
                <div class="o_row">
                    <field name="commitment_date" />
                    <span class="text-muted" invisible="state == 'sale'">Expected: <field name="expected_date" class="oe_inline" widget="date" invisible="state == 'sale'"/></span>
                </div>
                <field name="effective_date" invisible="not effective_date"/>
                <!-- first_estimate_date -->
                <div class="o_td_label" invisible = "state in ['draft','sent','cancel']">
                    <label for="first_estimate_date" string="First Estimate Date"/>
                </div>
                <field name="first_estimate_date" nolabel="1" readonly="1" invisible = "state in ['draft','sent','cancel']"/>

                <div class="o_td_label" invisible = "state in ['draft','sent','cancel']">
                    <label for="current_estimate_ship_date" string="Current Estimate ship Date"/>
                </div>
                <field name="current_estimate_ship_date" nolabel="1" readonly="1" invisible = "state in ['draft','sent','cancel']"/>
            </xpath>

            <!-- Added Product State in Sale order line after name field in tree view -->
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']//tree//field[@name='product_template_id']" position="after">
                <field name="product_state_id" optional="show"/>
            </xpath>

            <!-- Add Account Manager after Sales Person -->
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="after">
                <field name="account_manager_id" />
                <field name="end_user" />
                <field name="integrator" />
                <field name="has_active_holds" invisible="1"/>
            </xpath>

            <!-- Filter out configurable and company not allowed products in the product_template_id field -->
            <xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('config_ok', '=', False), '|', ('company_ids_display', '=', False), ('company_ids_display', 'in', company_id)]</attribute>
            </xpath>

            <!-- Filter not company allowed products in the product__id field -->
            <xpath expr="//tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), '|', ('company_ids_display', '=', False), ('company_ids_display', 'in', company_id)]</attribute>
            </xpath>
            <field name="partner_shipping_id" position="after">
                <field name="contact_ids" domain="[('parent_id','=',partner_id)]" widget="many2many_tags" required="1"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="domain">
                    [ ('type', 'in', ['contact', 'other']), '&amp;',
                    '|', ('is_company', '=', True), ('parent_id', '=', False),
                    '|', ('company_id', '=', False), ('company_id', 'parent_of', [company_id])]
                </attribute>
            </field>

            <!-- Add context to invoice/delivery addresses -->
            <field name="partner_invoice_id" position="attributes">
                <attribute name="context">{'default_parent_id': partner_id, 'default_type':'invoice', 'show_address': 1, 'show_vat': 1, 'partner_address_details': 1}</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="context">{'default_parent_id': partner_id, 'default_type':'delivery', 'show_address': 1, 'show_vat': 1, 'partner_address_details': 1}</attribute>
            </field>

            <!-- Move client_order_ref up in header along with shipping_ref -->
            <field name="client_order_ref" position="replace" />
            <field name="sale_order_template_id" position="after">
                <field name="client_order_ref" />
                <field name="shipping_ref" />
            </field>
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']//tree//field[@name='company_id']" position="after">
                <button
                    name="action_duplicate_line"
                    type="object"
                    class="oe_link"
                    icon="fa-copy"
                    title="Copy"
                    invisible="not product_id or locked"
                />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_mo_internal_picking" invisible="mo_tranfer_count == 0" type="object" icon="fa-bars">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="mo_tranfer_count" /></span>
                        <span class="o_stat_text">MO Transfers</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>


    <record id="view_order_tree_inherit_ol_sale" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="original_request_date" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="sale_order_line_search_ol_sales" model="ir.ui.view">
        <field name="name">sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter" />
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="bom_id" string="Components" filter_domain="[('bom_id.bom_line_ids.product_id.default_code', 'ilike', self)]"/>
            </field>
        </field>
    </record>

</odoo>
