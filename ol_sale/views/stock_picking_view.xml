<odoo>
	
	<record id="view_picking_form_inherit_ol_sale" model="ir.ui.view">
        <field name="name">picking.form.view.inherit.ol.sale</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
        	<xpath expr="//page[@name='note']/field[@name='note']" position="after">
                <field name="delivery_note" string="Delivery Note" placeholder="Delivery Note"/>
            </xpath>
        </field>
    </record>

</odoo>
