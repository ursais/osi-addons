<odoo>

    <record id="view_sale_order_inspection_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.inspection.wizard.form</field>
        <field name="model">sale.order.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Order Inspections">
                <group>
                    <field name="order_inspection_ids" widget="many2many_tags" />
                    <field name="reason" />
                </group>
                <footer>
                    <button string="Confirm" type="object" name="confirm" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_inspection_wiz" model="ir.actions.act_window">
        <field name="name">Manage Order Inspections</field>
        <field name="res_model">sale.order.inspection.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ol_sale_order_inspection.view_sale_order_inspection_wizard_form" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">form</field>
    </record>

</odoo>