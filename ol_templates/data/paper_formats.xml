<odoo>

    <!-- ==============-->
    <!-- PAPER FORMATS -->
    <!-- ==============-->

    <!--
    These are assigned to the report via `ol_templates/models/report.py`
    as it was not possible to load them conditionally via XML
    and we didn't want to overwrite the default company paper formats
    -->
    <record id="ol_report_paper_format_us" model="report.paperformat">
        <field name="name">LS Report paper format US</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">16</field>
        <field name="margin_right">16</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>

    <record id="ol_report_paper_format_eu" model="report.paperformat">
        <field name="name">LS Report paper format EU</field>
