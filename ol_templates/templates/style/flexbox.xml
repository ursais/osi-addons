<odoo>

    <template id="ol_flex_style">
        <!--Our current wkhtmltopdf version 12.4 can't handle flexbox directly-->
        <!--this is the CSS that mimics the same behaviour with webkit-box-->
        <style>
          .ol_flex{
            display: -webkit-box;
            display: -webkit-flex;
            display: flex;
          }

          .ol_flex_just_cont_space_between{
            -webkit-box-pack: justify;
            -webkit-justify-content: space-between;
            justify-content: space-between;
          }

          .ol_flex_just_cont_flex_end{
            -webkit-box-pack: end;
            -webkit-justify-content: flex-end;
            justify-content: flex-end;
          }

          .ol_flex_reverse{
            box-orient: vertical; /* As specified */
            -moz-box-orient: vertical; /* Mozilla */
            -webkit-box-orient: vertical;
            box-pack: end; /* As specified */
            -moz-box-pack: end; /* Mozilla */
            -webkit-box-pack: end; /* WebKit */
            flex-direction: column;
            justify-content: flex-end;
          }
        </style>
    </template>

</odoo>