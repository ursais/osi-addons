<odoo>

    <template id="report_header_style">
        <!-- We need to define specific styles for each section header/page/footer -->
        <t t-call="ol_templates.ol_flex_style"/>
        <style>
          .report_header_cont {
            margin-bottom: 30px;
            width: 100%;
          }

          .ol_header_logo{
            margin-top: 90px;
          }

          .ol_header_logo img{
            max-width: 221px;
          }

          .ol_header_report_info {
            color: #595A5C;
            font-weight: 600;
            line-height: 1em;
            margin-top: 115px;
            width: 50%;
          }

          .ol_header_report_info.blind_drop_ship{
          text-align: initial;
          }

          .ol_customer_name {
          font-size: 14px;
          }

          .ol_blind_drop_title{
          font-size: 1.5em;
          color: #007bff;
          }

          .ol_rush_order_title{
          font-size: 1.5em;
          color: #a94442;
          }

          .ol_document_type {
            font-size: 34px;
            line-height: 1em;
          }
        </style>
    </template>

</odoo>
