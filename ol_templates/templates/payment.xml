<odoo>

    <template id="payment">
        <div class="ol_block_title" t-esc="block_title"/>
        <t t-if="payment_method">
            <div class="ol_block_data" t-esc="payment_method.name"/>
        </t>
        <t t-else="">
            <div class="ol_block_data" t-esc="payment_terms"/>
        </t>

    </template>

    <template id="payment_terms">
        <div class="ol_block_title" t-esc="block_title"/>
        <div class="ol_block_data" t-esc="payment_terms.name"/>
    </template>


</odoo>
