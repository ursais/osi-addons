<odoo>

    <!--Notes and totals-->
    <template id="report_notes_and_totals_refund_invoice">
        <div class="ol_report_notes_and_totals ol_flex ol_flex_just_cont_flex_end">
            <div class="ol_report_totals">
                <t t-if="not budgetary_quote">
                    <div t-if="out_invoice_amount" class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                        <div class="subtotal-text">Subtotal</div>
                        <div class="subtotal-amount" t-esc="invoice.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': currency or invoice.env.company.currency_id}"/>
                    </div>
                    <div t-if="out_refund_amount" class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                        <div class="subtotal-text">Credit</div>
                        <div class="subtotal-amount" t-esc="invoice.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': currency or invoice.env.company.currency_id}"/>
                    </div>
                    <div class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                        <div class="subtotal-text"><tag>Tax</tag></div>
                        <div class="subtotal-amount" t-esc="invoice.amount_tax" t-options="{'widget': 'monetary', 'display_currency': currency or invoice.env.company.currency_id}"/>
                    </div>
                    <div class="subtotal-row ol_flex ol_flex_just_cont_space_between grand-total">
                        <div class="subtotal-text">Total</div>
                        <div class="subtotal-amount" t-esc="sum_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </div>

                    <t t-if="invoice and invoice.move_type in ['out_invoice', 'in_invoice']">
                      <div class="subtotal-row ol_flex ol_flex_just_cont_space_between ol_residual">
                          <div class="subtotal-text">Payment Received</div>
                          <div class="subtotal-amount" t-esc="payment_received_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                      </div>

                      <div class="subtotal-row ol_flex ol_flex_just_cont_space_between grand-total">
                          <div class="subtotal-text">Balance Due</div>
                          <div class="subtotal-amount" t-esc="residual_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                      </div>
                  </t>
                </t>
            </div>
        </div>
        <div class="ol_report_order_notes_full">
            <div class="order-notes">
                <div>
                    <strong>
                        <tag>RMA Notes</tag>
                    </strong>
                </div>
                <t t-if="invoice.company_id.short_name == 'eu' and sale_order and sale_order.partner_shipping_id and sale_order.partner_shipping_id.vat">
                    <t t-call="ol_templates.eu_tax_exempt"/>
                </t>
                <div style="overflow-wrap: break-word;">
                    <p t-esc="sale_order.note"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
