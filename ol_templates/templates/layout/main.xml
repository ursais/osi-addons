<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="external_layout">

    <t t-call="web.html_container">

      <!--The main html container this where te head / page(body) / footer goes-->
      <!--Odoo strips out and formats the head/footer content so it is best to not include anything in those-->

      <t t-if="not o" t-set="o" t-value="doc"/>

      <t t-if="not company">
        <!-- Multicompany -->
        <t t-if="company_id">
          <t t-set="company" t-value="company_id"/>
        </t>
        <t t-elif="o and 'company_id' in o">
          <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-else="else">
          <t t-set="company" t-value="res_company"/>
        </t>
      </t>

      <t t-if="not customer_header">
        <!--We make it possible to overwrite the header from the report templates-->
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">

          <!--This gets stripped out and reformatted by Odoo in `report/models/report.py get_pdf()`-->
          <t t-call="ol_templates.report_header_style"/>

          <t t-call="ol_templates.report_header"/>
        </div>
      </t>

      <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-call="ol_templates.report_page_style"/>
        <!--The "body" of the report layout-->
        <!--This part is more or less untouched by Odoo's formatting-->
        <!--This where other templates can hook into-->
        <t t-raw="0"/>
      </div>

      <t t-if="not custom_footer">
        <!--We make it possible to overwrite the footer from the report templates-->
        <div class="footer">

          <!--This gets stripped out and reformatted by Odoo in `report/models/report.py get_pdf()`-->
          <t t-call="ol_templates.report_footer_style"/>

          <t t-if="not blind_drop_ship" t-call="ol_templates.report_footer"/>

        </div>
      </t>

    </t>
  </template>

</odoo>
