<odoo>

    <!--The footer of the report-->
    <template id="report_footer">
        <div class="ol_report_footer">
            <div class="ol_report_footer_company_row ol_flex ol_flex_just_cont_space_between">
                <div class="ol_report_footer_company_info">
                    <t t-out="company.external_display_name"/>
                    <br/>
                    <t t-out="company.street"/>
                    <br/>
                    <t t-out="company.city"/>,
                    <t t-out="company.state_id.code"/>
                    <t t-out="company.zip"/>
                    <br/>
                    <t t-out="company.country_id.code"/>
                </div>
                <div class="ol_report_footer_company_contact">
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Phone</tag>
                        </div>
                        <div class="value">
                            <t t-out="company.phone" t-options='{"widget": "phone_formatter", "company_id": company}'/>
                        </div>
                    </div>
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Email</tag>
                        </div>
                        <div class="value">
                            <t t-out="company.email"/>
                        </div>
                    </div>
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Web</tag>
                        </div>
                        <div class="value">
                            <t t-out="company.website" t-options='{"widget": "url_formatter"}'/>
                        </div>
                    </div>
                </div>
                <div t-if="company.short_name == 'us' and invoice" class="ol_report_footer_payment_info">
                    <strong>
                        Electronic Payment Info
                    </strong>
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Account #</tag>
                        </div>
                        <div class="value">
                            767551010
                        </div>
                    </div>
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Routing #</tag>
                        </div>
                        <div class="value">
                            021000021
                        </div>
                    </div>
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>Bank SWIFT</tag>
                        </div>
                        <div class="value">
                            CHASUS33
                        </div>
                    </div>
                </div>
                <div t-if="company.short_name == 'eu'" class="ol_report_footer_payment_info">
                    <div class="ol_report_footer_info_row ol_flex">
                        <div class="key">
                            <tag>VAT</tag>
                        </div>
                        <div class="value">
                            <t t-out="company.vat"/>
                        </div>
                    </div>
                </div>
                <div class="ol_report_footer_terms">
                      <div>
                          <strong>Terms and Conditions</strong>
                      </div>
                      <div>
                          <a t-attf-href="{{company.terms_and_conditions_url}}" target="_blank" style="color: #6BCACE !important;">
                              <t t-out="company.terms_and_conditions_url" t-options='{"widget": "url_formatter"}'/>
                          </a>
                      </div>
                </div>
                <div class="ol_report_footer_page_info">
                    <ul class="list-inline">
                        <li>
                            <span class="page"/>
                        </li>
                        <li>of</li>
                        <li>
                            <span class="topage"/>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </template>

</odoo>
