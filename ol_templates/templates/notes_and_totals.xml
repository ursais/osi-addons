<odoo>

    <!--Notes and totals-->
    <template id="report_notes_and_totals">
        <div class="ol_report_notes_and_totals ol_flex ol_flex_just_cont_flex_end">
            <div class="ol_report_totals">
                <t t-if="not budgetary_quote">
                    <div class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                        <div class="subtotal-text">Subtotal</div>
                        <div class="subtotal-amount" t-esc="product_subtotal_amount" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id or sale_order.env.company.currency_id}"/>
                    </div>
                  <div class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                      <div class="subtotal-text">Shipping &amp; Handling</div>
                      <div class="subtotal-amount" t-esc="shipping_subtotal_amount" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id or sale_order.env.company.currency_id}"/>
                  </div>
                  <div class="subtotal-row ol_flex ol_flex_just_cont_space_between">
                      <div class="subtotal-text"><tag>Tax</tag></div>
                      <t t-if="invoice">
                          <div class="subtotal-amount" t-esc="invoice.amount_tax" t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id or invoice.env.company.currency_id}"/>
                      </t>
                      <t t-else="">
                          <div class="subtotal-amount" t-esc="sale_order.amount_tax" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id or sale_order.env.company.currency_id}"/>
                      </t>
                  </div>
                  <div class="subtotal-row ol_flex ol_flex_just_cont_space_between grand-total">
                      <div class="subtotal-text">Total</div>
                      <t t-if="invoice">
                          <div class="subtotal-amount" t-esc="invoice.amount_total" t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id or invoice.env.company.currency_id}"/>
                      </t>
                      <t t-else="">
                          <div class="subtotal-amount" t-esc="sale_order.amount_total" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id or sale_order.env.company.currency_id}"/>
                      </t>
                  </div>

                  <t t-if="invoice and invoice.move_type in ['out_invoice', 'in_invoice']">
                      <div class="subtotal-row ol_flex ol_flex_just_cont_space_between ol_residual">
                          <div class="subtotal-text">Payment Received</div>
                          <div class="subtotal-amount" t-esc="invoice.amount_total - invoice.amount_residual" t-options="{'widget': 'monetary', 'display_currency': currency or invoice.env.company.currency_id}"/>
                      </div>

                      <div class="subtotal-row ol_flex ol_flex_just_cont_space_between grand-total">
                          <div class="subtotal-text">Balance Due</div>
                          <div class="subtotal-amount" t-esc="invoice.amount_residual" t-options="{'widget': 'monetary', 'display_currency': currency or invoice.env.company.currency_id}"/>
                      </div>
                  </t>

                </t>
            </div>
            <t t-if="invoice and invoice.amount_residual == 0">
                <div style="position: absolute;
                padding-top: 50px;
                padding-left: 25px;
                opacity: 0.20;
                z-index: 1000;
                font-weight: 600;
                font-size: 150px;
                color: red;">
                    <tag>PAID</tag>
                </div>
            </t>
        </div>
        <div class="ol_report_order_notes_full">
            <div class="order-notes">
                <div>
                    <strong>
                        <tag>Order Notes</tag>
                    </strong>
                </div>
                <t t-if="sale_order.company_id.short_name == 'eu' and sale_order.partner_shipping_id and sale_order.partner_shipping_id.vat">
                    <t t-call="ol_templates.eu_tax_exempt"/>
                </t>
                <div style="overflow-wrap: break-word;">
                    <p t-esc="sale_order.note"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
