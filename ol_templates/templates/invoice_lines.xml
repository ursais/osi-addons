<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--The main products section in the report-->
  <template id="report_invoiceable_lines">
    <div class="ls_report_products_row">
      <div class="ls_products_header ls_flex ls_flex_just_cont_space_between">
        <div class="ls_products_title ls_flex ls_flex_reverse">
          <!--The title-->
          <t t-esc="products_title"/>
        </div>
        <div class="ls_products_list_header ls_flex ls_flex_just_cont_space_between">
          <div class="ls_products_list_header_item">
            <!--The info table header-->
            <tag>Price</tag>
          </div>
          <div class="ls_products_list_header_item">
            <tag>QTY</tag>
          </div>
          <div class="ls_products_list_header_item">
            <tag>Subtotal</tag>
          </div>
        </div>
      </div>

      <!--The list of products-->
      <t t-call="ol_templates.report_invoice_lines"/>

    </div>
  </template>

  <!--Products list template-->
  <template id="report_invoice_lines">
    <div class="ls_product_lines">
      <t t-foreach="invoice_lines" t-as="invoice_line">
        <div class="ls_products_line">

          <!--Product: image, name, sku, data-->
          <div class="ls_flex">
            <div class="ls_product_data ls_refund ls_invoice_lines">
              <div class="ls_products_info_cont ls_flex ls_flex_just_cont_space_between">

                <div class="product_info_name ls_refund ls_invoice_lines">
                  <div class="ls_product_name">
                    <t t-esc="invoice_line.name"/>
                  </div>
                </div>

                <div class="ls_products_line_data ls_flex ls_flex_just_cont_space_between ls_refund">
                  <div class="ls_products_line_data_item product_price">
                    <t t-esc="invoice_line.price_unit" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                  </div>
                  <div class="ls_products_line_data_item product_qty">
                    <t t-esc="invoice_line.quantity" t-options="{'widget': 'integer'}"/>
                  </div>
                  <div class="ls_products_line_data_item product_subtotal">
                    <t t-esc="invoice_line.price_subtotal" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                  </div>
                </div>

              </div>

            </div>
          </div>

        </div>
      </t>
    </div>
  </template>

  <!-- Additional Invoice Lines for the RMA PDF-->
  <template id="refund_additional_invoice_line">
    <div class="ls_report_products_row">
      <div class="ls_products_header ls_flex ls_flex_just_cont_space_between">
        <div class="ls_products_title ls_flex ls_flex_reverse ls_additional_invoice_line">
          <!--The title-->
          <t t-esc="products_title"/>
        </div>
        <div class="ls_products_list_header ls_flex ls_flex_just_cont_space_between ls_additional_invoice_line">
          <div class="ls_products_list_header_item">
            <!--The info table header-->
            <tag>Price</tag>
          </div>
          <div class="ls_products_list_header_item">
            <tag>QTY</tag>
          </div>
          <div class="ls_products_list_header_item">
            <tag>Subtotal</tag>
          </div>
        </div>
      </div>

      <!--The list of products-->
      <t t-call="ol_templates.refund_additional_invoice_lines"/>

    </div>
  </template>

  <!--Products list template-->
  <template id="refund_additional_invoice_lines">
    <div class="ls_product_lines">
      <t t-foreach="invoice_lines" t-as="invoice_line">
        <div class="ls_products_line">

          <!--Product: image, name, sku, data-->
          <div class="ls_flex">
            <div class="ls_product_data ls_refund ls_invoice_lines">
              <div class="ls_products_info_cont ls_flex ls_flex_just_cont_space_between">

                <div class="product_info_name ls_rma">
                  <div class="ls_product_name">
                    <t t-esc="invoice_line.product_id.name"/>
                  </div>
                  <div class="ls_product_default_code" t-esc="invoice_line.product_id.product_tmpl_id.default_code"/>
                </div>

                <div class="ls_products_line_data ls_flex ls_flex_just_cont_space_between ls_refund">
                  <div class="ls_products_line_data_item product_price">
                    <t t-esc="invoice_line.price_unit" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                  </div>
                  <div class="ls_products_line_data_item product_qty">
                    <t t-esc="invoice_line.quantity" t-options="{'widget': 'integer'}"/>
                  </div>
                  <div class="ls_products_line_data_item product_subtotal">
                    <t t-esc="invoice_line.price_subtotal" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                  </div>
                </div>

              </div>

            </div>
          </div>

        </div>
      </t>
    </div>
  </template>

</odoo>