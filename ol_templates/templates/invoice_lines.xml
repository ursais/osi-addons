<odoo>

    <!--The main products section in the report-->
    <template id="report_invoiceable_lines">
        <div class="ol_report_products_row">
            <div class="ol_products_header ol_flex ol_flex_just_cont_space_between">
                <div class="ol_products_title ol_flex ol_flex_reverse">
                    <!--The title-->
                    <t t-esc="products_title"/>
                </div>
                <div class="ol_products_list_header ol_flex ol_flex_just_cont_space_between">
                    <div class="ol_products_list_header_item">
                        <!--The info table header-->
                        <tag>Price</tag>
                    </div>
                    <div class="ol_products_list_header_item">
                        <tag>QTY</tag>
                    </div>
                    <div class="ol_products_list_header_item">
                        <tag>Subtotal</tag>
                    </div>
                </div>
            </div>
            <!--The list of products-->
            <t t-call="ol_templates.report_invoice_lines"/>
        </div>
    </template>

    <!--Products list template-->
    <template id="report_invoice_lines">
        <div class="ol_product_lines">
            <t t-foreach="invoice_lines" t-as="invoice_line">
                <div class="ol_products_line">
                    <!--Product: image, name, sku, data-->
                    <div class="ol_flex">
                        <div class="ol_product_data ol_refund ol_invoice_lines">
                            <div class="ol_products_info_cont ol_flex ol_flex_just_cont_space_between">
                                <div class="product_info_name ol_refund ol_invoice_lines">
                                    <div class="ol_product_name">
                                        <t t-esc="invoice_line.name"/>
                                    </div>
                                </div>
                                <div class="ol_products_line_data ol_flex ol_flex_just_cont_space_between ol_refund">
                                    <div class="ol_products_line_data_item product_price">
                                        <t t-esc="invoice_line.price_unit" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                                    </div>
                                    <div class="ol_products_line_data_item product_qty">
                                        <t t-esc="invoice_line.quantity" t-options="{'widget': 'integer'}"/>
                                    </div>
                                    <div class="ol_products_line_data_item product_subtotal">
                                        <t t-esc="invoice_line.price_subtotal" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <!-- Additional Invoice Lines for the RMA PDF-->
    <template id="refund_additional_invoice_line">
        <div class="ol_report_products_row">
            <div class="ol_products_header ol_flex ol_flex_just_cont_space_between">
                <div class="ol_products_title ol_flex ol_flex_reverse ol_additional_invoice_line">
                    <!--The title-->
                    <t t-esc="products_title"/>
                </div>
                <div class="ol_products_list_header ol_flex ol_flex_just_cont_space_between ol_additional_invoice_line">
                    <div class="ol_products_list_header_item">
                        <!--The info table header-->
                        <tag>Price</tag>
                    </div>
                    <div class="ol_products_list_header_item">
                        <tag>QTY</tag>
                    </div>
                    <div class="ol_products_list_header_item">
                        <tag>Subtotal</tag>
                    </div>
                </div>
            </div>
            <!--The list of products-->
            <t t-call="ol_templates.refund_additional_invoice_lines"/>
        </div>
    </template>

    <!--Products list template-->
    <template id="refund_additional_invoice_lines">
        <div class="ol_product_lines">
            <t t-foreach="invoice_lines" t-as="invoice_line">
                <div class="ol_products_line">
                    <!--Product: image, name, sku, data-->
                    <div class="ol_flex">
                        <div class="ol_product_data ol_refund ol_invoice_lines">
                            <div class="ol_products_info_cont ol_flex ol_flex_just_cont_space_between">
                                <div class="product_info_name">
                                    <div class="ol_product_name">
                                        <t t-esc="invoice_line.product_id.name"/>
                                    </div>
                                    <div class="ol_product_default_code" t-esc="invoice_line.product_id.product_tmpl_id.default_code"/>
                                </div>
                                <div class="ol_products_line_data ol_flex ol_flex_just_cont_space_between ol_refund">
                                    <div class="ol_products_line_data_item product_price">
                                        <t t-esc="invoice_line.price_unit" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                                    </div>
                                    <div class="ol_products_line_data_item product_qty">
                                        <t t-esc="invoice_line.quantity" t-options="{'widget': 'integer'}"/>
                                    </div>
                                    <div class="ol_products_line_data_item product_subtotal">
                                        <t t-esc="invoice_line.price_subtotal" t-options="{'widget': 'monetary_currency_dependent', 'display_currency': invoice.currency_id}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

</odoo>