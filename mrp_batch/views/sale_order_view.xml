<odoo>

    <record id="sale_order_form_view_inherit_mrp_batch" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit.mrp.batch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_mrp_production_batch" invisible="mrp_batch_count == 0" type="object" icon="fa-bars">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="mrp_batch_count" /></span>
                        <span class="o_stat_text">Batch</span>
                    </div>
                </button>
            </xpath>
            <button name="action_unlock" position="replace">
                <field name="is_mrp_warning" invisible="1" />
                <button
                    name="action_unlock"
                    type="object"
                    string="Unlock"
                    invisible="not locked or is_mrp_warning"
                    groups="sales_team.group_sale_manager"
                />
                <button
                    name="action_unlock"
                    type="object"
                    string="Unlock"
                    invisible="not locked or not is_mrp_warning"
                    groups="sales_team.group_sale_manager"
                    confirm="Wording: There are planned or in progress manufacturing orders. Please confirm that any changes won't affect those orders. Continue?"
                />
            </button>
        </field>
    </record>

</odoo>