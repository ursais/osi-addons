<odoo>

    <record id="mrp_production_batch_tag_tree_view" model="ir.ui.view">
        <field name="name">mrp.production.batch.tag.tree.view</field>
        <field name="model">mrp.production.batch.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <record id="mrp_production_batch_tag_form_view" model="ir.ui.view">
        <field name="name">mrp.production.batch.tag.form.view</field>
        <field name="model">mrp.production.batch.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_production_batch_tag" model="ir.actions.act_window">
        <field name="name">MRP Batch Tag</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.production.batch.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
        id="menu_mrp_production_batch_tag"
        name="Manufacturing Batch Tag"
        parent="mrp.menu_mrp_configuration"
        action="action_mrp_production_batch_tag"
        sequence="40"
    />

</odoo>
