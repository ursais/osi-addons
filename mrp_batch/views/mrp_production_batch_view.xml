<odoo>

    <record id="mrp_production_batch_tree_view" model="ir.ui.view">
		<field name="name">mrp.production.batch.tree.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <header>
                    <button name="action_confirm" type="object" string='Confirm' class="oe_highlight" />
                    <button name="button_plan" type="object" string='Plan' class="oe_highlight" />
                    <button name="action_assign" type="object" string='Check availability'/>
                    <button name="action_unreserve" type="object" string='Unreserve'/>
                    <button name="action_cancel" type="object" string="Cancel" />
                </header>
                <field name="currency_id" column_invisible="1" />
                <field name="mrp_batch_schedule_id" widget="Many2one" optional="hide" />
                <button name="action_open_mrp_batch_schedule" type="object" icon="fa-calendar" title="Open Schedule" invisible="not mrp_batch_schedule_id" />
                <field name="date_start" widget="datetime" options="{'show_time': false}" optional="show" />
                <field name="workcenter_tag_id" optional="show" />
                <field name="name" optional="show" />
                <field name="partner_ids" widget="many2many_tags" optional="show" />
                <field name="product_tmpl_ids" widget="many2many_tags" optional="hide" />
                <field name="sale_order_ids" widget="many2many_tags" optional="show" />
                <field name="product_ids" widget="many2many_tags" optional="show" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show" />
                <field name="sale_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show" />
                <field name="earliest_start" widget="datetime" options="{'show_time': false}" optional="show" />
                <field name="date_deadline" widget="datetime" options="{'show_time': false}" optional="show" />
                <field name="components_availability_state" column_invisible="True" options='{"lazy": true}'/>
                <field name="components_availability" options="{'lazy': true}" invisible="state in ['done', 'cancel']" optional="show" decoration-success="reservation_state == 'assigned' or components_availability_state == 'available'" decoration-warning="reservation_state != 'assigned' and components_availability_state in ('expected', 'available')" decoration-danger="reservation_state != 'assigned' and components_availability_state in ('late', 'unavailable')"/>
                <field name="components_availability_details" options="{'lazy': true}" invisible="state in ['done', 'cancel']" optional="show" decoration-success="reservation_state == 'assigned' or components_availability_state == 'available'" decoration-warning="reservation_state != 'assigned' and components_availability_state in ('expected', 'available')" decoration-danger="reservation_state != 'assigned' and components_availability_state in ('late', 'unavailable')"/>
                <field name="reservation_state" optional="hide" decoration-danger="reservation_state == 'confirmed'" decoration-success="reservation_state == 'assigned'"/>
                <field name="total_revenue" widget="monetary" optional="hide" sum="Total" />
                <field name="total_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="total_build_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="total_test_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="total_other_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="total_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="total_build_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="total_test_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="total_other_duration" widget="float_time" optional="hide" sum="Total" />

                <field name="remaining_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="remaining_build_duration" widget="float_time" optional="show" sum="Total" />
                <field name="remaining_test_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="remaining_other_duration" widget="float_time" optional="hide" sum="Total" />

                <field name="avg_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_build_duration_expected" widget="float_time" optional="show" sum="Total" />
                <field name="avg_test_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_other_duration_expected" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_build_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_test_duration" widget="float_time" optional="hide" sum="Total" />
                <field name="avg_other_duration" widget="float_time" optional="hide" sum="Total" />

                <field name="qty_producing" optional="hide" sum="Total" />
                <field name="qty_produced" optional="hide" sum="Total" />
                <field name="qty_remaining" optional="show" sum="Total" />
                <field name="percent_complete" widget="percentage" optional="hide" />
                <field name="responsible_id" optional="hide" />
                <field name='is_outdated_bom' optional="hide" />
                <field name="exception_ids" widget="many2many_tags" optional="hide" />
                <field name="exceptions_summary" optional="show" />
                <field name="notes" optional="show" />
                <field name="state" decoration-success="state == 'done'" decoration-warning="state == 'progress'" decoration-info="state == 'confirm'" decoration-danger="state == 'hold'" decoration-muted="state in ('cancel', 'draft')" optional="show" widget="badge" class="text-dark" />
                <field name="company_id" optional="hide" />
                <field name="is_delayed" optional="hide" />
                <field name="is_planned" widget="boolean_toggle" readonly="1" optional="hide" />
            </tree>
        </field>
    </record>

	<record id="mrp_production_batch_form_view" model="ir.ui.view">
		<field name="name">mrp.production.batch.form.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_confirmed" invisible="1" />
                    <field name="reserve_visible" invisible="1" />
                    <field name="unreserve_visible" invisible="1" />
                    <field name="is_cancel" invisible="1" />
                    <field name="is_move_raw_ids" invisible="1" />
                    <field name="is_produce_all" invisible="1" />
                    <field name="is_planned" invisible="1" />
                    <field name="is_delayed" invisible="1" />
                    <field name="show_lock" invisible="1" />
                    <field name="is_locked" invisible="1" />
                    <field name="is_queuing" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field name='is_outdated_bom' invisible='1'/>
                    <field name="reservation_state" invisible='1' />
                    <button name="action_confirm" type="object" string='Confirm' invisible="is_confirmed" class="oe_highlight" />
                    <button name="button_plan" type="object" string='Plan' invisible="is_planned or state == 'done'" class="oe_highlight" />
                    <button name="action_done" type="object" string='Produce All' invisible="not is_move_raw_ids or state not in ['draft','confirm','progress']" class="oe_highlight" />
                    <button name="action_assign" type="object" invisible="not reserve_visible" string='Check availability'/>
                    <button name="button_unplan" type="object" string='Unplan' invisible="not is_planned" />
                    <button name="action_unreserve" type="object" invisible="not unreserve_visible" string='Unreserve'/>
                    <button name="action_lock_and_unlock" type="object" invisible="not show_lock or is_locked" string='Lock'/>
                    <button name="action_lock_and_unlock" type="object" invisible="not show_lock or not is_locked" string='Unlock'/>
                    <button name="action_cancel" type="object" invisible="not is_cancel" string='Cancel' confirm="Canceling the Batch will also cancel ALL the related Manufacturing Orders. Are you sure you want to continue?" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done" />
                </header>
            	<sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sales" />
                        </button>
                        <button name="action_view_mo_delivery" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Internal Tranfer" />
                        </button>
                        <button name="action_open_batch_transfers" type="object" string="Batch Transfers" icon="fa-truck" class="oe_stat_button" invisible="picking_batch_count == 0">
                            <field name="picking_batch_count" widget="statinfo" string="Batch Transfers"/>
                        </button>
                    </div>
                    <div class="alert alert-danger mb8" role="alert" invisible="not exception_ids">
                        IMPORTANT: There are manufacturing orders with exceptions.
                        <field name="exceptions_summary" />
                    </div>
                    <div class="oe_title">
                        <widget name="web_ribbon" title="DELAYED" bg_color="text-bg-danger" invisible="not is_delayed" />
                        <widget name="web_ribbon" title="QUEUING" bg_color="text-bg-info" invisible="not is_queuing" />
                        <h1 class="d-flex">
                              <field name="name" nolabel="1" readonly="1" />
                        </h1>
                    </div>
                    <div invisible="state not in ('progress', 'done')">
                        <field name="percent_complete" widget="percentage" />
                        <span> Complete</span>
                    </div>
                    <group>
                        <group>
                            <field name="workcenter_tag_id" />
                            <field name="mrp_batch_schedule_id" />
                            <field name="partner_ids" widget="many2many_tags" />
                            <label for="product_ids" name="product_ids_label"/>
                            <div class="o_row" name="upgrade bom_div">
                                <field name="product_ids" widget="many2many_tags"/>
                                <button
                                    name="action_update_bom"
                                    string="Update BoM"
                                    type="object"
                                    title="Note that another version of a BOM is available on one or more Manufacturing Orders. Clicking this will update all Draft/Confirmed MO's with a changed BoM."
                                    class="text-danger"
                                    invisible="not is_outdated_bom"
                                />
                            </div>
                            <field name="product_tmpl_ids" widget="many2many_tags" invisible="1" />
                            <field name="sale_order_ids" widget="many2many_tags" invisible="1" />
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" />
                            <field name="sale_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </group>
                        <group>
                            <field name="date_start" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" />
                            <field name="earliest_start" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" />
                            <field name="date_deadline" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" />
                            <field name="components_availability_state" invisible="1"/>
                            <field name="components_availability" invisible="state in ['done', 'cancel']" decoration-success="reservation_state == 'assigned' or components_availability_state == 'available'" decoration-warning="reservation_state != 'assigned' and components_availability_state in ('expected', 'available')" decoration-danger="reservation_state != 'assigned' and components_availability_state in ('late', 'unavailable')" />
                            <field name="components_availability_details" />
                            <field name="responsible_id" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" />
                            <field name="exception_ids" widget="many2many_tags" invisible="1" />
                            <field name="exceptions_summary" invisible="1" />
                            <field name="company_id" invisible="1" />
                        </group>
                        <group>
                            <label for="qty_producing" string="Quantity" />
                            <div class="o_row g-0 d-flex">
                                <div class="o_row flex-grow-0">
                                    <field name="qty_produced" class="text-start" />
                                    <span>/ </span>
                                </div>
                                <field name="qty_producing" class="oe_inline text-start" />
                            </div>
                            <field name="total_revenue" widget="monetary" />
                        </group>
                    </group>
                    <group>
                        <group name="expected_durations" string="Total/Remaining Expected Durations">
                            <label for="total_duration_expected" string="Total Duration" />
                            <div class="o_row g-0 d-flex">
                                <div class="o_row flex-grow-0">
                                    <field name="total_duration_expected" class="text-start" widget="float_time" help="Total expected duration of all MO's / Remaining duration." />
                                    <span>/ </span>
                                </div>
                                <field name="remaining_duration" class="oe_inline text-start" widget="float_time" />
                            </div>
                            <label for="total_build_duration_expected" string="Build Duration" />
                            <div class="o_row g-0 d-flex">
                                <div class="o_row flex-grow-0">
                                    <field name="total_build_duration_expected" class="text-start" widget="float_time" help="Total expected build duration of all MO's / Remaining build duration." />
                                    <span>/ </span>
                                </div>
                                <field name="remaining_build_duration" class="oe_inline text-start" widget="float_time" />
                            </div>
                            <label for="total_test_duration_expected" string="Test Duration" />
                            <div class="o_row g-0 d-flex">
                                <div class="o_row flex-grow-0">
                                    <field name="total_test_duration_expected" class="text-start" widget="float_time" help="Total expected test duration of all MO's / Remaining test duration." />
                                    <span>/ </span>
                                </div>
                                <field name="remaining_test_duration" class="oe_inline text-start" widget="float_time" />
                            </div>
                            <label for="total_other_duration_expected" string="Other Duration" />
                            <div class="o_row g-0 d-flex">
                                <div class="o_row flex-grow-0">
                                    <field name="total_other_duration_expected" class="text-start" widget="float_time" help="Total expected other duration of all MO's / Remaining other duration." />
                                    <span>/ </span>
                                </div>
                                <field name="remaining_other_duration" class="oe_inline text-start" widget="float_time" />
                            </div>
                        </group>
                        <group name="unit_durations" string="Per Unit Durations">
                            <field name="avg_duration_expected" widget="float_time" string="Duration" help="Average expected duration for each unit." />
                            <field name="avg_build_duration_expected" widget="float_time" string="Build Duration" help="Average build expected duration for each unit." />
                            <field name="avg_test_duration_expected" widget="float_time" string="Test Duration" help="Average test expected duration for each unit." />
                            <field name="avg_other_duration_expected" widget="float_time" string="Other Duration" help="Average other expected duration for each unit." />
                        </group>
                    </group>
                    <notebook>
                        <page name="mrp_batch" string="Manufacturing Orders">
                            <button name="action_open_add_to_batch_wizard" type="object" string="Add MO(s)" icon="fa-link" invisible="is_locked" context="{'default_batch_id': id}" />
                            <field name="production_ids" readonly="state not in ('draft', 'confirm', 'cancel') or is_locked" options="{'no_create': True, 'no_create_edit': True}">
                                <tree string="Manufacturing Orders" delete="0" create="0">
                                    <field name="product_id" optional="show" />
                                    <field name="company_id" optional="hide" />
                                    <field name="name" string="Manufacturing Orders" optional="show" />
                                    <field name="product_qty" string="Quantity" optional="show" />
                                    <field name="lot_producing_id" optional="hide" />
                                    <field name="state" decoration-success="state == 'done'" decoration-warning="state == 'confirm'" decoration-info="state == 'confirmed'" decoration-danger="state == 'cancel'" decoration-muted="state == 'draft'" widget="badge" class="text-dark" optional="show" />
                                    <field name="date_start" string="Scheduled Date" optional="show" />
                                    <field name="date_finished" string="End Date" optional="show" />
                                    <field name="components_availability_state" column_invisible="True" options="{&quot;lazy&quot;: true}" />
                                    <field name="components_availability" options="{'lazy': true}" invisible="state in ['done', 'cancel']" optional="show" decoration-success="reservation_state == 'assigned' or components_availability_state == 'available'" decoration-warning="reservation_state != 'assigned' and components_availability_state in ('expected', 'available')" decoration-danger="reservation_state != 'assigned' and components_availability_state in ('late', 'unavailable')"/>
                                    <field name="reservation_state" optional="hide" decoration-danger="reservation_state == 'confirmed'" decoration-success="reservation_state == 'assigned'" />
                                    <field name="sale_order_id" string="Sale Order" optional="show" />
                                    <field name="duration_expected" widget="float_time" optional="show" />
                                    <field name="duration" widget="float_time" optional="show" />
                                    <field name='is_outdated_bom' optional="hide" />
                                    <field name="main_exception_id" optional="hide" />
                                    <field name="exceptions_summary" optional="show" />
                                    <field name="unreserve_visible" optional="hide" />
                                    <field name="reserve_visible" optional="hide" />
                                    <field name="is_planned" optional="hide" />
                                    <button name="action_remove_batch" type="object" icon="fa-close" column_invisible="parent.state in ('done', 'cancel') or parent.is_locked" title="Close"/>
                                </tree>
                            </field>
                        </page>
                        <page name="durations" string="Real Durations">
                            <group>
                                <field name="total_duration" widget="float_time" />
                                <field name="total_build_duration" widget="float_time" />
                                <field name="total_test_duration" widget="float_time" />
                                <field name="total_other_duration" widget="float_time" />
                            </group>
                        </page>
                    </notebook>
                    <div class="o_row" style="margin-top:10px;">
                        <field name="notes" placeholder="Batch Notes"  class="w-25" />
                    </div>
            	</sheet>
                <div class='oe_chatter'>
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </form>
        </field>
    </record>

    <record id="mrp_production_batch_gantt_view" model="ir.ui.view">
        <field name="name">mrp.production.batch.gantt.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="arch" type="xml">
            <gantt
                date_start="date_start"
                date_stop="date_end"
                string="Manufacturing Batch Gantt"
                default_group_by="workcenter_tag_id"
                progress="percent_complete"
                create="0"
                delete="0"
                color="state"
                progress_bar="batch_id"
                total_row="True"
                precision="{'day': 'hour:full', 'week': 'day:full', 'month': 'day:full', 'year': 'day:full'}"
                form_view_id="%(mrp_production_batch_form_view)d"
            >
                <field name="date_start" />
                <field name="date_finished" />
                <field name="date_deadline" />
                <field name="state" />
                <field name="workcenter_tag_id" />
                <field name="partner_ids" />
                <field name="product_tmpl_ids" />
                <field name="sale_order_ids" />
                <field name="total_revenue" />
                <field name="total_duration_expected" />
                <field name="total_build_duration_expected" />
                <field name="total_test_duration_expected" />
                <field name="total_other_duration_expected" />
                <field name="total_duration" />
                <field name="total_build_duration" />
                <field name="total_test_duration" />
                <field name="total_other_duration" />
                <field name="percent_complete" />
            </gantt>
        </field>
    </record>

    <record id="mrp_production_batch_calendar_view" model="ir.ui.view">
        <field name="name">mrp.production.batch.calendar.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="arch" type="xml">
            <calendar
                date_start="date_start"
                date_stop="date_finished"
                string="Manufacturing Batch Calendar"
                color="state"
                form_view_id="%(mrp_production_batch_form_view)d"
            >
                <field name="date_start" />
                <field name="date_finished" />
                <field name="state" />
                <field name="workcenter_tag_id" />
                <field name="partner_ids" />
                <field name="product_tmpl_ids" />
                <field name="sale_order_ids" />
                <field name="total_revenue" />
                <field name="percent_complete" />
            </calendar>
        </field>
    </record>

    <record id="mrp_production_batch_search_view" model="ir.ui.view">
        <field name="name">mrp.production.batch.search.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="tag_ids" />
                <field name="production_ids" />
                <field name="partner_ids" />
                <field name="responsible_id" />
                <field name="product_ids" />
                <field name="product_tmpl_ids" />
                <field name="sale_order_ids" />
                <field name="workcenter_tag_id" />
                <field name="date_deadline" invisible="1" />
                <filter string="To Do" name="todo" domain="[('state', 'in', ('draft', 'confirm', 'progress'))]" help="Batches which are in confirmed state."/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirm')]"/>
                <filter string="Planned" name="filter_planned" domain="[('is_planned', '=', True)]" groups="mrp.group_mrp_routings"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'progress')]"/>
                <filter string="Hold" name="filter_to_close" domain="[('state', '=', 'hold')]"/>
                <separator/>
                <filter string="Awaiting Components" name="waiting" domain="[('reservation_state', 'in', ('waiting', 'confirmed'))]"/>
                <filter string="Batch Ready" name="filter_ready" domain="[('reservation_state', '=', 'assigned')]"/>
                <separator/>
                <filter string="Late Components" name="late" domain="[('components_availability_state', '=', 'late')]"/>
                <separator/>
                <!-- Date Filters -->
                <filter string="Today" name="today" domain="[('date_start', '&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />
                <filter name="this_week_filter" string="This Week" domain="[
                    ('date_start', '>=', (datetime.datetime.combine(context_today() + relativedelta(weeks=-1, days=1, weekday=0), datetime.time(0,0,0)).to_utc()).strftime('%Y-%m-%d %H:%M:%S')),
                    ('date_start', '&lt;', (datetime.datetime.combine(context_today() + relativedelta(days=1, weekday=0), datetime.time(0,0,0)).to_utc()).strftime('%Y-%m-%d %H:%M:%S'))]" />
                <filter name="next_week_filter" string="Next Week" domain="[
                    ('date_start', '>=', (datetime.datetime.combine(context_today() + relativedelta(weeks=1, weekday=0), datetime.time(0,0,0)).to_utc()).strftime('%Y-%m-%d %H:%M:%S')),
                    ('date_start', '&lt;', (datetime.datetime.combine(context_today() + relativedelta(weeks=2, weekday=0), datetime.time(0,0,0)).to_utc()).strftime('%Y-%m-%d %H:%M:%S'))]" />
                <separator/>
                <filter name="past_due" string="Past Due" domain="[['date_start', '&lt;', context_today()]]" />
                <filter name="upcoming" string="Upcoming" domain="[['date_start', '&gt;', context_today()]]" />
                <separator/>
                <filter name="filter_date_start" string="Date" date="date_start"/>
                <filter name="filter_plan_date" invisible="1" string="Date: Last 365 Days" domain="[('date_start', '&gt;', (datetime.datetime.now() + relativedelta(days=-365)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="mrp_batch_schedule_id" string="Schedule" context="{'group_by': 'mrp_batch_schedule_id'}" />
                <filter name="workcenter_tag_id" string="Workcenter Tag" context="{'group_by': 'workcenter_tag_id'}" />
                <filter name="partner_ids" string="Customer" context="{'group_by': 'partner_ids'}" />
                <filter name="product_ids" string="Product" context="{'group_by': 'product_ids'}" />
                <filter name="reservation_state" string="Material Availability" domain="[]" context="{'group_by': 'reservation_state'}"/>
                <filter name="product_tmpl_ids" string="Product Templates" context="{'group_by': 'product_tmpl_ids'}" />
                <filter name="exception_ids" string="Exceptions" context="{'group_by': 'exception_ids'}" />
                <filter name="responsible_id" string="Employee" context="{'group_by': 'responsible_id'}" />
            </search>
        </field>
    </record>

     <record id="action_mrp_production_batch" model="ir.actions.act_window">
        <field name="name">MRP Batch</field>
