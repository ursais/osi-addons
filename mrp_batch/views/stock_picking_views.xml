<odoo>

    <record id="mrp_batch_view_picking_form_inherit_batch" model="ir.ui.view">
        <field name="name">stock.picking.form.mrp.batch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='batch_id']" position="after">
                <field name="mrp_batch_id" />
            </xpath>
        </field>
    </record>

    <record id="mrp_batch_view_picking_tree_inherit_batch" model="ir.ui.view">
        <field name="name">stock.picking.tree.mrp.batch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_picking_batch.vpicktree_inherit_stock_picking_batch"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='batch_id']" position="after">
                <field name="mrp_batch_id" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
