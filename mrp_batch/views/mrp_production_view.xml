<odoo>

    <record id="mrp_production_search_view_inherit_mrp_batch" model="ir.ui.view">
        <field name="name">mrp.production.search.view.inherit.mrp.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="mrp_batch_id"/>
                <separator/>
                <filter name="mrp_batch_id" context="{'group_by': 'mrp_batch_id'}"/>
            </field>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_mrp_batch" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.inherit.mrp.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_open_wizard" type="object" string='Add/Create Batch'/>
                <button name="action_remove_batch" type="object" string='Remove Batch'/>
            </header>
            <field name="product_qty" position="after">
                <field name="mrp_batch_id" readonly="mrp_batch_state in ('done','cancel','hold')" />
                <field name="mrp_batch_state" string="Batch State" />
            </field>
        </field>
    </record>

    <record id="mrp_production_form_view_inherit_mrp_batch" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.mrp.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="mrp_batch_id" readonly="mrp_batch_state in ('done','cancel','hold')" />
                <field name="mrp_batch_state" decoration-danger="mrp_batch_state == 'hold'" decoration-success="mrp_batch_state == 'confirm'" decoration-info="mrp_batch_state == 'done'"  decoration-muted="mrp_batch_state == 'cancel'" decoration-bf="1"/>
            </field>
        </field>
    </record>

</odoo>