<odoo noupdate="1">

    <record id="default_produce_delay" model="ir.config_parameter">
        <field name="key">mrp_batch.default_produce_delay</field>
        <field name="value">4</field>
    </record>

    <record id="default_days_to_prepare" model="ir.config_parameter">
        <field name="key">mrp_batch.default_days_to_prepare_mo</field>
        <field name="value">1</field>
    </record>

    <record id="default_batch_mode" model="ir.config_parameter">
        <field name="key">mrp_batch.batch_mode</field>
        <field name="value">single</field>
    </record>

    <record id="enable_delay_action_confirm" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_action_confirm</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_button_plan" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_button_plan</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_button_unplan" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_button_unplan</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_action_unreserve" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_action_unreserve</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_action_done" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_action_done</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_action_cancel" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_action_cancel</field>
        <field name="value">True</field>
    </record>

    <record id="default_enable_delay_component_availability" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_component_availability</field>
        <field name="value">True</field>
    </record>

            <record id="default_enable_delay_component_availability_details" model="ir.config_parameter">
        <field name="key">mrp_batch.enable_delay_component_availability_details</field>
        <field name="value">True</field>
    </record>

</odoo>
