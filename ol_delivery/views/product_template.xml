<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">ol_delivery.product_template_form_view</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="before">
        <field name="has_configurable_attributes" invisible="1" />
        <field name="is_kits" invisible="1" />
        <field name="lithium_shipping_hazard" />
      </field>
      <div name="weight" position="after">

        <label for="shipping_buffer" />
        <div class="o_row" name="shipping_buffer">
          <field name="shipping_buffer" class="oe_inline" />
          <div name="shipping_buffer_days" class="o_field_widget o_readonly_modifier o_field_char">
            <span>days</span>
          </div>
        </div>

      </div>
    </field>
  </record>

</odoo>