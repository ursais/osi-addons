<odoo>

    <record id="ol_warranty_view_repair_order_tree" model="ir.ui.view" >
        <field name="name">repair.order.tree.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="after" >
                <field name="lot_id" optional="hide" groups="stock.group_production_lot" />
                <field name="warranty_expiration_date" optional="hide" groups="stock.group_production_lot" />
            </field>
        </field>
    </record>

    <record id="ol_warranty_view_repair_order_form" model="ir.ui.view" >
        <field name="name">repair.order.form.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after" >
                <field name="warranty_expiration_date" invisible="not lot_id" groups="stock.group_production_lot" />
            </field>
        </field>
    </record>

</odoo>
