<odoo>

    <record id="view_order_form_inheirt_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@invisible='not locked']" position="attributes">
                <attribute name="class" add="so_lock_bubble" separator=" "></attribute>
            </xpath>
            <xpath expr="//header" position = "after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not credit_hold" groups="ol_credit_limit.group_credit_management_user">
                    <strong> CREDIT HOLD </strong>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="not remaining_credit_exceed" groups="ol_credit_limit.group_credit_management_user">
                    <strong> Order Exceeds Remaining Credit </strong>
                </div>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sale_reporting']" position="after">
                <group name="credit_management" string="Credit Management" groups="ol_credit_limit.group_credit_management_user">
                    <field  name="credit_hold"/>
                    <field  name="remaining_credit_exceed" invisible="1"/>
                    <field  name="uninvoiced_balance"/>
                    <field  name="override_credit_limit_hold"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_ol_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="credit_hold" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>