<odoo>

    <record id="mrp_production_form_view_inheirt_credit_limit" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position = "after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not credit_hold" groups="ol_credit_limit.group_credit_management_user">
                    <strong> CREDIT HOLD </strong>
                </div>
            </xpath>
            <xpath expr="//label[@for='lot_producing_id']" position="before">
                <field  name="credit_hold" groups="ol_credit_limit.group_credit_management_user"/>
            </xpath>
        </field>
    </record>

</odoo>
