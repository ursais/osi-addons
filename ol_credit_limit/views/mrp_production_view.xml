<odoo>
    <record id="mrp_production_form_view_inheirt_credit_limit" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position = "inside">
                <widget name="web_ribbon" title="CREDIT HOLD" bg_color="text-bg-danger" invisible="not credit_hold" groups="ol_credit_limit.group_credit_management_user"/>
            </xpath>
            <field name="tag_ids" position="after">
                <field  name="credit_hold" groups="ol_credit_limit.group_credit_management_user"/>
            </field>
        </field>
    </record>
</odoo>