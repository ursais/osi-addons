<odoo>

	<function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value
                eval="[('module', '=', 'ol_exception'), ('name', 'in', ('sale_exception_config_ignore_exception', 'stock_picking_exception_config_ignore_exception', 'mo_exception_config_ignore_exception'))]" />
        </function>
        <value eval="{'noupdate': False}" />
    </function>

    <function name="unlink" model="exception.rule">
            <value model="exception.rule" eval="obj().search([('name', '=', 'Sale OrderCredit Hold Exception')]).id"/>
    </function>

    <function name="unlink" model="exception.rule">
        <value model="exception.rule" eval="obj().search([('name', '=', 'Manufacturing Credit Hold Exception')]).id"/>
    </function>

    <function name="unlink" model="exception.rule">
        <value model="exception.rule" eval="obj().search([('name', '=', 'Picking Credit Holde Exception')]).id"/>
    </function>

</odoo>
