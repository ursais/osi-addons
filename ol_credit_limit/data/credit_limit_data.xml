<odoo noupdate="1">

    <record id="exception_credit_picking_hold" model="exception.rule">
        <field name="name">The delivery cannot be confirmed because the customer's account is on credit hold.</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">stock.picking</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True)]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_mrp_hold" model="exception.rule">
        <field name="name">Manufacturing Credit Hold Exception</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">mrp.production</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True)]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_picking_outgoing_hold" model="exception.rule">
        <field name="name">Picking Credit Holde Exception</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">stock.picking</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True), ('picking_type_code', '=', 'outgoing')]</field>
        <field name="active" eval="True" />
    </record>

</odoo>
