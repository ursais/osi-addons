<odoo noupdate="1">

    <record id="exception_credit_so_hold" model="exception.rule">
        <field name="name">Sale OrderCredit Hold Exception</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">sale.order</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True),("override_credit_limit_hold","=",False)]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_credit_picking_hold" model="exception.rule">
        <field name="name">The delivery cannot be confirmed because the customer's account is on credit hold.</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">stock.picking</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True)]</field>
        <field name="active" eval="True" />
    </record>

    <record id="exception_mrp_hold" model="exception.rule">
        <field name="name">Manufacturing cannot proceed due to customer's credit hold</field>
        <field name="description">Credit Hold Exception</field>
        <field name="model">mrp.production</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[("credit_hold", "=", True)]</field>
        <field name="active" eval="True" />
    </record>

</odoo>
