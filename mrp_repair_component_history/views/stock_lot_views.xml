<odoo>

    <!-- Component History on Serial Number Form -->
    <record id="mrp_repair_component_history_view_production_lot_form" model="ir.ui.view">
        <field name="name">smrp.repair.component.history.inherit.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Component History">
                    <field name="component_history_ids" nolabel="1">
                        <tree decoration-danger="change_type in ('remove', 'recycle')" decoration-success="change_type == 'add'">
                            <field name="change_type" />
                            <field name="product_id" />
                            <field name="qty_changed" />
                            <field name="component_lot_ids" widget="many2many_tags" />
                            <field name="source_id" />
                            <field name="create_date" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
