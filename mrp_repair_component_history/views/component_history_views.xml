<odoo>

    <!-- Tree View -->
    <record id="view_component_history_tree" model="ir.ui.view">
        <field name="name">component.history.tree</field>
        <field name="model">component.history</field>
        <field name="arch" type="xml">
            <tree decoration-danger="change_type in ('remove', 'recycle')" decoration-success="change_type == 'add'">
                <field name="invisible" />
                <field name="lot_id" />
                <field name="change_type" />
                <field name="product_id" />
                <field name="qty_changed" />
                <field name="component_lot_ids" widget="many2many_tags" />
                <field name="source_id" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_component_history_form" model="ir.ui.view">
        <field name="name">component.history.form</field>
        <field name="model">component.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="lot_id" />
                        <field name="product_id" />
                        <field name="qty_changed" />
                        <field name="change_type" />
                        <field name="source_id" />
                        <field name="invisible" />
                        <field name="component_lot_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_component_history_search" model="ir.ui.view">
        <field name="name">component.history.search</field>
        <field name="model">component.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id" />
                <field name="component_lot_ids" />
                <field name="product_id" />
                <field name="source_id" />
                <filter name="visible" string="Visible" domain="[['invisible', '=', False]]" />
                <filter name="invisible" string="Invisible" domain="[['invisible', '=', True]]" />
                <group expand="0" string="Group By">
                    <filter string="Serial Number" name="group_by_lot_id" domain="[]" context="{'group_by':'lot_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Menu and Action -->
    <record id="action_component_history" model="ir.actions.act_window">
        <field name="name">Component History</field>
        <field name="res_model">component.history</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_visible': True, 'search_default_group_by_lot_id': True}</field>
    </record>

    <menuitem
        id="menu_component_history_mrp"
        name="Component History"
        parent="mrp.menu_mrp_bom"
        action="action_component_history"
        sequence="16"
    />

    <menuitem
        id="menu_component_history_stock"
        name="Component History"
        parent="stock.menu_stock_inventory_control"
        action="action_component_history"
        sequence="102"
    />

</odoo>
