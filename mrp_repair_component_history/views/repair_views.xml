<odoo>

    <!-- Component History on Repair Order -->
    <record id="mrp_repair_component_history_view_repair_order_form" model="ir.ui.view">
        <field name="name">mrp.repair.component.history.repair.order.inherit.form</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Component History" invisible="not lot_id" groups="stock.group_production_lot">
                    <field name="component_history_ids" nolabel="1">
                        <tree decoration-danger="change_type in ('remove', 'recycle')" decoration-success="change_type == 'add'">
                            <field name="change_type" />
                            <field name="product_id" />
                            <field name="qty_changed" />
                            <field name="component_lot_ids" widget="many2many_tags" />
                            <field name="source_id" />
                            <field name="create_date" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>