<odoo>
    <data>
        <!-- model_id and operation should be unique if you need to handle that logic in python. -->
        <!-- The webhook.events -->
        <record id="support_repair_order_create" model="webhook.event">
            <field name="name">Repair Order: Create</field>
            <field name="model_id" search="[('model', '=', 'support.repair.order')]" />
            <field name="model_name">support.repair.order</field>
            <field name="operation">create</field>
        </record>
        <record id="support_repair_order_update" model="webhook.event">
            <field name="name">Repair Order: Update</field>
            <field name="model_id" search="[('model', '=', 'support.repair.order')]" />
            <field name="model_name">support.repair.order</field>
            <field name="operation">update</field>
        </record>
        <record id="support_repair_order_delete" model="webhook.event">
            <field name="name">Repair Order: Delete</field>
            <field name="model_id" search="[('model', '=', 'support.repair.order')]" />
            <field name="model_name">support.repair.order</field>
            <field name="operation">delete</field>
        </record>
        <!-- The Webhook -->
        <record id="support_repair_order_webhook" model="webhook">
            <field name="client_id" ref="ol_api.webhook_client_onlogic" />
            <field name="url_path">repair-order</field>
            <field name="event_ids" eval="[
            (4, ref('ol_webhooks.support_repair_order_create'), 0),
            (4, ref('ol_webhooks.support_repair_order_update'), 0),
            (4, ref('ol_webhooks.support_repair_order_delete'), 0)
            ]"/>
        </record>
    </data>
</odoo>