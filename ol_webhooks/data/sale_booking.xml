<odoo>
    <data>
        <!-- model_id and operation should be unique if you need to handle that logic in python. -->
        <!-- The webhook.events -->
        <record id="sale_booking_create" model="webhook.event">
            <field name="name">Sale Booking: Create</field>
            <field name="model_id" search="[('model', '=', 'sale.booking')]" />
            <field name="model_name">sale.booking</field>
            <field name="operation">create</field>
        </record>
        <record id="sale_booking_update" model="webhook.event">
            <field name="name">Sale Booking: Update</field>
            <field name="model_id" search="[('model', '=', 'sale.booking')]" />
            <field name="model_name">sale.booking</field>
            <field name="operation">update</field>
        </record>
        <record id="sale_booking_delete" model="webhook.event">
            <field name="name">Sale Booking: Delete</field>
            <field name="model_id" search="[('model', '=', 'sale.booking')]" />
            <field name="model_name">sale.booking</field>
            <field name="operation">delete</field>
        </record>
        <!-- The Webhook -->
        <record id="sale_booking_webhook" model="webhook">
            <field name="client_id" ref="ol_api.webhook_client_onlogic" />
            <field name="url_path">sale-booking</field>
            <field name="enabled">True</field>
            <field name="event_ids" eval="[
            (4, ref('ol_webhooks.sale_booking_create'), 0),
            (4, ref('ol_webhooks.sale_booking_update'), 0),
            (4, ref('ol_webhooks.sale_booking_delete'), 0)
            ]"/>
        </record>
    </data>
</odoo>