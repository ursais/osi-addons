<odoo>
    <data>
        <!-- model_id and operation should be unique if you need to handle that logic in python. -->
        <!-- The webhook.events -->
        <record id="bom_create" model="webhook.event">
            <field name="name">Bom: Create</field>
            <field name="model_id" search="[('model', '=', 'mrp.bom')]" />
            <field name="model_name">mrp.bom</field>
            <field name="operation">create</field>
            <field name="is_custom">False</field>
        </record>
        <record id="bom_update" model="webhook.event">
            <field name="name">Bom: Update</field>
            <field name="model_id" search="[('model', '=', 'mrp.bom')]" />
            <field name="model_name">mrp.bom</field>
            <field name="operation">update</field>
            <field name="is_custom">False</field>
        </record>
        <record id="bom_delete" model="webhook.event">
            <field name="name">Bom: Delete</field>
            <field name="model_id" search="[('model', '=', 'mrp.bom')]" />
            <field name="model_name">mrp.bom</field>
            <field name="operation">delete</field>
            <field name="is_custom">False</field>
        </record>
        <!-- The Webhook -->
        <record id="bom_webhook" model="webhook">
            <field name="client_id" ref="ol_api.webhook_client_onlogic" />
            <field name="url_path">bom</field>
            <field name="event_ids" eval="[
            (4, ref('ol_webhooks.bom_create'), 0),
            (4, ref('ol_webhooks.bom_update'), 0),
            (4, ref('ol_webhooks.bom_delete'), 0)
            ]"/>
        </record>
    </data>
</odoo>