<odoo>
    <data>
        <!-- model_id and operation should be unique if you need to handle that logic in python. -->
        <!-- The webhook.events -->
        <record id="rma_create" model="webhook.event">
            <field name="name">Rma: Create</field>
            <field name="model_id" search="[('model', '=', 'helpdesk.rma')]" />
            <field name="model_name">helpdesk.rma</field>
            <field name="operation">create</field>
        </record>
        <record id="rma_update" model="webhook.event">
            <field name="name">Rma: Update</field>
            <field name="model_id" search="[('model', '=', 'helpdesk.rma')]" />
            <field name="model_name">helpdesk.rma</field>
            <field name="operation">update</field>
        </record>
        <record id="rma_delete" model="webhook.event">
            <field name="name">Rma: Delete</field>
            <field name="model_id" search="[('model', '=', 'helpdesk.rma')]" />
            <field name="model_name">helpdesk.rma</field>
            <field name="operation">delete</field>
        </record>
        <!-- The Webhook -->
        <record id="rma_webhook" model="webhook">
            <field name="client_id" ref="ol_api.webhook_client_onlogic" />
            <field name="url_path">rma</field>
            <field name="enabled">True</field>
            <field name="event_ids" eval="[
            (4, ref('ol_webhooks.rma_create'), 0),
            (4, ref('ol_webhooks.rma_update'), 0),
            (4, ref('ol_webhooks.rma_delete'), 0)
            ]"/>
        </record>
    </data>
</odoo>