<odoo>
    <data>
        <record id="view_helpdesk_rma_form" model="ir.ui.view">
            <field name="name">ol_webhooks.rma.view.form</field>
            <field name="model">helpdesk.rma</field>
            <field name="inherit_id" ref="ol_rma.view_helpdesk_rma_form"/>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <notebook name="main_tabs" position="inside">
                    <page name="webhook" string="Webhooks" groups="ol_base.dev_team">
                        <group name="webhook_info">
                            <button type="object" name="action_webhook_test" class="btn btn-secondary" icon="fa-podcast" string="Test Webhook"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>