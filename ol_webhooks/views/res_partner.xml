<odoo>
    <data>
        <record id="view_new_res_partner_form" model="ir.ui.view">
            <field name="name">ol_webhooks.new.res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="ol_base.view_partner_form"/>
            <field name="arch" type="xml">
                <page name="onlogic_info" position="inside">
                    <group name="webhook_info">
                        <field name="webhook_broadcast_date" readonly="1"/>
                        <button type="object" name="action_webhook_test" class="btn btn-secondary" icon="fa-podcast" string="Test Webhook"/>
                    </group>
                </page>
            </field>
        </record>
    </data>
</odoo>