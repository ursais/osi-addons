<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">ol_webhooks.view_account_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="ol_base.view_account_move_form"/>
        <field name="arch" type="xml">
            <page name="onlogic_info" position="inside">
                <group name="webhook_info">
                    <field name="webhook_broadcast_date" readonly="1"/>
                    <button type="object" name="action_webhook_test" class="btn btn-secondary" icon="fa-podcast" string="Test Webhook"/>
                </group>
            </page>
        </field>
    </record>
</odoo>