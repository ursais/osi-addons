<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">ol_base.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="ol_base.view_order_form"/>
        <field name="arch" type="xml">
            <page name="onlogic_info" position="inside">
                <group name="webhook_info">
                    <field name="webhook_broadcast_date" readonly="1"/>
                    <button type="object" name="action_webhook_test" class="btn btn-secondary" icon="fa-podcast" string="Test Webhook"/>
                </group>
            </page>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="context">{"sale_order_invoice_address_webhook_trigger": id}</attribute>
            </field>
        </field>
    </record>
</odoo>