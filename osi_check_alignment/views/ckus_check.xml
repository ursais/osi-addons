<odoo>

    <template
        id="osi_check_alignment_check"
        inherit_id="l10n_us_check_printing.ckus_check"
        priority="100"
    >
        <xpath expr="//div[hasclass('ckus_check')]" position="replace">
            <t t-if="o.company_id.id == 1">
                <div class="ckus_check">
                    <t t-if="page['state'] == 'cancelled'">
                        <div class="o-watermark">VOID</div>
                    </t>
                    <div
                        class="sequence_number"
                        t-if="page['sequence_number'] and page['manual_sequencing']"
                        t-esc="page['sequence_number']"
                        t-attf-style="top: {{ o.company_id.sequence_number_margin_top }}in; left: {{ o.company_id.sequence_number_margin_left }}in;"
                    />
                    <div
                        class="ckus_date"
                        t-esc="page['date']"
                        t-attf-style="top: {{ o.company_id.ckus_date_margin_top }}in; left: {{ o.company_id.ckus_date_margin_left }}in;"
                    />
                    <div
                        class="ckus_payee_name"
                        t-esc="page['partner_name']"
                        t-attf-style="top: {{ o.company_id.ckus_payee_name_margin_top }}in; left: {{ o.company_id.ckus_payee_name_margin_left }}in;"
                    />
                    <div
                        class="ckus_amount"
                        t-attf-style="top: {{ o.company_id.amount_margin_top }}in; left: {{ o.company_id.amount_margin_left }}in;"
                    >
                        <t t-esc="page['amount'].replace(o.currency_id.symbol, '')" />
                    </div>
                    <div
                        class="ckus_amount_in_word"
                        t-esc="page['amount_in_word']"
                        t-attf-style="top: {{ o.company_id.amount_word_margin_top }}in; left: {{ o.company_id.amount_word_margin_left }}in;"
                    />
                    <div
                        class="ckus_payee_addr"
                        t-esc="page['partner_id']"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                        t-attf-style="top: {{ o.company_id.payee_address_margin_top }}in; left: {{ o.company_id.payee_address_margin_left }}in;"
                    />
                    <div
                        class="ckus_memo"
                        t-esc="page['memo']"
                        t-attf-style="top: {{ o.company_id.memo_margin_top }}in; left: {{ o.company_id.memo_margin_left }}in;"
                    />
                </div>
            </t>
        </xpath>
    </template>

</odoo>
