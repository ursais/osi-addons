<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Report Action -->
  <record id="action_report_refund_invoice" model="ir.actions.report">
    <field name="name">RMA Refund Invoice</field>
    <field name="print_report_name">'RMA Refund Invoice'</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ol_rma.report_refund_invoice</field>
    <field name="report_file">ol_rma.report_refund_invoice</field>
    <field name="binding_model_id" ref="account.model_account_move" />
    <field name="paperformat_xmlid_base">ol_templates.ol_report_paper_format</field>
  </record>

  <!-- Main template -->
  <template id="report_refund_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">

        <!-- Find the correct language-->
        <t t-set="language" t-value="doc.partner_id.lang"/>

        <t t-set="invoice_report_data" t-value="doc.with_context(lang=language).get_invoice_report_data()"/>
        <t t-set="invoice" t-value="invoice_report_data['invoice']"/>
        <t t-set="invoice_data" t-value="invoice_report_data['invoice_data']"/>

        <!-- Call the template document with the language set -->
        <t t-call="ol_rma.report_refund_invoice_document" t-lang="language"/>
      </t>
    </t>
  </template>

  <template id="report_refund_invoice_document">

    <t t-call="ol_templates.external_layout">
      <!-- Set the name and title of the Report -->
      <t t-set="report_title">Credit</t>
      <!--Set template variables-->
      <t t-set="title" t-value="'Invoice PDF Report'"/>
      <t t-set="hide_tracking" t-value="True"/>
      <t t-set="customer_company_name" t-value="invoice.partner_id.company_name or invoice.partner_id.commercial_company_name"/>
      <t t-set="sale_order" t-value="invoice.line_ids.sale_line_ids.order_id"/>
      <!-- TODO: NC : sale_order.quote_type field not found -->
      <!-- <t t-set="budgetary_quote" t-value="sale_order.quote_type == 'budgetary'"/> -->
      <t t-set="budgetary_quote" t-value="budgetary"/>
      <t t-set="currency" t-value="invoice.currency_id"/>
      <t t-set="company" t-value="invoice.company_id"/>
      <t t-set="sum_amount" t-value="invoice_data['sum_amount']"/>
      <t t-set="out_invoice_amount" t-value="invoice_data['out_invoice_amount']"/>
      <t t-set="out_refund_amount" t-value="invoice_data['out_refund_amount']"/>
      <t t-set="payment_received_amount" t-value="invoice_data['payment_received_amount']"/>
      <t t-set="residual_amount" t-value="invoice_data['residual_amount']"/>
      <t t-set="partner" t-value="invoice.partner_id"/>
      <t t-set="partner_shipping_id"
         t-value="invoice.partner_shipping_id or invoice.partner_id or sale_order.partner_shipping_id"/>
      <t t-set="partner_invoice_id" t-value="invoice.partner_id or sale_order.partner_invoice_id"/>
      <t t-set="invoice_lines" t-value="invoice.invoice_line_ids"/>
      <t t-set="shipping_lines"
         t-value="sale_order.order_line.filtered(lambda l: l.is_delivery)[:1]"/>
      <t t-set="shipping_subtotal_amount"
         t-value="shipping_lines.price_subtotal"/>
      <t t-if="invoice.move_type == 'out_refund'">
        <t t-set="refund" t-value="True"/>
      </t>
      <t t-if="invoice.move_type == 'out_invoice'">
        <t t-set="refund" t-value="False"/>
      </t>

      <!--The first main information block-->
      <div class="ol_report_info_row ol_flex">

        <!--Basic Invoice information-->
        <div class="ol_report_info_row_col info">

          <div class="ol_report_info_row_col_title ol_flex">
            <div class="key">
              <t t-esc="report_title" t-options='{"widget": "cap_formatter", "case":"title"}'/>
            </div>
            <div class="value">
              <t t-esc="invoice.name"/>
            </div>
          </div>

          <div class="ol_report_info_row_col_line ol_flex">
            <div class="key">
              <t t-esc="report_title" t-options='{"widget": "cap_formatter", "case":"title"}'/>
              <tag>Date</tag>
            </div>
            <div class="value">
              <t t-esc="invoice.invoice_date" t-options='{"widget": "date_formatter"}'/>
            </div>
          </div>

          <div class="ol_report_info_row_col_line ol_flex">
            <div class="key">
              <tag>Payment Due Date</tag>
            </div>
            <div class="value">
              <t t-esc="invoice.invoice_date_due" t-options='{"widget": "date_formatter"}'/>
            </div>
          </div>

          <t t-if="sale_order">
            <div class="ol_report_info_row_col_line ol_flex">
              <div class="key">
                <tag>Order</tag>
              </div>
              <div class="value">
                <t t-esc="sale_order.name"/>
              </div>
            </div>

            <div class="ol_report_info_row_col_line ol_flex">
              <div class="key">
                <tag>Order Date</tag>
              </div>
              <div class="value">
                <t t-esc="sale_order.date_order" t-options='{"widget": "date_formatter"}'/>
              </div>
            </div>
          </t>

          <t t-if="rma">
            <div class="ol_report_info_row_col_line ol_flex">
              <div class="key">
                <tag>RMA</tag>
              </div>
              <div class="value">
                <t t-esc="rma.name"/>
              </div>
            </div>
          </t>

        </div>

        <!--Billing related information-->
        <div class="ol_report_info_row_col billing">
          <t t-call="ol_templates.address">
            <t t-if="invoice.move_type == 'out_refund'">
              <t t-set="text">Credit To</t>
            </t>
            <t t-if="invoice.move_type != 'out_refund'">
              <t t-set="text">Bill To</t>
            </t>
            <t t-set="address" t-value="partner_invoice_id"/>
          </t>
          <!-- TODO: NC : sale_order.payment_method_id field not found -->
          <!-- <t t-call="ol_templates.payment" t-if="sale_order.payment_method_id">
            <t t-set="block_title">Payment Method</t>
            <t t-set="payment_method" t-value="sale_order.payment_method_id"/>
          </t> -->
        </div>

        <!--Shipping related information-->
        <div class="ol_report_info_row_col shipping">
          <t t-call="ol_templates.address">
            <t t-set="text">Ship To</t>
            <t t-set="show_vat_id" t-value="True"/>
            <t t-set="address" t-value="partner_shipping_id"/>
          </t>
          <t t-call="ol_templates.shipment" t-if="sale_order.carrier_id">
            <t t-set="block_title">Shipping Method</t>
            <t t-if="sale_order">
              <t t-set="shipment" t-value="sale_order.carrier_id"/>
              <t t-if="not rma">
                <!-- TODO: NC : picking_ids.tracking_ids field not found -->
	            <!-- <t t-set="tracking_numbers" t-value="sale_order.mapped('picking_ids.tracking_ids')"/> -->
	            <t t-set="tracking_numbers" t-value="sale_order.mapped('picking_ids.lot_id')"/>
              </t>
            </t>
            <t t-if="rma">
              <t t-set="shipment" t-value="rma.shipping_method"/>
            </t>
          </t>
        </div>

      </div>

      <!--Invoice Lines-->
      <t t-if="not rma" t-call="ol_templates.report_invoiceable_lines">
        <t t-set="products_title">
          Credit Items
        </t>
        <t t-set="summary" t-value="False"/>
        <t t-set="compressed" t-value="True"/>
      </t>

      <t t-if="additional_invoice_lines">
        <t t-call="ol_templates.refund_additional_invoice_line">
          <t t-set="invoice_lines" t-value="additional_invoice_lines"/>
          <t t-set="products_title">
            Additional Invoice Lines
          </t>
        </t>
      </t>

      <!--Order noted and totals-->
      <t t-call="ol_templates.report_notes_and_totals_refund_invoice"/>

    </t>
  </template>
</odoo>
