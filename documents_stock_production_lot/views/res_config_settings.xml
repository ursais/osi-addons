<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_documents_lot_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.documents.lot</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70" />
        <field name="inherit_id" ref="documents.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='documents']" position="attributes">
                <attribute name="notApp">0</attribute>
            </xpath>
            <xpath
                expr="//block[@id='files_centralization_section']"
                position="attributes"
            >
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//block[@id='files_centralization_section']" position="inside">
                <setting
                    company_dependent="1"
                    help="Centralize files attached to lot/tracking numbers"
                >
                    <field name="documents_lot_settings" />
                    <div class="content-group" invisible="not documents_lot_settings">
                        <div class="row mt16">
                            <label
                                class="o_form_label col-lg-3"
                                for="lot_folder_id"
                                string="Folder"
                            />
                            <field
                                name="lot_folder_id"
                                required="documents_lot_settings"
                                widget="documents_folder_many2one"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </div>
                        <div class="row">
                            <label
                                class="o_form_label col-lg-3"
                                for="lot_tag_ids"
                                string="Tags"
                            />
                            <field name="lot_tag_ids" widget="many2many_tags" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
