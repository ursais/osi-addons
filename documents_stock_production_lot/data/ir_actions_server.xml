<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record
        id="ir_actions_server_attach_to_lot_code"
        model="ir.actions.server"
        forcecreate="0"
    >
        <field name="name">Attach to Lot/Tracking Number</field>
        <field name="model_id" ref="documents.model_documents_document" />
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user'))]" />
        <field name="state">code</field>
        <field name="code">
            action = records.action_link_to_record('stock.lot')
        </field>
    </record>
    <record
        id="ir_actions_server_attach_to_lot"
        model="ir.actions.server"
        forcecreate="0"
    >
        <field name="name">Attach to Lot/Tracking Number</field>
        <field name="model_id" ref="documents.model_documents_document" />
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user'))]" />
        <field name="state">multi</field>
        <field
            name="child_ids"
            eval="[Command.link(ref('documents_stock_production_lot.ir_actions_server_attach_to_lot_code'))]"
        />
    </record>
    <function model="documents.document" name="action_folder_embed_action">
        <value name="folder_id" eval="ref('documents_folder_lot')" />
        <value name="action_id" eval="ref('ir_actions_server_attach_to_lot')" />
    </function>
</odoo>
