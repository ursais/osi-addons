<odoo>

	<record id="payment_method_stripe" model="payment.method">
        <field name="name">Stripe</field>
        <field name="code">stripe</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
    </record>

    <record id="payment_method_payment_terms" model="payment.method">
        <field name="name">Payment Terms</field>
        <field name="code">PYT</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>

    <record id="payment_method_ach" model="payment.method">
        <field name="name">ACH</field>
        <field name="code">ACH</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>
    <record id="payment_method_check" model="payment.method">
        <field name="name">Check</field>
        <field name="code">Check</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>
    
    <record id="payment_method_online_portal" model="payment.method">
        <field name="name">Online Portal</field>
        <field name="code">OP</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>
    
    <record id="payment_method_automatic_withdrawal" model="payment.method">
        <field name="name">Automatic Withdrawal</field>
        <field name="code">AW</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>

</odoo>
