<odoo>
    <record id="view_mrp_production_form" model="ir.ui.view">
        <field name="name">ol_base.view_mrp_production_form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add a debug page for relevant developer information -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="onlogic_info" string="OnLogic Information" groups="ol_base.dev_team"/>
            </xpath>
        </field>
    </record>
</odoo>