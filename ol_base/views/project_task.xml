<odoo>
    <record id="view_project_task_form" model="ir.ui.view">
        <field name="name">ol_base.view_project_task_form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Add a debug page for relevant developer information -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="onlogic_info" string="OnLogic Information" groups="ol_base.dev_team"/>
            </xpath>
        </field>
    </record>
</odoo>