<odoo>
    <!-- account.view_partner_property_form
 -->

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">ol_base.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add a debug page for relevant developer information -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="onlogic_info" string="OnLogic Information" groups="ol_base.dev_team"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form/sheet/group/group" position="inside">
                <field name="override_company_name"/>
            </xpath>
        </field>
    </record>


    <record id="view_partner_property_form_inherit_ol_base" model="ir.ui.view">
        <field name="name">ol_base.view_partner_property_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr = "//page[@name='sales_purchases']" position="before">
                <page name="contact_types" string="Contact Types">
                    <group string="Accounting Contact Types" name="accounting_contact_types" groups="account.group_account_readonly">
                        <field name="followup"/>
                        <field name="ap"/>
                        <field name="ar"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']//form//field[@name='company_id']" position="after">
                <field name="followup"/>
                <field name="ap"/>
                <field name="ar"/>
            </xpath> 
        </field>
    </record>

</odoo>
