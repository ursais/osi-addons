<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">ol_base.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add a debug page for relevant developer information -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="onlogic_info" string="OnLogic Information" groups="ol_base.dev_team"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form/sheet/group/group" position="inside">
                <field name="override_company_name"/>
            </xpath>
        </field>
    </record>

</odoo>
