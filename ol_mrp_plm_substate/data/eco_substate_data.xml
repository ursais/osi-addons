<odoo>

    <record id="base_substate_type_eco" model="base.substate.type">
        <field name="name">ECO</field>
        <field name="model">mrp.eco</field>
        <field name="target_state_field">state</field>
    </record>

    <record id="target_state_value_eco" model="target.state.value">
        <field name="name">ECO Confirmed</field>
        <field name="base_substate_type_id" ref="base_substate_type_eco" />
        <field name="target_state_value">confirmed</field>
    </record>

    <record id="target_state_value_draft" model="target.state.value">
        <field name="name">ECO In Progress</field>
        <field name="base_substate_type_id" ref="base_substate_type_eco" />
        <field name="target_state_value">progress</field>
    </record>

</odoo>
