<odoo>

    <record id="ol_mrp_plm_substate_mrp_eco_view_form" model="ir.ui.view">
      <field name="model">mrp.eco</field>
      <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form" />
      <field name="arch" type="xml">
          <xpath expr="//header" position="after">
              <header name="substate">
                  <field
                        name="substate_id"
                        widget="statusbar"
                        options="{'clickable': '1',}"
                    />
              </header>
          </xpath>
      </field>
    </record>

    <record id="ol_mrp_plm_substate_mrp_eco_view_tree" model="ir.ui.view">
        <field name="model">mrp.eco</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_tree" />
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="substate_id" />
            </field>
        </field>
    </record>

    <record id="ol_mrp_plm_substate_mrp_eco_search" model="ir.ui.view">
        <field name="model">mrp.eco</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_search" />
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="substate_id" />
            </field>
            <filter name="company" position="after">
                <filter
                    name="substate_id"
                    string="Substate"
                    domain="[]"
                    context="{'group_by':'substate_id'}"
                />
            </filter>
        </field>
    </record>

</odoo>
