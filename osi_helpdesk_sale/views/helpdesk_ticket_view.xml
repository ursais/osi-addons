<odoo>

    <record id="helpdesk_ticket_view_helpdesk_sale_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.helpdesk_sale.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='legend_blocked']" position="before">
                <field name="use_helpdesk_sale_orders" invisible="1" />
            </xpath>
            <field name="stage_id" position="before">
                <button
                    name="create_sale_order"
                    string="Create Sale Order"
                    type="object"
                    class="btn btn-primary"
                    invisible="not use_helpdesk_sale_orders"
                    groups="sales_team.group_sale_salesman"
                />
            </field>
            <xpath
                expr="//div[@name='button_box']/button[@name='action_open_helpdesk_ticket']"
                position="after"
            >
                <button
                    name="action_view_sale_order"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-dollar"
                    invisible="sale_count == 0 and not use_helpdesk_sale_orders"
                    groups="sales_team.group_sale_salesman"
                >
                    <field name="sale_count" widget="statinfo" string="Sales" />
                </button>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form_inherit_stock_user_def" model="ir.ui.view">
        <field name="name">helpdesk.ticket.helpdesk.stock.form.def</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_stock.helpdesk_ticket_view_form_inherit_stock_user" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(stock.act_stock_return_picking)d']"
                position="before"
            >
                <field name="return_sale_id" invisible="1" />
            </xpath>
            <xpath
                expr="//button[@name='%(stock.act_stock_return_picking)d']"
                position="attributes"
            >
                <attribute name="context">{'default_ticket_id': id, 'default_company_id': company_id, 'default_sale_order_id': return_sale_id}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
