<odoo>

    <!-- Form View -->
    <record id="ol_product_configurator_product_attribute_value_form_view_inherit" model="ir.ui.view">
        <field name="name">product.config.product.attribute.value.form.view</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product_configurator.product_attribute_value_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group//group//field[@name='product_id']" position="before">
                <field name="company_ids" widget="many2many_tags" readonly="product_id" />
            </xpath>
            <xpath expr="//field[@name='attribute_id']" position="after">
                <field name="visible_to_user" />
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="ol_product_configurator_product_attribute_value_list_inherit" model="ir.ui.view">
        <field name="name">product.attribute.value.list</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="visible_to_user" />
                <field name="product_id" />
                <field name="company_ids" widget="many2many_tags" readonly="product_id" />
            </field>
        </field>
    </record>

    <!-- Search View -->
    <record id="product_attribute_value_search_view" model="ir.ui.view">
        <field name="name">product.attribute.value.search</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <search string="Product">
                <field name="name" />
                <field name="product_id" />
                <field name="company_ids" />
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="product_configurator.variants_action" model="ir.actions.act_window">
        <field name="search_view_id" ref="product_attribute_value_search_view" />
    </record>

</odoo>
