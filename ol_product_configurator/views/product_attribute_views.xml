<odoo>

    <!-- Form View -->
    <record id="ol_product_configurator_product_attribute_view_form_inherit" model="ir.ui.view">
        <field name="name">attribute.value.form.view</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/tree/field[@name='display_type']" position="after">
                <field name="product_id" />
                <field name="visible_to_user" />
                <field name="company_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>

</odoo>
