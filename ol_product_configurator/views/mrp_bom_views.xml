<odoo>

    <!-- Add scaffold bom filter -->
    <record id="ol_product_configurator_view_mrp_bom_filter" model="ir.ui.view">
        <field name="name">product.configurator.mrp.bom.filter</field>
        <field name="model">mrp.bom</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter" />
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <separator/>
                <filter string="Scaffold BoMs" name="scaffolding_bom" domain="[('scaffolding_bom', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Override template open bom action to default scaffold filter -->
    <record id="mrp.mrp_bom_form_action" model="ir.actions.act_window">
        <field name="context">{'default_company_id': allowed_company_ids[0], 'search_default_scaffolding_bom': 1}</field>
    </record>

    <!-- Override bom list action to default scaffold filter -->
    <record id="mrp.template_open_bom" model="ir.actions.act_window">
        <field name="context">{'default_product_tmpl_id': active_id, 'search_default_scaffolding_bom': 1}</field>
    </record>

</odoo>
