<odoo>

    <record id="ol_product_configurator_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <!-- Add alert message if has_advanced_configuration is True -->
            <xpath expr="//field[@name='product_variant_count']" position="before">
                <field name="has_advanced_configuration" invisible="1" />
                <div class="alert alert-warning" role="alert" invisible="not has_advanced_configuration">
                    <strong>Advanced Configuration Enabled!</strong><br/>
                    Not compatible with eCommerce: This product template has advanced configurations that are not currently compatible with eCommerce due to configuration restrictions or BoM lines without configuration sets.
                </div>
            </xpath>
            <!-- Add company_ids_display field -->
            <xpath expr="//group[@name='sale']" position="before">
                <group>
                    <group name="visibility">
                        <field name="company_ids_display" widget="many2many_tags" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="ol_product_config_template_view_tree_configurable" model="ir.ui.view">
        <field name="name">product.template.product.tree</field>
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product_configurator.template_view_tree_configurable" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
