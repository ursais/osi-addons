<odoo>

    <record id="operations_technical_team" model="res.groups">
        <field name="name">Operations Technical Team</field>
        <field name="category_id" ref="ol_base.onlogic_groups"/>
        <field name="implied_ids" eval="[(4, ref('base.group_no_one'))]"/>
    </record>

    <!-- Dev team group should imply Operations Technical Team-->
    <record id="ol_base.dev_team" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ol_product_operations_category.operations_technical_team'))]"/>
    </record>

</odoo>
