<odoo>

    <record id="product_template_form_view_inherit_ol_product_op_catg" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field string="Operations Category" name="operations_category_id"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_inherit_ol_product_op_catg" model="ir.ui.view">
        <field name="name">product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field string="Operations Category" name="operations_category_id" filter_domain="[('operations_category_id', 'child_of', raw_value)]"/>
            </field>
            <filter name="categ_id" position="after">
                <filter string="Operations Category" name="operations_category_id" context="{'group_by':'operations_category_id'}"/>
            </filter>
        </field>
    </record>

    <record id="product_product_tree_view_inherit_ol_product_op_catg" model="ir.ui.view">
        <field name="name">product.product.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field eval="7" name="priority"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field string="Operations Category" name="operations_category_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
