<odoo>

    <record id="product_operations_category_search_view" model="ir.ui.view">
        <field name="name">product.operations.category.search</field>
        <field name="model">product.operations.category</field>
        <field name="arch" type="xml">
            <search string="Product Operations Categories">
                <field name="name" string="Product Operations Categories"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="product_operations_category_form_view" model="ir.ui.view">
        <field name="name">product.operations.category.form</field>
        <field name="model">product.operations.category</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name" string="Category name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Lamps"/>
                        </h1>
                    </div>
                    <group name="first" col="2">
                        <field name="parent_id" class="oe_inline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_operations_category_list_view" model="ir.ui.view">
        <field name="name">product.operations.category.list</field>
        <field name="model">product.operations.category</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree string="Product Operations Categories">
                <field name="display_name" string="Product Operations Category"/>
            </tree>
        </field>
    </record>

    <record id="product_operations_category_action_form" model="ir.actions.act_window">
        <field name="name">Product Operations Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.operations.category</field>
        <field name="search_view_id" ref="product_operations_category_search_view"/>
        <field name="view_id" ref="product_operations_category_list_view"/>
    </record>

    <menuitem
        id="menu_product_operations_category_config_stock"
        action="ol_product_operations_category.product_operations_category_action_form"
        parent="stock.menu_product_in_config_stock"
        sequence="3"
    />

</odoo>
