<odoo>
    <record id="ol_public_content_document_view_kanban" model="ir.ui.view">
        <field name="name">ol.public.content.document.view.kanban</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="(//div[hasclass('oe_kanban_bottom_right')]/field)[last()]" position="after">
                <button name="toggle_public" type="object" class="btn btn-sm btn-warning" string="Mark Public" invisible="public_asset==True or active==False or public_eligible==False"/>
                <button name="toggle_public" type="object" class="btn btn-sm btn-warning" string="Mark Not Public" invisible="public_asset==False or active==False or public_eligible==False"/>
                <field name="public_asset" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="public_eligible" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="ol_public_content_document_view_list" model="ir.ui.view">
        <field name="name">ol.public.content.document.view.list</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list"/>
        <field name="arch" type="xml">
            <field name="file_extension" position="after">
                <button name="toggle_public" type="object" class="btn btn-sm btn-warning" string="Mark Public" invisible="public_asset==True or active==False or public_eligible==False"/>
                <button name="toggle_public" type="object" class="btn btn-sm btn-warning" string="Mark Not Public" invisible="public_asset==False or active==False or public_eligible==False"/>
                <field name="public_asset" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
                <field name="public_eligible" column_invisible="1"/>
            </field>
        </field>
    </record>
</odoo>