<odoo>

    <record id="purchase_order_view_purchase_request_estimate_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_open_purchase_request_line"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list"
                    invisible="purchase_request_line_count == 0"
                >
                    <field name="purchase_request_line_count" string="Purchase Request Lines" widget="statinfo" help="Shows the Purchase Request Line Count on the Purchase Order."/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
