<odoo>

    <!-- Form View -->
    <record id="ol_sale_booking_view_blanket_order_form" model="ir.ui.view">
        <field name="name">ol_sale_booking.view_blanket_order_form</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="/form[1]/sheet[1]/notebook[1]/page[last()]" position="after">
                <page string="Bookings">
                    <field name="booking_ids" nolabel="1" readonly="1">
                        <tree string="Bookings" default_order="id desc">
                            <field name="id" optional="show" />
                            <field name="create_date" />
                            <field name="sale_blanket_order_currency_id" invisible="1" />
                            <field name="amount" optional="show" />
                            <field name="amount_untaxed" optional="show" />
                            <field name="order_amount_total" optional="show" />
                            <field name="order_amount_total_untaxed" optional="show" />
                            <field name="tax_amount" optional="show" />
                            <field name="order_prev_amount_total" optional="hide" />
                            <field name="order_prev_amount_total_untaxed" optional="hide" />
                            <field name="prev_tax_amount" optional="hide" />
                            <field name="order_detailed_state" optional="hide" />
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='remaining_uom_qty']" position="after">
                <field name="remaining_price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" />
                <field name="remaining_price_total" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" />
                <field name="remaining_price_tax" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" />
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="after">
                <group class="oe_subtotal_footer oe_right">
                    <field name="remaining_amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" />
                    <field name="remaining_amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" />
                    <label for="amount_total"/>
                    <div class="oe_subtotal_footer_separator">
                        <field name="remaining_amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" />
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
