<odoo>

    <!-- Form View -->
    <record id="ol_sale_booking_view_order_form" model="ir.ui.view">
        <field name="name">ol_sale_booking.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="/form[1]/sheet[1]/notebook[1]/page[last()]" position="after">
                <page string="Bookings">
                    <field name="booking_ids" nolabel="1" readonly="1">
                        <tree string="Bookings" default_order="id desc">
                            <field name="id" optional="show" />
                            <field name="create_date" optional="show" />
                            <field name="currency_id" invisible="1" />
                            <field name="amount" optional="show" />
                            <field name="amount_untaxed" optional="show" />
                            <field name="order_amount_total" optional="show" />
                            <field name="order_amount_total_untaxed" optional="show" />
                            <field name="tax_amount" optional="show" />
                            <field name="order_prev_amount_total" optional="hide" />
                            <field name="order_prev_amount_total_untaxed" optional="hide" />
                            <field name="prev_tax_amount" optional="hide" />
                            <field name="order_detailed_state" optional="hide" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_sale_booking_tree" model="ir.actions.act_window">
        <field name="name">Sale Bookings</field>
        <field name="res_model">sale.booking</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="sale_booking_tree" />
        <field name="search_view_id" ref="sale_booking_tree_search" />
        <field name="context">{'search_default_last_6_months': True}</field>
    </record>

    <menuitem
        id="menu_sale_booking"
        action="action_sale_booking_tree"
        parent="sale.sale_menu_root"
    />

</odoo>
