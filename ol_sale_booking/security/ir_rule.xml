<odoo noupdate="1">

    <!-- Multi-company record rule for Sale Booking -->
    <record id="sale_booking_multico_rule" model="ir.rule">
        <field name="name">Sale Booking Multi-company Rule</field>
        <field name="model_id" ref="ol_sale_booking.model_sale_booking" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>

</odoo>
