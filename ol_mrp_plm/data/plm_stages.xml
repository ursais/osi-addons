        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.engineering_change_order')])]" />
    </record>

    <record id="product_state_implementation" model="mrp.eco.stage">
        <field name="name">Implementation</field>
        <field name="is_approval_stage">True</field>
        <field name="product_state_id" ref="ol_product_state.product_state_pre_order"/>
        <field name="allow_apply_change">True</field>
        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.engineering_change_order')])]" />
