        <field name="name">Done</field>
        <field name="final_stage">True</field>
        <field name="product_state_id" ref="ol_product_state.product_state_active"/>
        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.new_sku'), ref('ol_mrp_plm.new_system'), ref('ol_mrp_plm.product_change_notifications'), ref('ol_mrp_plm.operations_new_consumable')])]" />
    </record>

    <record id="product_state_cancel" model="mrp.eco.stage">
        <field name="name">Cancel</field>
        <field name="cancel_stage">True</field>
        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.new_sku'), ref('ol_mrp_plm.new_system'), ref('ol_mrp_plm.engineering_change_order'), ref('ol_mrp_plm.product_change_notifications'), ref('ol_mrp_plm.operations_new_consumable'), ref('ol_mrp_plm.end_of_sale'), ref('ol_mrp_plm.end_of_life'), ref('ol_mrp_plm.bom_revision')])]" />
