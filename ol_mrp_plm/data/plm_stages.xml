<odoo noupdate="1">

    <record id="onl_new_pm" model="mrp.eco.stage">
        <field name="name">New-PM</field>
        <field name="type_ids" eval="[(6,0,[ref('new_sku')])]" />
    </record>

    <record id="product_state_procurement" model="mrp.eco.stage">
        <field name="name">Procurement</field>
        <field name="allow_bom_edits">True</field>
        <field name="product_state_id" ref="product_state.product_state_draft"/>
        <field name="allow_bom_edits">True</field>
        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.new_sku')])]" />
    </record>

    <record id="product_state_engi_assessment" model="mrp.eco.stage">
        <field name="name">Engineering Assessment</field>
        <field name="is_approval_stage">True</field>
