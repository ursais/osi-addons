    <record id="product_techex_initiation" model="mrp.eco.stage">
        <field name="name">TechEx Initiation</field>
        <field name="allow_apply_change">True</field>
        <field name="type_ids" eval="[(6,0,[ref('ol_mrp_plm.tech_exception')])]" />
    </record>

