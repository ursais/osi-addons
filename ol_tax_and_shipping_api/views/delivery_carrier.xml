<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_delivery_carrier_form" model="ir.ui.view">
    <field name="name">ol_tax_and_shipping_api.delivery.carrier.form</field>
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="ol_delivery.view_delivery_carrier_form"/>
    <field name="arch" type="xml">
      <page name="onlogic_info" position='inside'>
        <group name="grp_uuid">
          <field name='uuid' readonly="1"/>
        </group>
      </page>
      <page name="onlogic_info" position='after'>
        <page string="Tax &amp; Shipping Destination Availability" name="ts_api_destination" invisible="delivery_type == 'fedex'">
          <group colspan="4" col="2">
            <field name="ts_api_enabled"/>
          </group>
          <group invisible="not ts_api_enabled">
            <group colspan="4" col="2">
              <group name="ts_api_country_details">
                <field name="ts_api_country_ids" widget="many2many_tags"/>
                <field name="ts_api_state_ids" widget="many2many_tags"/>
              </group>
              <group name="ts_api_zip_from">
                <field name="ts_api_zip_from"/>
              </group>
              <group name="ts_api_zip_to">
                <field name="ts_api_zip_to"/>
              </group>
              <group name="ts_api_zip_list">
                <field name="ts_api_zip_list"/>
              </group>
            </group>
          </group>
        </page>
      </page>
    </field>
  </record>

</odoo>
