<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Add the Supplier Lot field to the stock move line detailed operations
        list (the popup shown when clicking "Detailed Operations" on a picking).
    -->
    <record id="view_stock_move_line_operation_tree_inherit"
            model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.inherit.receipt</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="supplier_lot"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
