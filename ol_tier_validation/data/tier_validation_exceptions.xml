<odoo noupdate="1">

    <!-- Add Journal Entry Tier Validation Field Exceptions -->
    <record id="journal_entry_tier_validation_exception_1" model="tier.validation.exception">
        <field name="name">Journal Entry Field Exceptions</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="field_ids" eval="[(4, ref('account.field_account_move__needed_terms_dirty'))]" />
        <field name="allowed_to_write_after_validation" eval="True" />
        <field name="allowed_to_write_under_validation" eval="True" />
        <field name="company_id" eval="False" />
        <field name="group_ids" eval="False" />
    </record>

    <!-- Add Sale Order Tier Validation Field Exceptions -->
    <record id="sale_order_tier_validation_exception_1" model="tier.validation.exception">
        <field name="name">Sale Order Field Exceptions</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="field_ids" eval="[(4, ref('ol_stock_constrained_availability.field_sale_order__date_confirm')), (4, ref('account_avatax_sale_oca.field_sale_order__avatax_request_log')), (4, ref('account_avatax_sale_oca.field_sale_order__avatax_response_log')), (4, ref('account_avatax_sale_oca.field_sale_order__tax_amount')), (4, ref('sale_stock.field_sale_order__procurement_group_id'))]" />
        <field name="allowed_to_write_after_validation" eval="True" />
        <field name="allowed_to_write_under_validation" eval="True" />
        <field name="company_id" eval="False" />
        <field name="group_ids" eval="False" />
    </record>

</odoo>
