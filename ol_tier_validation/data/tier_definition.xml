    <!-- Vendor Bills Tier Definitions -->
    <record id="account_tier_definition_je_10k" model="tier.definition">
        <field name="name">Legal/Corporate Bills Below $10k</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="ol_base.role_fin_controller_res_groups"/>
        <field name="active" eval="True" />
        <field name="definition_type">domain</field>
        <field name="definition_domain">["&amp;", "&amp;", ("move_type", "=", "in_invoice"), ("invoice_line_ids.purchase_order_id", "=", False), ("amount_total", "&lt;=",10000)]</field>
    </record>

    <record id="account_tier_definition_je_$10k_to_$200k" model="tier.definition">
