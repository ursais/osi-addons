<odoo noupdate="1">

    <!-- Purchase Order Tier Definitions -->
    <record id="purchase_tier_definition_purchase_order_under_100k" model="tier.definition">
        <field name="name">PO up to $100k</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="ol_base.role_operations_res_groups"/>
        <field name="active" eval="True" />
        <field name="definition_type">domain</field>
        <field name="definition_domain">[["amount_total", "&lt;", 100000]]</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="purchase_tier_definition_purchase_order_100k_to_350k" model="tier.definition">
        <field name="name">PO Between $100k and $350k</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="ol_base.role_supply_chain_director_res_groups"/>
        <field name="active" eval="True" />
        <field name="definition_type">domain</field>
        <field name="definition_domain">['&amp;', ("amount_total", '&gt;=', 100000), ("amount_total", '&lt;=', 350000)]</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="purchase_tier_definition_purchase_order_over_350k" model="tier.definition">
        <field name="name">PO Over $350k</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="review_type">group</field>
