<odoo>

    <record id="mrp_production_batch_form_view_inheirt" model="ir.ui.view">
        <field name="name">mrp.production.batch.form.view</field>
        <field name="model">mrp.production.batch</field>
        <field name="inherit_id" ref="mrp_batch.mrp_production_batch_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_constrained_component" invisible="1"/>
            </xpath>
            <xpath expr="//header" position = "after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not has_constrained_component">
                    <strong> One or more components are marked * as constrained. </strong>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
