<odoo>
    <record id="action_send_receipts_by_email" model="ir.actions.server">
        <field name="name">Send Receipts by Email</field>
        <field name="model_id" ref="account_batch_payment.model_account_batch_payment"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="account_batch_payment.model_account_batch_payment"/>
        <field name="binding_view_types">form,list</field>
        <field name="code">
          for record in records:
              record.action_send_detailed_payment_emails()
        </field>
    </record>

    <record id="view_batch_payment_form_inherit_osi_email" model="ir.ui.view">
        <field name="name">account.batch.payment.view.form.inherit.osi_nacha_email</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="auto_send_email"/>
                <field name="remittance_email_sent" readonly="1" invisible="1"/>
            </field>
        </field>
    </record>

</odoo>
