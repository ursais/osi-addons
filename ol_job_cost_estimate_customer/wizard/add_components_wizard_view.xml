<odoo>

    <record id="view_add_components_wizard_form" model="ir.ui.view">
        <field name="name">add.components.wizard.form</field>
        <field name="model">add.components.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Components">
                <group>
                    <field name="product_id" />
                </group>
                <footer>
                    <button string="Add Components" type="object" name="action_add_components" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_components_wizard" model="ir.actions.act_window">
        <field name="name">Add Components</field>
        <field name="res_model">add.components.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
