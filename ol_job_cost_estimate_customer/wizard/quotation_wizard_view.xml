<odoo>
	<record id="view_quotation_wizard_form" model="ir.ui.view">
        <field name="name">quotation.wizard.form</field>
        <field name="model">quotation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                	<field name="estimate_id" invisible="1"/>
                    <field name="product_ids" invisible="1"/>
                    <field name="product_id"  options="{'no_create': True}"/>
                    <field name="qty" />
                </group>
                <footer>
                    <button string="Create" type="object" name="create_quotation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
