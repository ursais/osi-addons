<odoo>

    <record id="ol_job_cost_estimator_customer_view_sale_estimate_form_job" model="ir.ui.view">
        <field name="name">sale.estimate.job.customer.inherit.form</field>
        <field name="model">sale.estimate.job</field>
        <field name="inherit_id" ref="job_cost_estimate_customer.view_sale_estimate_form_job" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='job_type']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='job_type_ids']" position="after">
                <field name="customer_request_date"/>
            </xpath>
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='product_uom']" position="after">
                <field name="customer_lead" optional="show" />
            </xpath>
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='price_unit']" position="after">
                <field name="purchase_price" optional="show" />
            </xpath>
            <xpath expr="//field[@name='labour_estimate_line_ids']/tree/field[@name='product_uom']" position="after">
                <field name="customer_lead" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='overhead_estimate_line_ids']/tree/field[@name='product_uom']" position="after">
                <field name="customer_lead" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='product_id']" position="after">
                <field name="company_id" column_invisible="1" />
            </xpath>
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">['|', ('company_ids_display', '=', False), ('company_ids_display', 'in', company_id)]</attribute>
            </xpath>
            <xpath expr="//button[@name='view_custom_quotation']" position="replace">
                <button
                    name="view_custom_quotation"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-dollar"
                    string="Quotations"
                    invisible="quotation_count == 0">
                    <field name="quotation_count" widget="statinfo" string="Quotations" />
                </button>
            </xpath>
            <xpath expr="//button[@name='estimate_to_quotation']" position="replace">
                <button
                    name="estimate_to_quotation"
                    type="object"
                    string="Create Quotation"
                    invisible="state in ('draft', 'approve', 'reject', 'cancel')"
                    class="btn-primary"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position = "inside">
                <button
                    type="object"
                    name="action_view_product"
                    class="oe_stat_button"
                    invisible="product_count == 0"
                    icon="fa-list"
                >
                    <field name="product_count" widget="statinfo" string="Prototype Products" />
                </button>
                <button
                    type="object"
                    name="action_view_eco"
                    class="oe_stat_button"
                    invisible="mrp_eco_count == 0"
                    icon="fa-list"
                >
                    <field name="mrp_eco_count" widget="statinfo" string="ECOs" />
                </button>
            </xpath>
            <xpath expr="//button[@name='estimate_cancel']" position="before">
                <button
                    name="open_product_creation_wizard"
                    type="object"
                    title="Create a New Prototype Product/BoM/ECO"
                    string="New Product/BoM/ECO"
                    class="oe_highlight"
                    data-hotkey="q"
                />
            </xpath>
            <xpath expr="//field[@name='estimate_total']" position="after">
                <field name="total_cost" widget="monetary" />
                <field name="margin" widget="monetary" />
                <field name="margin_percent" widget="percentage" />
            </xpath>
            <xpath expr="//button[@name='estimate_to_quotation']" position="attributes">
                <attribute name="name">create_quotation_wizard</attribute>
            </xpath>
            <field name="reference" position="after">
                <field name="warehouse_id" options="{'no_open': True, 'no_create': True}" groups="base.group_multi_company" readonly="state in ('approve','quotesend','cancel','reject')" />
            </field>
            <xpath expr="//field[@name='estimate_ids']/tree/field[@name='product_uom']" position="after">
                <field name="product_type" column_invisible="True" />
                <field name="forecasted_issue" column_invisible="True" />
                <field name="display_qty_widget" column_invisible="True" />
                <widget name="qty_at_date_widget_estimate" width="20px"/>
                <field name="virtual_available_at_date" column_invisible="True"/>
                <field name="scheduled_date" column_invisible="True"/>
                <field name="free_qty_today" column_invisible="True"/>
                <field name="display_qty_widget" column_invisible="True"/>
                <field name="forecasted_issue" column_invisible="True"/>
                <field name="estimate_state" column_invisible="True"/>
                <field name="qty_available_today" column_invisible="True"/>
            </xpath>
            <field name="pricelist_id" position="replace">
                <field name="has_active_pricelist" invisible="1" />
                <field name="show_update_pricelist" invisible="1" />
                <label for="pricelist_id" groups="product.group_product_pricelist" invisible="not has_active_pricelist" />
                <div groups="product.group_product_pricelist" class="o_row" invisible="not has_active_pricelist">
                    <field name="pricelist_id" options="{'no_open':True,'no_create': True}" readonly="state in ('approve','quotesend','cancel','reject')" />
                    <button
                        name="action_update_prices"
                        type="object"
                        string=" Update Prices"
                        help="Recompute all prices based on this pricelist"
                        class="btn-link mb-1 px-0" icon="fa-refresh"
                        confirm="This will update the unit price of all products based on the new pricelist."
                        invisible="not show_update_pricelist or state in ('approve','quotesend','cancel','reject')"
                    />
                </div>
            </field>
            <notebook position="before">
                <div class="o_row" invisible="not show_update_purchase_price">
                    <field name="show_update_purchase_price" invisible="1" />
                    <button
                        name="action_update_purchase_price"
                        type="object"
                        string=" Update Cost"
                        help="Recompute all Purchase prices based on this Total Cost"
                        class="btn-link mb-1 px-0" icon="fa-refresh"
                        confirm="This will update the Purchase price of all products based on the Total Cost."
                        invisible="not show_update_purchase_price or state in ('approve','quotesend','cancel','reject')"
                    />
                </div>
            </notebook>
            <field name="estimate_ids" position="before">
                <button
                    name="open_add_components"
                    string="Add from Product"
                    type="object"
                    class="btn btn-secondary"
                    invisible="state == 'cancel'"
                />
            </field>
            <xpath expr="//notebook/page[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="overhead_total" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
