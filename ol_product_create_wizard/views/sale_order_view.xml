<odoo>

    <record id="ol_product_create_wizard_view_sale_order_form" model="ir.ui.view">
        <field name="name">ol.product.create.wizard.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <button name="open_create_product" string="Create New Product" type="object" class="btn-secondary"/>
            </xpath>
        </field>
    </record>

</odoo>
