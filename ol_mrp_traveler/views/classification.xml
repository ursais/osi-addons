<odoo>

    <!-- Add checks to classification views -->
    <record model="ir.ui.view" id="product_attribute_classification_search">
        <field name="name">ol_mrp_traveler.product_attribute_classification_search</field>
        <field name="model">product.attribute.classification</field>
        <field name="inherit_id" ref="ol_product_classification.product_attribute_classification_search"/>
        <field name="arch" type="xml">
            <group name="groupby" position="inside">
                <filter string="Group by Stage" name="group_by_stage" domain="[]" context="{'group_by':'stage_id'}"/>
            </group>
            <field name="name" position="after">
                <field name="stage_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_classification_tree_view">
        <field name="name">ol_mrp_traveler.product_attribute_classification_tree_view</field>
        <field name="model">product.attribute.classification</field>
        <field name="inherit_id" ref="ol_product_classification.product_attribute_classification_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="stage_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_classification_form_view">
        <field name="name">ol_mrp_traveler.product_attribute_classification_form_view</field>
        <field name="model">product.attribute.classification</field>
        <field name="inherit_id" ref="ol_product_classification.product_attribute_classification_form_view"/>
        <field name="arch" type="xml">
            <notebook name="main_tabs" position="inside">
                <page name="stage_and_check" string="Stage and Checks">
                    <group>
                        <field name="stage_id"/>
                        <label for="check_ids" colspan="2" />
                        <field name="check_ids" colspan="2" widget="many2many" nolabel="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
