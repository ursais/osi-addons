<odoo>

    <!-- Product Product view -->
    <record id="ol_mrp_traveler_product_normal_form_view" model="ir.ui.view">
        <field name="name">ol_mrp_traveler.product_normal_form_view</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="ol_product_classification.ol_product_classification_product_normal_form_view"/>
        <field name="arch" type="xml">
            <page name="qa_test" position="inside">
                <group name="template_traveler_group" string="Product Template Traveler Information" colspan="2">
                    <field name="work_documentation_url" />
                    <field name="template_bios_name" />
                    <field name="template_check_ids">
                        <tree editable="bottom">
                            <field name="priority" />
                            <field name="stage_id" />
                            <field name="text" />
                            <field name="type" />
                        </tree>
                    </field>
                </group>
                <group name="traveler_group" string="Traveler Information" colspan="2">
                    <field name="work_documentation_url"/>
                    <field name="bios_name" />
                    <field name="check_ids">
                        <tree editable="bottom">
                            <field name="priority" />
                            <field name="stage_id" />
                            <field name="text" />
                            <field name="type" />
                        </tree>
                    </field>
                </group>
                <group name="variant_traveler_group" string="Product Variant Specific Traveler Information" colspan="2">
                    <field string="Override BIOS Name" name="variant_bios_name" />
                    <field name="variant_check_ids">
                        <tree editable="bottom">
                            <field name="priority" />
                            <field name="stage_id" />
                            <field name="text" />
                            <field name="type" />
                        </tree>
                    </field>
                </group>
            </page>
        </field>
    </record>

</odoo>
