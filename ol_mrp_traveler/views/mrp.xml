<odoo>

    <record id="ol_mrp_traveler_mrp_bom_form" model="ir.ui.view">
        <field name="name">ol_mrp_traveler.mrp_bom_form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="ol_product_classification.ol_product_classification_mrp_bom_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='classification_id']" position="after">
                <field name="assembly_stage_id" />
            </xpath>
        </field>
    </record>

</odoo>
