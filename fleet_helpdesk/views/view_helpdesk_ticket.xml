<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Helpdesk Ticket Form View Extension
        
        This view inherits from the helpdesk ticket form view and adds a vehicle
        field to link fleet vehicles with helpdesk tickets, as well as domain
        validation fields for domain-based reports.
        
        Features:
        - Vehicle selection field for linking fleet vehicles to tickets
        - Domain validation fields for automated domain-based reports
        - Positioned after the email_cc field for logical grouping
        - Only visible to fleet users
    -->
    <record id="view_helpdesk_ticket_fleet_inherit_form" model="ir.ui.view">
        <field name="name">view.helpdesk.ticket.fleet.inherit.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <!-- 
                Add vehicle field after the email_cc field
                This allows users to associate a fleet vehicle with the ticket,
                useful for tracking vehicle maintenance and issue requests
            -->
            <field name="email_cc" position="after">
                <field 
                    name="vehicle_id" 
                    placeholder="Select a vehicle..."
                    options="{'no_create': True}"
                    groups="fleet.fleet_group_user"
                />
            </field>
            
            <!-- 
                Add domain validation fields
                These fields are automatically populated when domain-based reports
                are processed, extracting domain, submitter, and report ID information
                from the ticket title or description.
            -->
            <field name="description" position="after">
                <group name="domain_report_info" string="Domain Report Information" 
                       invisible="not report_domain" col="4">
                    <field name="report_domain" readonly="1"/>
                    <field name="domain_validated" readonly="1" widget="boolean_toggle"/>
                    <field name="report_submitter" readonly="1"/>
                    <field name="report_id" readonly="1"/>
                </group>
            </field>
        </field>
    </record>
    
    <!-- 
        Helpdesk Ticket Tree View Extension
        
        Add domain validation indicator to tree view for quick visibility
        of domain validation status.
    -->
    <record id="view_helpdesk_ticket_fleet_inherit_tree" model="ir.ui.view">
        <field name="name">view.helpdesk.ticket.fleet.inherit.tree</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_tree" />
        <field name="arch" type="xml">
            <!-- Add domain validated indicator column -->
            <field name="name" position="after">
                <field name="domain_validated" 
                       string="Domain Valid" 
                       widget="boolean_toggle"
                       optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
