<odoo>

    <record id="mrp_production_tree_view_inherit_mrp_batch" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.inherit.mrp.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="priority" position="before">
                <field name="sequence" widget="handle" />
                <field name="sequence" optional="hide" />
                <field name="daily_sequence" optional="hide" />
            </field>
            <field name="date_start" position="after">
                <field name="assigned_workcenter_id" />
            </field>
        </field>
    </record>

</odoo>
