<odoo>
    <record id="ol_helpdesk_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form.sot</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <label for="journal_id" position="before">
                <field
                    name="helpdesk_ticket_id"
                    invisible="move_type != 'out_refund' or not helpdesk_ticket_id"
                    readonly="1"
                />
            </label>
        </field>
    </record>
</odoo>
