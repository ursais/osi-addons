<odoo>

    <record id="action_helpdesk_import_sale" model="ir.actions.act_window">
        <field name="name">Import Sale Order</field>
        <field name="res_model">helpdesk.ticket.import.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="ol_helpdesk_repair_batch_helpdesk_ticket_view_form_inherit_stock_user" model="ir.ui.view">
		<field name="name">helpdesk.ticket.repair.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="helpdesk_repair.helpdesk_ticket_view_form_inherit_stock_user" />
        <field name="arch" type="xml">
            <button name="action_open_helpdesk_ticket" position="before">
                <button
                    name="action_view_in_transfers"
                    string="IN Transfer(s)"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-arrow-down"
                    invisible="in_transfer_count == 0">
                    <field name="in_transfer_count" widget="statinfo"/>
                </button>
                <button
                    name="action_view_repair_sale_orders"
                    string="Repair SO(s)"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-usd"
                    invisible="repair_sale_order_count == 0">
                    <field name="repair_sale_order_count" widget="statinfo"/>
                </button>
                <button
                    name="action_view_out_transfers"
                    string="OUT Transfer(s)"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="out_transfer_count == 0">
                    <field name="out_transfer_count" widget="statinfo"/>
                </button>
            </button>
            <xpath expr="//page[@name='description']" position="after">
                <field name="use_product_repairs" invisible="1" groups="stock.group_stock_user" />
                <page name="repairs" string="Repairs" invisible="not use_product_repairs">
                    <field name="show_generate_repairs" invisible="1" />
                    <field name="show_create_sale" invisible="1" />
                    <button
                        name="%(action_helpdesk_import_sale)d"
                        string="Import from Sales Order"
                        type="action"
                        class="btn-secondary"
                        context="{'default_ticket_id': active_id, 'default_partner_id': partner_id}"
                    />
                    <button
                        name="action_generate_repairs"
                        string="Generate Repairs"
                        type="object"
                        class="oe_highlight"
                        invisible="not show_generate_repairs"
                    />
                    <button
                        name="action_create_receipt"
                        type="object"
                        string="Create Receipt Transfer"
                        class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="not repair_ids"
                    />
                    <button
                        name="action_create_sale_order"
                        type="object"
                        string="Create Repair Sale Order"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="not show_create_sale"
                    />
                    <group name="repair_batches" string="Repair Batches">
                        <field nolabel="1" colspan="2" name="repair_batch_ids" />
                    </group>
                    <group name="repair_orders" string="Repair Orders">
                        <field nolabel="1" colspan="2" name="repair_ids" >
                            <tree string="Repairs order" multi_edit="1" sample="1" decoration-info="state == 'draft'">
                                <field name="company_id" column_invisible="True" />
                                <field name="priority" optional="show" widget="priority" nolabel="1" />
                                <field name="name" />
                                <field name="schedule_date" optional="show" widget="remaining_days" />
                                <field name="product_id" readonly="1" optional="show" />
                                <field name="parts_availability_state" column_invisible="True" />
                                <field name="parts_availability" invisible="state not in ['confirmed', 'under_repair']" optional="show" decoration-success="parts_availability_state == 'available'" decoration-warning="parts_availability_state == 'expected'" decoration-danger="parts_availability_state == 'late'" />
                                <field name="product_qty" optional="hide" string="Quantity" readonly="state != 'draft'" />
                                <field name="product_uom" string="Unit of Measure" readonly="1" groups="uom.group_uom" optional="hide" />
                                <field name="user_id" optional="hide" widget='many2one_avatar_user'/>
                                <field name="partner_id" readonly="1" optional="hide" />
                                <field name="picking_id" optional="hide" />
                                <field name="is_returned" optional="hide" />
                                <field name="sale_order_id" optional="hide" />
                                <field name="lot_id" optional="show" />
                                <field name="location_id" optional="hide" />
                                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="show" />
                                <field name="state" optional="show" widget='badge' decoration-success="state == 'done'" decoration-info="state not in ('done', 'cancel')" />
                                <field name="activity_exception_decoration" widget="activity_exception" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
            <button name="action_repair_order_form" position="replace" />
        </field>
    </record>

</odoo>
