<odoo>

    <record id="ol_helpdesk_repair_batch_view_stock_scrap_search" model="ir.ui.view">
        <field name="name">stock.scrap.search.inherit.repair</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_search_view"/>
        <field name="arch" type="xml">
            <filter name="product" position="after">
                <filter name="repair_id" string="Repair Order" domain="[('repair_id','!=',False)]"/>
            </filter>
        </field>
    </record>

</odoo>
