<odoo>

    <record id="ol_helpdesk_repair_batch_view_stock_picking_form" model="ir.ui.view">
		<field name="name">helpdesk.repair.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="owner_id" position="attributes">
                <attribute name="invisible">picking_type_code not in ('outgoing', 'incoming')</attribute>
            </field>
        </field>
    </record>

</odoo>