<odoo>

    <record id="ol_helpdesk_repair_batch_view_repair_order_form" model="ir.ui.view">
		<field name="name">helpdesk.ticket.repair.order.form</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']" position="before">
                <field name="show_create_removal_button" invisible="1" />
                <button
                    name="action_create_removal_lines"
                    type="object"
                    string="Load Removed Components"
                    class="oe_highlight"
                    invisible="not show_create_removal_button"
                />
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="ticket_id" />
                <field name="repair_batch_id" />
            </xpath>
        </field>
    </record>

</odoo>