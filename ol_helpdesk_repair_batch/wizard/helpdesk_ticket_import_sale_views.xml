<odoo>

    <record id="view_helpdesk_ticket_import_sale_form" model="ir.ui.view">
        <field name="name">Import From Sale Order Wizard</field>
        <field name="model">helpdesk.ticket.import.sale</field>
        <field name="arch" type="xml">
            <form string="Import Sale Order">
                <field name="warned_partner_change" invisible="1" />
                <div class="alert alert-danger" role="alert" invisible="not warned_partner_change">
                    <p class="text-danger">The Customer is different than what is set the ticket. The ticket will be updated with this partner when you clicke the add button.</p>
                </div>
                <group>
                    <field name="ticket_id" invisible="1" />
                    <field name="lot_id" />
                    <field name="sale_order_id" />
                    <field name="partner_id" />
                </group>
                <separator string="Sale Order Lines" />
                <field name="line_ids">
                    <tree editable="bottom" create="0">
                        <field name="sale_order_id" />
                        <field name="product_id" />
                        <field name="qty" />
                        <field name="lot_ids" domain="[('product_id', '=', product_id)]" widget="many2many_tags" />
                    </tree>
                </field>
                <footer>
                    <button string="Cancel" special="cancel" />
                    <button name="action_confirm" string="Add" type="object" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
