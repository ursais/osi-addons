<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rule to restrict scrap reason codes by company -->
        <record id="scrap_reason_code_company_rule" model="ir.rule">
            <field name="name">Scrap Reason Code: Multi-Company</field>
            <field name="model_id" ref="scrap_reason_code.model_scrap_reason_code"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
