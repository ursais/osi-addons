<odoo>

    <record id="ol_pim_attribute_option_tree_view" model="ir.ui.view">
        <field name="name">attribute.option.tree.view</field>
        <field name="model">attribute.option</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="attribute_set.attribute_option_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code" optional="show" />
            </field>
        </field>
    </record>

    <record id="ol_pim_attribute_option_form_view" model="ir.ui.view">
        <field name="name">attribute.option.form.view</field>
        <field name="model">attribute.option</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="attribute_set.attribute_option_form_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code" />
            </field>
        </field>
    </record>

</odoo>
