<odoo>

    <record id="ol_pim_attribute_attribute_tree_view" model="ir.ui.view">
        <field name="name">attribute.attribute.tree.view</field>
        <field name="model">attribute.attribute</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="attribute_set.attribute_attribute_tree_view" />
        <field name="arch" type="xml">
            <field name="field_description" position="after">
                <field name="code" optional="show" />
            </field>
        </field>
    </record>

    <record id="ol_pim_attribute_attribute_form_view" model="ir.ui.view">
        <field name="name">attribute.attribute.form.view</field>
        <field name="model">attribute.attribute</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="attribute_set.attribute_attribute_form_view" />
        <field name="arch" type="xml">
            <field name="field_description" position="after">
                <field name="code" />
            </field>
        </field>
    </record>

</odoo>
