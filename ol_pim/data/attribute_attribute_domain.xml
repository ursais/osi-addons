<odoo>

    <!-- The CSV Imports fail with domain so this is the workaround to add it via xml for the few attributes that need them.-->
    <record id="ol_pim.attribute_documentation" model="attribute.attribute">
        <field name="domain">[('folder_id.name','=','Documentation')]</field>
    </record>

    <record id="ol_pim.attribute_drivers" model="attribute.attribute">
        <field name="domain">[('folder_id.name','=','Drivers')]</field>
    </record>

    <record id="ol_pim.attribute_regulatory" model="attribute.attribute">
        <field name="domain">[('folder_id.name','=','Regulatory')]</field>
    </record>

    <record id="ol_pim.attribute_support" model="attribute.attribute">
        <field name="domain">[('folder_id.name','=','Support')]</field>
    </record>

    <record id="ol_pim.attribute_application_notes" model="attribute.attribute">
        <field name="domain">[('folder_id.name','=','Application Notes')]</field>
    </record>

</odoo>
