<odoo>
  <data>
    <record id="product_template_form_view" model="ir.ui.view">
      <field name="name">ol_uuid.product.template.common.form</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="ol_base.view_product_template_form"/>
      <field name="arch" type="xml">
        <page name="onlogic_info" position="inside">
          <group>
            <field name='uuid' readonly="1"/>
          </group>
        </page>
      </field>
    </record>
    <!-- SEARCH VIEW -->
    <record id="product_template_search_view" model="ir.ui.view">
      <field name="name">ol_uuid.product.template.search</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_search_view"/>
      <field name="arch" type="xml">
        <field name="categ_id" position="after">
          <separator/>
          <field name="uuid"/>
        </field>
      </field>
    </record>
  </data>
</odoo>