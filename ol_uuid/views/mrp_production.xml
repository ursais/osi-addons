<odoo>
	<record id="view_mrp_production_form" model="ir.ui.view">
		<field name="name">ol_uuid.view_mrp_production_form</field>
		<field name="model">mrp.production</field>
		<field name="inherit_id" ref="ol_base.view_mrp_production_form"/>
		<field name="arch" type="xml">
			<page name="onlogic_info" position="inside">
				<group name="uuid_info">
					<field name='uuid' readonly="1"/>
				</group>
			</page>
		</field>
	</record>
	<record id="view_mrp_production_filter" model="ir.ui.view">
		<field name="name">ol_uuid.view_mrp_production_filter</field>
		<field name="model">mrp.production</field>
		<field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
		<field name="arch" type="xml">
			<field name="origin" position="after">
				<field name='uuid' readonly="1"/>
            </field>
		</field>
	</record>
</odoo>